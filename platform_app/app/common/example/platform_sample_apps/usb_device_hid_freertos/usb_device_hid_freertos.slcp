project_name: usb_device_hid_freertos
package: platform_app
quality: production
label: Platform - USB Device HID with FreeRTOS kernel
description: >
  This example uses the USB stack HID Class with the FreeRTOS kernel to emulate a mouse.
  Once the usb device is connected to a computer, it will trigger continuous mouse movements.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Advanced"]
source:
  - path: app.c
  - path: usb_hid_app.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: usb_hid_app.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: freertos
  - id: usb_device_configuration
    instance: [config0]
  - id: usb_device_class_hid
    instance: [mouse0]
requires:
  - name: clock_manager_runtime
    condition: [device_series_3]
  - name: se_firmware_unavailable
    condition: [device_series_3]
define:
  - name: DEBUG_EFM
  - name: SL_CLOCK_MANAGER_PERPLL0_EN
    value: 1
    condition: [device_series_3]
  - name: SL_CLOCK_MANAGER_PERPLL0_FREQ
    value: 10
    condition: [device_series_3]
  - name: SL_CLOCK_MANAGER_USB0CLK_SOURCE
    value: CMU_USB0CLKCTRL_CLKSEL_PERPLL0
    condition: [device_series_3]
configuration:
  - name: configTOTAL_HEAP_SIZE
    value: 40000
readme:
  - path: readme.md
tag:
  - hardware:component:usb
  - hwfilter:device:device_has_usb
  - hwfilter:ram:64k
ui_hints:
  highlight: readme.md
