+
+    SuccessOrExit(error = DecodeDnsUpstreamWireMessage(mDecoder, txnIndex, response, responseLen));
+    DnsUpstreamResponseReceived(txnIndex, response, responseLen);
+
+exit:
+    return error;
+}
