declare_args() {
  # Configuration file for MbedTLS (TLS/X.509).
  mbedtls_config_file = "mbedtls-config.h"

  # Configuration file for TF-PSA-Crypto.
  tf_psa_crypto_config_file = "psa-crypto-config.h"

  # Extra dependencies for MbedTLS
  mbedtls_deps = [ "../../src/core:libopenthread_core_config" ]
}

config("mbedtls_config") {
  include_dirs = [
    ".",
    "repo/include",
    "repo/library",
    "repo/tf-psa-crypto/include",
    "repo/tf-psa-crypto/drivers/builtin/include",
    "repo/tf-psa-crypto/core",
    "repo/tf-psa-crypto/drivers/builtin/src",
  ]

  defines = [
    "MBEDTLS_CONFIG_FILE=\"${mbedtls_config_file}\"",
    "TF_PSA_CRYPTO_CONFIG_FILE=\"${tf_psa_crypto_config_file}\"",
  ]
}

config("warnings_fix_config") {
  cflags = [
    "-Wno-conversion",
    "-Wno-undef",
  ]
}

group("warnings_fix") {
  public_configs = [
    ":warnings_fix_config",
  ]
}

