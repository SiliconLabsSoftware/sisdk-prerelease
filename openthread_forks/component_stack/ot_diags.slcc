id: ot_diags
label: Diagnostics
package: openthread_forks
category: OpenThread|Utility
quality: production
description: This component provides diagnostic functionalities for OpenThread.
provides:
- name: ot_diags
- name: ot_diags_implementation
define:
- name: OPENTHREAD_CONFIG_DIAG_ENABLE
  value: 1
documentation:
  docset: openthread
  document: openthread-quick-start-guide/05-development-tools
metadata:
  sbom:
    reference: ot_sbom_openthread
root_path: openthread_forks
