id: rtllib
label: Real-Time Locationing Library
package: realtime_locationing
description: Real time locationing library component
category: Bluetooth|Direction Finding
quality: production
metadata:
  sbom:
    license: MSLA
root_path: realtime_locationing/.
provides:
- name: rtllib
library:
- path: lib/gcc/cortex-m33/release/librtl_static.a
  condition:
  - toolchain_gcc
  - cortexm33
- path: lib/llvm/cortex-m33/release/librtl_static.a
  condition:
  - toolchain_llvm
  - cortexm33
- path: lib/gcc/linux/x86-64/release/librtl_static.a
  condition:
  - toolchain_gcc
  - linux_arch_x86_64
- path: lib/gcc/windows/x86-64/release/librtl_static.a
  condition:
  - toolchain_gcc
  - win32
- path: lib/gcc/linux/aarch64/release/librtl_static.a
  condition:
  - toolchain_gcc
  - linux_arch_aarch64
- path: lib/gcc/linux/armv7l/release/librtl_static.a
  condition:
  - toolchain_gcc
  - linux_arch_arm32v7
- system: m
  condition:
  - device_host
- system: pthread
  condition:
  - device_host
- system: stdc++
  condition:
  - device_host

requires:
- name: rtllib_api
- name: cortexm33
  condition: [device_cortexm]
- name: memory_manager_cpp
  condition: [device_cortexm]
- name: cmsis_dsp
  condition: [device_cortexm]
- name: printf
- name: rtllib_eigen
- name: rtllib_cmsis_dsp
- name: rtllib_printf
- name: rtl_log_mutex

template_contribution:
- name: component_catalog
  value: rtl_lib

# LLVM's Arm multilib selects libc++ from the link command. Without these
# driver flags on the link line, Clang picks the *_exn_rtti_* variant and
# pulls in ~50 KB of exception/RTTI runtime (e.g. cxa_demangle).
toolchain_settings:
- option: llvm_c++_compiler_option
  value: -fno-exceptions -fno-rtti
  condition: [device_cortexm, toolchain_llvm]
- option: llvm_linker_option
  value: -fno-exceptions -fno-rtti
  condition: [device_cortexm, toolchain_llvm]

documentation:
  docset: rtl-lib
  document: modules

# Refuse generation on architectures with no matching library: entry above.
validation_helper:
- path: scripts/lua/rtllib_unsupported_target.lua
  unless: [cortexm33, linux_arch_x86_64, linux_arch_aarch64, linux_arch_arm32v7, win32]
