- path: src/sli_cpc.c
- path: src/sli_cpc.h
- path: src/sli_cpc_assert.h
- path: src/sli_cpc_atomic.h
- path: src/sli_cpc_bootloader.h
- path: src/sli_cpc_buf.c
- path: src/sli_cpc_bus.c
- path: src/sli_cpc_bus.h
- path: src/sli_cpc_control.c
- path: src/sli_cpc_control.h
- path: src/sli_cpc_crc.c
- path: src/sli_cpc_crc.h
- path: src/sli_cpc_debug.h
- path: src/sli_cpc_dispatcher.c
- path: src/sli_cpc_dispatcher.h
- path: src/sli_cpc_drv.h
- path: src/sli_cpc_endianness.h
- path: src/sli_cpc_ep.h
- path: src/sli_cpc_frame.c
- path: src/sli_cpc_frame.h
- path: src/sli_cpc_frame_list.h
- path: src/sli_cpc_hdr.h
- path: src/sli_cpc_list.h
- path: src/sli_cpc_log.h
- path: src/sli_cpc_memory.c
- path: src/sli_cpc_memory.h
- path: src/sli_cpc_msgq.c
- path: src/sli_cpc_panic.c
- path: src/sli_cpc_panic.h
- path: src/sli_cpc_timer.h
- path: src/sli_cpc_utils.h
provides:
- name: cpc_ng
conflicts:
- name: cpc_core
requires:
- name: cpc_ng_port
- name: cmsis_core
- name: component_catalog
- name: hal_emu
- name: sl_string
- name: power_manager
- name: memory_manager
