#include "sl_common.h"
#include "sl_cpc_drv_instances.h"
#include "sli_uart.h"

{% for instance in cpc_ng_drv_uart_eusart_instances %}
#include "sl_cpc_drv_uart_eusart_{{ instance }}_config.h"
{% endfor %}

{% for instance in cpc_ng_drv_uart_eusart_instances %}
void SL_CONCAT_PASTER_3(EUSART, SL_CPC_DRV_UART_EUSART_{{ instance|upper }}_PERIPHERAL_NO, _RX_IRQHandler)(void)
{
  sli_uart_rx_irq_handler(&sl_cpc_drv_uart_eusart_{{ instance }}->uart_handle);
}

void SL_CONCAT_PASTER_3(EUSART, SL_CPC_DRV_UART_EUSART_{{ instance|upper }}_PERIPHERAL_NO, _TX_IRQHandler)(void)
{
  sli_uart_tx_irq_handler(&sl_cpc_drv_uart_eusart_{{ instance }}->uart_handle);
}
{% endfor %}
