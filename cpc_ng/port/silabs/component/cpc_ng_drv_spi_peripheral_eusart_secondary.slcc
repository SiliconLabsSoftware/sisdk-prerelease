id: cpc_ng_drv_spi_peripheral_eusart_secondary
package: cpc_ng
description: Instantiable SPI-peripheral (EUSART) driver for a CPC-NG Secondary device.
category: Services|CPC-NG|Driver|Secondary Device
quality: internal
label: CPC-NG Secondary - SPI Peripheral (EUSART)
metadata:
  sbom:
    license: Zlib
root_path: cpc_ng/port/silabs
instantiable:
  prefix: instance
include:
- path: inc
  file_list:
  - path: sl_cpc_drv_spi_peripheral_eusart.h
source:
- path: src/sl_cpc_drv_spi_peripheral_eusart.c
config_file:
- path: config/sl_cpc_ng_drv_spi_peripheral_eusart_{{instance}}_config.h
  file_id: cpc_ng_drv_spi_peripheral_eusart_config
- path: config/sl_cpc_ng_drv_spi_peripheral_eusart_{{instance}}_kernel_config.h
  file_id: cpc_ng_drv_spi_peripheral_eusart_kernel_config
  condition: [kernel]
- path: config/sl_cpc_ng_drv_spi_peripheral_eusart_{{instance}}_pm_runtime_config.h
  file_id: cpc_ng_drv_spi_peripheral_eusart_pm_runtime_config
  condition: [cpc_ng_pm_runtime]
- path: config/sl_cpc_ng_drv_spi_peripheral_eusart_{{instance}}_wake_host_config.h
  file_id: cpc_ng_drv_spi_peripheral_eusart_wake_host_config
  condition: [cpc_ng_wake_host]
provides:
- name: cpc_ng_drv_spi_peripheral_eusart_secondary
- name: cpc_ng_drv_secondary_instance
  allow_multiple: true
requires:
- name: cpc_ng_drv_spi_peripheral
- name: cpc_ng_secondary
- name: hal_eusart
template_contribution:
- name: cpc_ng_drv_spi_peripheral_eusart_instances
  value: "{{instance}}"
- name: cpc_ng_drv_spi_peripheral_eusart_role_secondary
  value: "{{instance}}"
- name: event_handler
  value:
    event: cpc_drv_instances_start_buses
    handler: sl_cpc_drv_spi_peripheral_eusart_instances_start_buses
