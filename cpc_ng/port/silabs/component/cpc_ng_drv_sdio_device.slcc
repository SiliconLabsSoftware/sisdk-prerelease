id: cpc_ng_drv_sdio_device
package: cpc_ng
description: Shared SDIO-device physical-link driver for CPC-NG. Role-specific instances are provided by the CPC-NG Secondary SDIO Device component.
category: Services|CPC-NG|Driver
quality: internal
label: CPC-NG - SDIO Device
ui_hints:
  visibility: never
metadata:
  sbom:
    license: Zlib
root_path: cpc_ng/port/silabs
source:
- path: src/sl_cpc_drv_sdio_device.c
include:
- path: inc
  file_list:
  - path: sl_cpc_drv_sdio_device.h
provides:
- name: cpc_ng_drv_sdio_device
requires:
- name: bit
- name: clock_manager_runtime
- name: cpc_ng
- name: cpc_ng_port_silabs
- name: device_manager
- name: hal_gpio
- name: hal_sdio_device
- name: status
template_contribution:
- name: event_handler
  value:
    event: cpc_drv_instances_start_buses
    handler: sl_cpc_drv_sdio_device_instances_start_buses
template_file:
- path: template/sl_cpc_drv_sdio_device_config.h.jinja
  condition: [device_series_3]
