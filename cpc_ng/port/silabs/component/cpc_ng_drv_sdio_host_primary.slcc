id: cpc_ng_drv_sdio_host_primary
package: cpc_ng
description: Instantiable SDIO-host driver for a CPC-NG Primary device.
category: Services|CPC-NG|Driver|Primary Device
quality: internal
label: CPC-NG Primary - SDIO Host
metadata:
  sbom:
    license: Zlib
root_path: cpc_ng/port/silabs
instantiable:
  prefix: instance
config_file:
- path: config/sl_cpc_drv_sdio_host_{{instance}}_config.h
  file_id: cpc_ng_drv_sdio_host_config
- path: config/sl_cpc_drv_sdio_host_{{instance}}_kernel_config.h
  file_id: cpc_ng_drv_sdio_host_kernel_config
  condition: [kernel]
- path: config/sl_cpc_drv_sdio_host_{{instance}}_pm_runtime_config.h
  file_id: cpc_ng_drv_sdio_host_pm_runtime_config
  condition: [cpc_ng_pm_runtime]
- path: config/sl_cpc_drv_sdio_host_{{instance}}_wake_host_config.h
  file_id: cpc_ng_drv_sdio_host_wake_host_config
  condition: [cpc_ng_wake_host]
provides:
- name: cpc_ng_drv_sdio_host_primary
- name: cpc_ng_drv_primary_instance
  allow_multiple: true
requires:
- name: cpc_ng_drv_sdio_host
- name: cpc_ng_primary
template_contribution:
- name: cpc_ng_drv_sdio_host_instances
  value: "{{instance}}"
