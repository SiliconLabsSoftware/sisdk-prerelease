id: cpc_ng_drv_sdio_device_secondary
package: cpc_ng
description: Instantiable SDIO-device driver for a CPC-NG Secondary device.
category: Services|CPC-NG|Driver|Secondary Device
quality: internal
label: CPC-NG Secondary - SDIO Device
metadata:
  sbom:
    license: Zlib
root_path: cpc_ng/port/silabs
instantiable:
  prefix: instance
config_file:
- path: config/sl_cpc_drv_sdio_device_{{instance}}_config.h
  file_id: cpc_ng_drv_sdio_device_config
- path: config/sl_cpc_drv_sdio_device_{{instance}}_kernel_config.h
  file_id: cpc_ng_drv_sdio_device_kernel_config
  condition: [kernel]
- path: config/sl_cpc_drv_sdio_device_{{instance}}_pm_runtime_config.h
  file_id: cpc_ng_drv_sdio_device_pm_runtime_config
  condition: [cpc_ng_pm_runtime]
- path: config/sl_cpc_drv_sdio_device_{{instance}}_wake_host_config.h
  file_id: cpc_ng_drv_sdio_device_wake_host_config
  condition: [cpc_ng_wake_host]
provides:
- name: cpc_ng_drv_sdio_device_secondary
- name: cpc_ng_drv_secondary_instance
  allow_multiple: true
requires:
- name: cpc_ng_drv_sdio_device
- name: cpc_ng_secondary
template_contribution:
- name: cpc_ng_drv_sdio_device_instances
  value: "{{instance}}"
- name: cpc_ng_drv_sdio_device_role_secondary
  value: "{{instance}}"
