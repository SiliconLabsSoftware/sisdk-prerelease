id: cpc_ng_drv_uart_secondary
package: cpc_ng
description: Instantiable UART driver for a CPC-NG Secondary device.
category: Services|CPC-NG|Driver|Secondary Device
quality: experimental
label: CPC-NG Secondary - UART
metadata:
  sbom:
    license: Zlib
root_path: cpc_ng/port/silabs
instantiable:
  prefix: instance
config_file:
- path: config/sl_cpc_drv_uart_{{instance}}_config.h
  file_id: cpc_ng_drv_uart_config
provides:
- name: cpc_ng_drv_uart_secondary
- name: cpc_ng_secondary_drv_instance
requires:
- name: cpc_ng_drv_uart
- name: cpc_ng_secondary
template_contribution:
- name: cpc_ng_drv_uart_instances
  value: "{{instance}}"
- name: cpc_ng_drv_uart_role_secondary
  value: "{{instance}}"
