id: cpc_ng_drv_uart_eusart_primary
package: cpc_ng
description: Instantiable UART driver for a CPC-NG Primary device.
category: Services|CPC-NG|Driver|Primary Device
quality: experimental
label: CPC-NG Primary - UART
metadata:
  sbom:
    license: Zlib
root_path: cpc_ng/port/silabs
instantiable:
  prefix: instance
config_file:
- path: config/sl_cpc_drv_uart_eusart_{{instance}}_config.h
  file_id: cpc_ng_drv_uart_eusart_config
- path: config/sl_cpc_drv_uart_eusart_{{instance}}_kernel_config.h
  file_id: cpc_ng_drv_uart_eusart_kernel_config
  condition: [kernel]
- path: config/sl_cpc_drv_uart_eusart_{{instance}}_pm_runtime_config.h
  file_id: cpc_ng_drv_uart_eusart_pm_runtime_config
  condition: [cpc_ng_pm_runtime]
- path: config/sl_cpc_drv_uart_eusart_{{instance}}_wake_host_config.h
  file_id: cpc_ng_drv_uart_eusart_wake_host_config
  condition: [cpc_ng_wake_host]
provides:
- name: cpc_ng_drv_uart_eusart_primary
- name: cpc_ng_drv_primary_instance
  allow_multiple: true
requires:
- name: cpc_ng_drv_uart_eusart
- name: cpc_ng_primary
template_contribution:
- name: cpc_ng_drv_uart_eusart_instances
  value: "{{instance}}"
