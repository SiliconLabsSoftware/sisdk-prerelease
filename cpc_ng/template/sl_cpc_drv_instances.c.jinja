#include "sl_cpc_drv_instances.h"

#include "sl_assert.h"
#include "sl_common.h"
#include "sl_component_catalog.h"
#include "sl_cpc_bus.h"
#include "sl_status.h"

{% set drv_instances_dict = {
  "mock": (cpc_ng_drv_mock_instances, cpc_ng_drv_mock_role_secondary),
  "sdio_device": (cpc_ng_drv_sdio_device_instances, cpc_ng_drv_sdio_device_role_secondary),
  "sdio_host": (cpc_ng_drv_sdio_host_instances, cpc_ng_drv_sdio_host_role_secondary),
  "spi_peripheral_eusart": (cpc_ng_drv_spi_peripheral_eusart_instances, cpc_ng_drv_spi_peripheral_eusart_role_secondary),
  "spi_peripheral_usart": (cpc_ng_drv_spi_peripheral_usart_instances, cpc_ng_drv_spi_peripheral_usart_role_secondary),
  "uart": (cpc_ng_drv_uart_instances, cpc_ng_drv_uart_role_secondary),
} -%}

{% for drv_name, drv_instances_role in drv_instances_dict.items() %}
{% for instance in drv_instances_role.0 %}
#include "sl_cpc_drv_{{ drv_name }}_{{ instance }}_config.h"
{% endfor %}
{% endfor %}

{% if cpc_ng_drv_uart_instances|count > 0 %}
#include "sl_iostream_handles.h"
{% endif %}

sl_status_t sl_cpc_drv_instances_init(void)
{
  sl_status_t status;

  {% for instance in cpc_ng_drv_mock_instances -%}
  const sl_cpc_drv_mock_config_t sl_cpc_drv_mock_{{ instance }}_cfg = {
  };
  {% endfor %}

  {% for instance in cpc_ng_drv_sdio_device_instances -%}
  const sl_cpc_drv_sdio_device_config_t sl_cpc_drv_sdio_device_{{ instance }}_cfg = {
  };
  {% endfor %}

  {% for instance in cpc_ng_drv_sdio_host_instances -%}
  /* SDHCCORE is a CMSIS pointer macro. Hide it so the pin-tool name pastes as a token. */
#undef SDHCCORE
  const sl_cpc_drv_sdio_host_config_t sl_cpc_drv_sdio_host_{{ instance }}_cfg = {
    .peripheral = SL_CONCAT_PASTER_2(SL_PERIPHERAL_, SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_PERIPHERAL),
    .clk = { .port = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_CLK_PORT, .pin = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_CLK_PIN },
    .cmd = { .port = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_CMD_PORT, .pin = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_CMD_PIN },
    .dat0 = { .port = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_DAT0_PORT, .pin = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_DAT0_PIN },
    .dat1 = { .port = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_DAT1_PORT, .pin = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_DAT1_PIN },
    .dat2 = { .port = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_DAT2_PORT, .pin = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_DAT2_PIN },
    .dat3 = { .port = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_DAT3_PORT, .pin = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_DAT3_PIN },
    .base_clock_freq_hz = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_BASE_CLOCK_FREQ_HZ,
    .bus_voltage = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_BUS_VOLTAGE,
    .slot_type = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_SLOT_TYPE,
    .card_detect_source = SL_CPC_DRV_SDIO_HOST_{{ instance|upper }}_CARD_DETECT_SOURCE,
    .function_num = SL_CPC_DRV_SDIO_{{ instance|upper }}_FUNCTION_NUM,
    .block_size = SL_CPC_DRV_SDIO_{{ instance|upper }}_BLOCK_SIZE,
    .max_sd_freq = SL_CPC_DRV_SDIO_{{ instance|upper }}_MAX_SD_FREQ,
    .max_speed_mode = SL_CPC_DRV_SDIO_{{ instance|upper }}_MAX_SPEED_MODE,
  };
  {% endfor %}

  {% for instance in cpc_ng_drv_spi_peripheral_eusart_instances -%}
  const sl_cpc_drv_spi_peripheral_eusart_config_t sl_cpc_drv_spi_peripheral_eusart_{{ instance }}_cfg = {
    .peripheral = SL_CONCAT_PASTER_2(SL_PERIPHERAL_EUSART, SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_PERIPHERAL_NO),
    .copi = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_COPI_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_COPI_PIN,
    },
    .cipo = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CIPO_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CIPO_PIN,
    },
    .clk = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CLK_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CLK_PIN,
    },
    .cs = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_PIN,
    },
    .irq = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_IRQ_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_IRQ_PIN,
    },
    .cs_exti_no = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_EXTI_NO,
    .cs_synctrig_prs_ch = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_SYNCTRIG_PRS_CH,
    .txc_synctrig_prs_ch = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_TXC_SYNCTRIG_PRS_CH,
    .tx_availability_synctrig_ch = SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_TX_AVAILABILITY_SYNCTRIG_CH,
  };
  {%- endfor %}

  {% for instance in cpc_ng_drv_spi_peripheral_usart_instances -%}
  const sl_cpc_drv_spi_peripheral_usart_config_t sl_cpc_drv_spi_peripheral_usart_{{ instance }}_cfg = {
    .peripheral = SL_CONCAT_PASTER_2(SL_PERIPHERAL_USART, SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_PERIPHERAL_NO),
    .copi = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_COPI_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_COPI_PIN,
    },
    .cipo = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_CIPO_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_CIPO_PIN,
    },
    .clk = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_CLK_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_CLK_PIN,
    },
    .cs = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_CS_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_CS_PIN,
    },
    .irq = {
      .port = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_IRQ_PORT,
      .pin = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_IRQ_PIN,
    },
    .cs_synctrig_prs_ch = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_CS_SYNCTRIG_PRS_CH,
    .txc_synctrig_prs_ch = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_TXC_SYNCTRIG_PRS_CH,
    .tx_availability_synctrig_ch = SL_CPC_DRV_SPI_PERIPHERAL_USART_{{ instance | upper }}_TX_AVAILABILITY_SYNCTRIG_CH,
  };
  {% endfor %}

  {% for instance in cpc_ng_drv_uart_instances -%}
  const sl_cpc_drv_uart_config_t sl_cpc_drv_uart_{{ instance }}_cfg = {
    .iostream = sl_iostream_{{ instance }}_handle,
    .iostream_uart = sl_iostream_uart_{{ instance }}_handle,
  };
  {% endfor %}

  {% for drv_name, drv_instances_role in drv_instances_dict.items() %}
  {% for instance in drv_instances_role.0 %}
  const sl_cpc_bus_config_t sl_cpc_bus_{{ drv_name }}_{{ instance }}_cfg = {
    .is_secondary = {{ (instance in drv_instances_role.1)|string|lower }},
    .rx_frame_pool_count = SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_RX_FRAME_POOL_COUNT,
    .tx_frame_pool_count = SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_TX_FRAME_POOL_COUNT,
#if defined(SL_CATALOG_CPC_NG_WAKE_DEVICE_PRESENT)
#if defined(SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_POWER_MODE)
    .power_mode = SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_POWER_MODE,
    .wake_in_response = SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_WAKE_IN_RESPONSE,
#if defined(SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_WAKE_IN_PORT)
    .wake_in_pin = {
      .port = SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_WAKE_IN_PORT,
      .pin = SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_WAKE_IN_PIN,
    },
#endif
#endif
#endif
#if defined(SL_CATALOG_CPC_NG_WAKE_HOST_PRESENT)
#if defined(SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_WAKE_OUT_MODE)
    .wake_out_mode = SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_WAKE_OUT_MODE,
#if defined(SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_WAKE_OUT_PORT)
    .wake_out_pin = {
      .port = SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_WAKE_OUT_PORT,
      .pin = SL_CPC_DRV_{{ drv_name|upper }}_{{ instance|upper }}_WAKE_OUT_PIN,
    },
#endif
#endif
#endif
  };
  {% endfor %}
  {% endfor %}

  {% for drv_name, drv_instances_role in drv_instances_dict.items() %}
  {% for instance in drv_instances_role.0 %}
  status = sl_cpc_drv_{{ drv_name }}_init(sl_cpc_drv_{{ drv_name }}_{{ instance }},
                                          &sl_cpc_drv_{{ drv_name }}_{{ instance }}_cfg,
                                          &sl_cpc_bus_{{ drv_name }}_{{ instance }}_cfg);
  EFM_ASSERT(status == SL_STATUS_OK);
  if (status != SL_STATUS_OK) {
    return status;
  }
  {% endfor %}
  {% endfor %}

  return SL_STATUS_OK;
}

{% for drv_name, drv_instances_role in drv_instances_dict.items() if drv_instances_role.0|count > 0 %}
void sl_cpc_drv_{{ drv_name }}_instances_start_buses(void) {
  sl_status_t status;

  {% for instance in drv_instances_role.0 %}
  status = sl_cpc_bus_start(sl_cpc_drv_{{ drv_name }}_get_bus(sl_cpc_drv_{{ drv_name }}_{{ instance }}));
  EFM_ASSERT(status == SL_STATUS_OK);
  if (status != SL_STATUS_OK) {
    return;
  }
  {% endfor %}
}
{% endfor %}

{% for instance in cpc_ng_drv_spi_peripheral_eusart_instances -%}
// EUSART cannot route CS directly to PRS; go through EXTI.
// Pin / EXTI number constraints:
//   pins 0-3 -> EXTI 0-3
//   pins 4-7 -> EXTI 4-7
// Only EXTI0..7 can feed a PRS channel.
#if (SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_EXTI_NO >= 0 && SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_EXTI_NO <= 3)
#if !(SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_PIN >= 0 && SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_PIN <= 3)
#error "For an EXTI0..3, only pin Px0..3 can be used as CS"
#endif
#elif (SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_EXTI_NO >= 4 && SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_EXTI_NO <= 7)
#if !(SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_PIN >= 4 && SL_CPC_DRV_SPI_PERIPHERAL_EUSART_{{ instance | upper }}_CS_PIN <= 7)
#error "For an EXTI4..7, only pin Px4..7 can be used as CS"
#endif
#else
#error "Only EXTI0..7 can be used because the PRS only support those as inputs"
#endif

{% endfor %}
