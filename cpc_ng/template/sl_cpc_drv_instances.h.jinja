#ifndef SL_CPC_DRV_INSTANCES_H
#define SL_CPC_DRV_INSTANCES_H

#include "sl_status.h"

{% set drv_instances_dict = {
  "mock": cpc_ng_drv_mock_instances,
  "sdio_device": cpc_ng_drv_sdio_device_instances,
  "sdio_host": cpc_ng_drv_sdio_host_instances,
  "spi_peripheral": cpc_ng_drv_spi_peripheral_instances,
  "uart": cpc_ng_drv_uart_instances,
} -%}

{% for drv_name, drv_instances in drv_instances_dict.items() -%}
{% if drv_instances|count > 0 -%}
#include "sl_cpc_drv_{{ drv_name }}.h"
{%- endif %}
{%- endfor %}

{% for drv_name, drv_instances in drv_instances_dict.items() -%}
{% if drv_instances|count > 0 -%}
#define SL_CPC_DRV_{{ drv_name|upper }}_INSTANCES_COUNT {{ drv_instances|count }}
{%- endif %}

{% for instance in drv_instances -%}
#define sl_cpc_drv_{{ drv_name }}_{{ instance }} (&sl_cpc_drv_{{ drv_name }}_instances[{{ loop.index0 }}])
{%- endfor %}
{%- endfor %}

/***************************************************************************/ /**
 * Initialize all CPC driver instances.
 *
 * @retval SL_STATUS_OK Drivers initialized successfully.
 * @retval Other        An error occurred.
 ******************************************************************************/
sl_status_t sl_cpc_drv_instances_init(void);

{% for drv_name, drv_instances_role in drv_instances_dict.items() -%}
{% if drv_instances_role|count > 0 -%}
void sl_cpc_drv_{{ drv_name }}_instances_start_buses(void);
{%- endif %}
{%- endfor %}

#endif /* SL_CPC_DRV_INSTANCES_H */
