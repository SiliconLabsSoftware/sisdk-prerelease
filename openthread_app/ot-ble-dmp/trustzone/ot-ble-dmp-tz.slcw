workspace_name: ot-ble-dmp-tz
label: OpenThread BLE DMP - SoC TrustZone Workspace
description: >
  Workspace to build TrustZone-enabled OpenThread BLE DMP - SoC FreeRTOS application and accompanying bootloader.
quality: production

project:
  - path: ../../ot-tz-secure-app/ot-tz-secure-application.slcp
    id: ot-tz-secure-application
    output: ot-tz-secure-application
  - path: ot-ble-dmp-tz-ns.slcp
    id: ot-tz-nonsecure-application
    output: ot-ble-dmp-tz-ns
  - path: ../../workspace-bootloaders/bootloader-storage-internal-single/bootloader-storage-internal-single.slcp
    id: application
    output: bootloader-storage-internal-single

post_build:
  profile: ot-tz-workspace
