      - device_generic_family_efr32xg25
      - hardware_board_default_rf_band_450

# --------------------------- Template Contribution ----------------------------
template_contribution:
# -------------------------------- CLI commands --------------------------------
  - name: cli_command
    value:
      name: ieee802154_configure
      handler: cli_ieee802154_configure
      help: "Configure IEEE 802.15.4 addressing, frame and ACK settings"
      argument:
        - type: uint16
          help: "PAN ID"
        - type: uint16
          help: "Receiver address"
        - type: uint16
          help: "Transmitter address"
        - type: uint16
          help: "Frame length"
        - type: uint8
          help: "Source address present: 0 - false, 1 - true"
        - type: uint8
          help: "PAN ID compression: 0 - false, 1 - true"
        - type: uint16
          help: "ACK timeout in us (0 = ACK disabled)"
  - name: cli_command
    value:
      name: csma_configure
      handler: cli_csma_configure
      help: "Configure CSMA/CA parameters"
      argument:
        - type: uint8
          help: "csma_min_bo_exp - minimum backoff exponent"
        - type: uint8
          help: "csma_max_bo_exp - maximum backoff exponent"
        - type: uint8
          help: "csma_tries - number of backoff-then-CCA iterations"
        - type: int8
          help: "cca_threshold_dbm - CCA RSSI threshold in dBm"
        - type: uint16
          help: "cca_backoff_us - backoff unit period in us"
        - type: uint16
          help: "cca_duration_us - minimum CCA check duration in us"
        - type: uint32
          help: "csma_timeout_us - overall CSMA timeout in us (0 = no timeout)"
  - name: cli_command
    value:
      name: start_measurement
      handler: cli_start_measurement
      help: "Start the throughput measurement"
      argument:
        - type: uint16
          help: "Radio channel to use for the measurement"

# --------------------------------- Toolchain ----------------------------------
toolchain_settings:
  - option: optimize
    value: debug

ui_hints:
  highlight:
    - path: config/rail/radio_settings.radioconf
    - path: readme.md
      focus: true

# ---------------------------------- HWFILTER ----------------------------------
tag:
  - hwfilter:board:hardware:has:pti
  - hwfilter:ram:24k
  - hwfilter:flash:140k
  - hwfilter:!device:device_no_rail_api
  - hwfilter:!device:device_generic_family_efr32xg21
  - hwfilter:!device:device_family_mgm24
  - hwfilter:!device:device_family_zgm23
  - hwfilter:!device:device_family_mgm26
  - hwfilter:!device:device_family_mgm27
  - hwfilter:!device:device_family_bgm24
  - hwfilter:!device:device_family_mgm22
  - hwfilter:!board:brd4183b

filter:
  - name: Wireless Technology
    value: [RAIL]
  - name: Device Type
    value: [SoC]
  - name: Project Difficulty
    value: [Beginner]
