    condition: [hardware_board_stk]
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: 1
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
    unless: [hardware_board_stk]
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_NONE
    condition: [hardware_board_stk]
  - name: APP_LOG_PREFIX_ENABLE
    value: 0
  - name: SL_PACKET_ASSISTANT_MAX_TX_FRAME_SIZE
    value: 2048
# ----------------------------- RAIL init, Project -----------------------------
