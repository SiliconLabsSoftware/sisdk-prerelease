project_name: rail_soc_throughput
label: RAIL - SoC Throughput Measurement
package: rail_app
description: >
  The Silicon Labs RAIL - SoC Throughput Measurement sample application 
  demonstrates how different PHY configurations and MAC-level features affect 
  radio throughput and related performance statistics. It provides a 
  configurable two-node measurement setup, where one device operates as the 
  coordinator/receiver and the other as the transmitter during the active 
  measurement interval.The application is intended to serve both as a throughput 
  evaluation tool and as a reference implementation for reproducible radio 
  performance measurements. PHY-level configuration is defined through the Radio 
  Configurator, while runtime measurement parameters and supported MAC-level 
  options can be controlled through the coordinator-side CLI. The application 
  reports transmitter- and receiver-side throughput, packet delivery behavior, 
  and other relevant statistics, making it useful for comparing radio 
  configurations, evaluating MAC feature impact, and validating link performance 
  under different test scenarios.
category: RAIL Examples
quality: evaluation

# ------------------------------ UC/UP components ------------------------------
component:
  - id: sl_main
  - id: clock_manager
  - id: device_init
  - id: board_control
    condition: [hardware_board]
  - id: memory_manager
  - id: sl_rail_util_init
    instance: [inst0]
  - id: sl_rail_util_compatible_pa
  - id: radio_config_simple_rail_singlephy
  - id: app_log
  - id: app_assert
  - id: sl_rail_sdk_packet_assistant
  - id: sleeptimer
  - id: emlib_chip
# --------------------------- Memory Protection Unit ---------------------------
  - id: mpu
# ------------------------------------ CLI -------------------------------------
  - id: cli
    instance: [example]
  - id: printf
  - id: iostream_recommended_stream
  - id: iostream_retarget_stdio
# ----------------------------- Restriction rules ------------------------------
  - id: restrictions_profile_base
  - id: restrictions_profile_connect
  - id: restrictions_profile_connect_ofdm
  - id: restrictions_profile_long_range
  - id: restrictions_profile_wisun_fan_1_0
  - id: restrictions_profile_wisun_fan_1_1
  - id: restrictions_profile_wisun_han
  - id: restrictions_profile_wisun_ofdm
  - id: restrictions_profile_sun
  - id: restrictions_profile_sidewalk
  - id: restrictions_profile_ieee802154_bpsk
# ---------------------------- Code Classification -----------------------------
  - id: code_classification
# -------------------------------- Require list --------------------------------
requires:
  - name: a_radio_config
  - name: sl_rail_sdk_simple_os
    condition: [kernel]
  - name: radio_config_singlephy_device_family_fgm23
    condition: [device_family_fgm23]
# ------------------------------- Project files --------------------------------
include:
  - path: .
    file_list:
      - path: app_init.h
      - path: app_process.h

source:
  - path: app_init.c
  - path: app_process.c
  - path: app_cli.c

config_file:
  - path: config/app_config.h

readme:
  - path: ../../../documentation/example/rail_soc_throughput/readme.md
# -------------------------- Configuration overrides ---------------------------
configuration:
  - name: SL_STACK_SIZE
    value: 2048
# -------------------------------- FreeRTOS OS ---------------------------------
  - name: configMINIMAL_STACK_SIZE
    value: 1024
# -------------------------- Micrium OS / SystemView ---------------------------
  - name: CPU_CFG_TS_32_EN
    value: 1
  - name: OS_CFG_DBG_EN
    value: 1
  - name: OS_CFG_TS_EN
    value: 1
  - name: OS_CFG_SCHED_ROUND_ROBIN_EN
    value: 1
  - name: OS_CFG_STAT_TASK_EN
    value: 1
  - name: OS_CFG_TASK_PROFILE_EN
    value: 1
# --------------------------- Other project settings ---------------------------
