id: zaf_ncp_zniffer_headers
label: ZAF NCP Zniffer headers
category: Z-Wave
description: >
  This component provides the ZAF header files required to build the zwave_ncp_zniffer sample application. It aggregates essential include files for Command Class frameworks such as Association, MultiChannel, Supervision, and Common, alongside CC List generation and ZAF configuration. Integrating these headers ensures consistent Z-Wave Application Framework compatibility, enabling protocol transport, device association, and event supervision functionality within the zniffer environment. Use this component when developing or maintaining NCP-based Z-Wave Zniffer solutions that rely on ZAF infrastructure and Command Class support for robust network analysis and protocol compliance workflows.
documentation:
  docset: z-wave
  document:
  - page: zwave-api/association
  - page: zwave-api/cc-list
  - page: zwave-api/common
  - page: zwave-api/multichan
  - page: zwave-api/supervision
  - page: zwave-api/supervision-events

package: zwave
quality: production
metadata:
  sbom:
    reference: zw_sbom_license
include:
- path: ZAF/CommandClasses/Common
  file_list:
  - path: CC_Common.h
- path: ZAF/TransportLayer/inc
  file_list:
  - path: zaf_transport_tx.h
- path: ZAF/CommandClasses/MultiChan/inc
  file_list:
  - path: multichannel.h
- path: ZAF/configuration/inc
  file_list:
  - path: zaf_config_api.h
- path: ZAF/ApplicationUtilities/CCListGenerator
  file_list:
  - path: zaf_cc_list_generator.h
- path: ZAF/CommandClasses/Association/inc
  file_list:
  - path: association_plus_base.h
- path: ZAF/ApplicationUtilities/CCListGenerator
  file_list:
  - path: zaf_cc_list_generator.h
- path: ZAF/CommandClasses/Association/config
  file_list:
  - path: cc_association_config.h
- path: ZAF/CommandClasses/Supervision/inc
  file_list:
  - path: CC_Supervision.h
provides:
- name: zaf_ncp_zniffer_headers
root_path: zwave
