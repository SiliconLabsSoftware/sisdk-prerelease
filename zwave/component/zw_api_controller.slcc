id: zw_api_controller
label: Z-Wave API Controller
category: Z-Wave|API
description: API for Controller
documentation:
  docset: z-wave
  document: zwave-api/controller-api

package: zwave
quality: production
metadata:
  sbom:
    reference: zw_sbom_license
ui_hints:
  visibility: never

include:
- path: "dist/include/zwave"
  file_list:
  - path: "ZW_controller_api.h"
provides:
- name: zw_api_controller
root_path: zwave
