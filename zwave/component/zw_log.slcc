id: zw_log
label: Z-Wave Logging
category: Z-Wave
description: >
  This component enables Z-Wave logging through sl_log. Applications select
  formatted or compact output by installing the corresponding backend.
  Messages are sent to SL_LOG_IOSTREAM_HANDLE, which defaults to the console
  (VCOM) for SoC apps or SWO for NCP apps.
  Logging can be enabled or disabled per software component and log level
  (Debug, Info, Warning, Error) through the ZW_LOG_ENABLE_* configuration.
  A generic macro, ZPAL_LOG_PRINT, is available for ad-hoc debugging.
  Most predefined log messages are disabled by default to conserve flash space.
documentation:
  docset: z-wave
  document:
  - page: zwave-api/zpal-log
  - page: zwave-api/print-app-info
package: zwave
quality: production
metadata:
  sbom:
    reference: zw_sbom_license
requires:
- name: zw_log_tool
- name: zw_log_output_iostream
- name: log_backend_iostream
- name: log_backend_iostream_formatted
provides:
- name: zw_log
config_file:
- path: sample_apps/config/zw_log/zw_log_config.h
  file_id: zw_log_config
template_contribution:
- name: component_catalog
  value: zw_log
root_path: zwave
