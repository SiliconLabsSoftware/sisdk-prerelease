id: zw_toolchain_settings
label: Z-Wave Production
category: Z-Wave
description: >
  This component provides the toolchain settings for Z-Wave release and debug builds.
documentation:
  docset: z-wave
  document: z-wave-getting-started-for-end-devices/08-debug-a-z-wave-application
package: zwave
quality: production
ui_hints:
  visibility: never
metadata:
  sbom:
    reference: zw_sbom_license
provides:
- name: zw_toolchain_settings
requires:
- name: toolchain_gcc_lto
  condition: [zw_stack_release_libraries, toolchain_gcc]
- name: toolchain_llvm_lto
  condition: [zw_stack_release_libraries, toolchain_llvm]
toolchain_settings:
- option: gcc_compiler_option
  value: "-fmerge-all-constants"
- option: gcc_compiler_option
  value: "-Wall"
- option: gcc_compiler_option
  value: "-Werror"
  condition: [zw_release]
- option: gcc_compiler_option
  value: "-Wno-error=deprecated-declarations"
- option: gcc_compiler_option
  value: "-Wextra"
- option: gcc_compiler_option
  value: "-Werror=vla"
  # Platform code is not strict ISO C compliant
  # - option: gcc_compiler_option
  #   value: "-Wpedantic"
  # Platform code contains implicit conversions that may alter a value
  # - option: gcc_compiler_option
  #   value: "-Wconversion"
  # Allow implicit function declaration until freertos has an integration hook
- option: gcc_compiler_option
  value: "-Wno-implicit-function-declaration"
  condition: [zw_release]
  # LLVM/Clang: same intent as COMMON_FLAGS in toolchain_llvm.cmake (ABI: all-LLVM image only)
- option: llvm_compiler_option
  value: "-fshort-enums"
- option: llvm_compiler_option
  value: "-fmerge-all-constants"
- option: llvm_compiler_option
  value: "-Wno-error=deprecated-declarations"
  # The platform linker script assigns .log_fmt to the readonly segment even
  # though it comes after .data, so that segment spans the whole flash. ld.lld
  # then page-aligns its file offset and lays .symtab and .debug_* over the
  # file range of .data, which aborts the link. Addresses come from the linker
  # script, so dropping page alignment only packs the file offsets. GNU ld
  # computes those offsets differently and does not need this.
- option: llvm_linker_option
  value: "-Wl,--nmagic"

root_path: zwave
