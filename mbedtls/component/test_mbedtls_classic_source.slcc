id: test_mbedtls_classic_source
label: Test dependencies for running classic Mbed TLS unit tests (Source)
package: mbedtls
description: >-
  Utility component providing the TLS/X.509 test helpers that live in the parent
  mbedtls repository (as opposed to the shared framework helpers provided by
  test_psa_framework_source).
category: unittest|mbedtls
quality: production
ui_hints:
  visibility: never
provides:
- name: test_mbedtls_classic_source
requires:
- name: mbedtls_source
- name: test_psa_framework_source
source:
- path: mbedtls/tests/src/certs.c
- path: mbedtls/tests/src/test_helpers/ssl_helpers.c
include:
- path: mbedtls/tests/include
  file_list:
  - path: test/certs.h
  - path: test/ssl_helpers.h
- path: generated/include
  file_list:
  - path: test/test_certs.h
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: mbedtls/.
