id: mbedtls_source
package: mbedtls
label: Source Code
description: Mbed TLS library sources hosted in parent mbedtls v4.1 (TLS/X.509/debug/version/timing/net/mps).
category: Platform|Security|Mbed TLS
quality: production
ui_hints:
  visibility: never
provides:
- name: mbedtls_source
requires:
- name: tf_psa_crypto_api
  condition: [trustzone_unaware]
- name: psa_crypto_api_nonsecure
  condition: [trustzone_nonsecure]
source:
- path: library/debug.c
  condition:
  - mbedtls_debug
# TODO(PSEC-7459): mbedtls_config.c includes CMake-generated
# mbedtls_config_check_{before,final}.h (via config_checks_generator.py) that are
# absent from the submodule tree. Restore options: pre-generate and commit into
# the SiliconLabsInternal/mbedtls fork, or add a generation step to build_test.sh / pact.
# - path: library/mbedtls_config.c
- path: library/mps_reader.c
  condition:
  - mbedtls_ssl_tls
- path: library/mps_trace.c
  condition:
  - mbedtls_ssl_tls
- path: library/net_sockets.c
  condition:
  - mbedtls_ssl_tls
- path: library/pkcs7.c
  condition:
  - mbedtls_pkcs7
- path: library/ssl_cache.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_ciphersuites.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_client.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_cookie.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_msg.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_ticket.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_tls.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_tls12_client.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_tls12_server.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_tls13_client.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_tls13_generic.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_tls13_keys.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_tls13_server.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_cache.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_ciphersuites.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_client.c
  condition:
  - mbedtls_ssl_client
- path: library/ssl_cookie.c
  condition:
  - mbedtls_ssl_cookie
- path: library/ssl_msg.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_ticket.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_tls.c
  condition:
  - mbedtls_ssl_tls
- path: library/ssl_tls12_client.c
  condition:
  - mbedtls_ssl_proto_tls12
- path: library/ssl_tls12_server.c
  condition:
  - mbedtls_ssl_proto_tls12
- path: library/timing.c
  condition:
  - mbedtls_ssl_tls
- path: library/version.c
  condition:
  - mbedtls_version
- path: library/x509.c
  condition:
  - mbedtls_x509_use
- path: library/x509_oid.c
  condition:
  - mbedtls_x509_use
- path: library/x509_oid.c
  condition:
  - mbedtls_x509_create
- path: library/x509_create.c
  condition:
  - mbedtls_x509_create
- path: library/x509_crl.c
  condition:
  - mbedtls_x509_crl_parse
- path: library/x509_crt.c
  condition:
  - mbedtls_x509_crt_parse
- path: library/x509_csr.c
  condition:
  - mbedtls_x509_csr_parse
- path: library/x509write.c
  condition:
  - mbedtls_x509_create
- path: library/x509write_crt.c
  condition:
  - mbedtls_x509_crt_write
- path: library/x509write_csr.c
  condition:
  - mbedtls_x509_csr_write
include:
- path: include
  file_list:
  - path: mbedtls/build_info.h
  - path: mbedtls/debug.h
  - path: mbedtls/error.h
  - path: mbedtls/mbedtls_config.h
  - path: mbedtls/net_sockets.h
  - path: mbedtls/oid.h
  - path: mbedtls/pkcs7.h
  - path: mbedtls/private/config_adjust_ssl.h
  - path: mbedtls/private/config_adjust_x509.h
  - path: mbedtls/ssl.h
  - path: mbedtls/ssl_cache.h
  - path: mbedtls/ssl_ciphersuites.h
  - path: mbedtls/ssl_cookie.h
  - path: mbedtls/ssl_ticket.h
  - path: mbedtls/timing.h
  - path: mbedtls/version.h
  - path: mbedtls/x509.h
  - path: mbedtls/x509_crl.h
  - path: mbedtls/x509_crt.h
  - path: mbedtls/x509_csr.h
- path: library
  file_list:
  - path: debug_internal.h
  - path: mbedtls_common.h
  - path: mbedtls_platform_requirements.h
  - path: mbedtls_utils.h
  - path: mps_common.h
  - path: mps_error.h
  - path: mps_reader.h
  - path: mps_trace.h
  - path: ssl_ciphersuites_internal.h
  - path: ssl_client.h
  - path: ssl_debug_helpers.h
  - path: ssl_misc.h
  - path: ssl_tls13_invasive.h
  - path: ssl_tls13_keys.h
  - path: x509_internal.h
  - path: x509_oid.h
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: mbedtls/mbedtls
