id: psa_its_source
package: mbedtls
label: PSA Persistent Storage Support (ITS)
description: This component provides the sources for PSA ITS (Internal Trusted Storage) API support.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never
provides:
- name: psa_its_source
include:
- path: core
  unless:
  - trustzone_secure
  file_list:
  - path: psa_crypto_its.h

metadata:
  sbom:
    reference: tf_psa_crypto_sbom
root_path: mbedtls/tf-psa-crypto
