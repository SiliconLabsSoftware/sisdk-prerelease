id: psa_crypto_common_source
package: mbedtls
label: TF-PSA-Crypto Common Source
description: >-
  This component provides TF PSA Crypto source that is common to  PSA Core library and PSA drivers.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never
# Paths are relative to tf-psa-crypto/, not the mbedtls package root.
provides:
- name: psa_crypto_common_source
requires:
- name: tf_psa_crypto_api
  condition: [trustzone_unaware]
- name: tf_psa_crypto_api
  condition: [trustzone_secure]
- name: psa_crypto_api_nonsecure
  condition: [trustzone_nonsecure]
source:
- path: core/psa_crypto_client.c
  unless: [trustzone_nonsecure]
include:
- path: core
  file_list:
  - path: alignment.h
  - path: check_crypto_config.h
  - path: psa_crypto_core.h
  - path: psa_crypto_core_common.h
  - path: psa_crypto_invasive.h
  - path: psa_crypto_its.h
  - path: psa_crypto_random.h
  - path: psa_crypto_random_impl.h
  - path: psa_crypto_slot_management.h
  - path: psa_crypto_storage.h
  - path: tf_psa_crypto_check_config.h
  - path: tf_psa_crypto_common.h
  - path: tf_psa_crypto_platform_requirements.h
- path: drivers/builtin/include
  file_list:
  - path: mbedtls/private_access.h
  - path: mbedtls/private/aes.h
  - path: mbedtls/private/bignum.h
  - path: mbedtls/private/block_cipher.h
  - path: mbedtls/private/camellia.h
  - path: mbedtls/private/ccm.h
  - path: mbedtls/private/cmac.h
  - path: mbedtls/private/chachapoly.h
  - path: mbedtls/private/chacha20.h
  - path: mbedtls/private/cipher.h
  - path: mbedtls/private/crypto_adjust_config_enable_builtins.h
  - path: mbedtls/private/crypto_adjust_config_tweak_builtins.h
  - path: mbedtls/private/crypto_builtin_key_derivation.h
  - path: mbedtls/private/crypto_builtin_composites.h
  - path: mbedtls/private/crypto_builtin_primitives.h
  - path: mbedtls/private/ctr_drbg.h
  - path: mbedtls/private/ecdsa.h
  - path: mbedtls/private/ecp.h
  - path: mbedtls/private/ecjpake.h
  - path: mbedtls/private/entropy.h
  - path: mbedtls/private/error_common.h
  - path: mbedtls/private/gcm.h
  - path: mbedtls/private/hmac_drbg.h
  - path: mbedtls/private/md5.h
  - path: mbedtls/private/poly1305.h
  - path: mbedtls/private/ripemd160.h
  - path: mbedtls/private/rsa.h
  - path: mbedtls/private/sha1.h
  - path: mbedtls/private/sha256.h
  - path: mbedtls/private/sha3.h
  - path: mbedtls/private/sha512.h
- path: drivers/builtin/src
  file_list:
  - path: bignum_core_invasive.h
- path: utilities
  file_list:
  - path: base64_internal.h
  - path: constant_time_impl.h
  - path: constant_time_internal.h
  - path: crypto_oid.h

metadata:
  sbom:
    reference: tf_psa_crypto_sbom
root_path: mbedtls/tf-psa-crypto
