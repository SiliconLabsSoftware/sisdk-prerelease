id: psa_crypto_source
package: mbedtls
label: PSA Crypto Source Code
description: This component includes the PSA Crypto library source code files.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never
# Paths are relative to tf-psa-crypto/, not the mbedtls package root.
conflicts:
- name: tz_secure_key_library_ns
provides:
- name: psa_crypto_source
requires:
- name: tf_psa_crypto_mbedtls
- name: psa_driver_dispatch
source:
- path: core/psa_crypto.c
- path: core/psa_crypto_random.c
- path: core/psa_crypto_slot_management.c
- path: core/psa_crypto_storage.c
- path: core/psa_its_file.c
- path: core/psa_util.c
- path: core/tf_psa_crypto_version.c
- path: drivers/builtin/src/aes.c
- path: drivers/builtin/src/bignum_core.c
- path: drivers/builtin/src/bignum.c
- path: drivers/builtin/src/block_cipher.c
- path: drivers/builtin/src/ccm.c
- path: drivers/builtin/src/chacha20.c
- path: drivers/builtin/src/chachapoly.c
- path: drivers/builtin/src/cipher_wrap.c
- path: drivers/builtin/src/cipher.c
- path: drivers/builtin/src/cmac.c
- path: drivers/builtin/src/ctr_drbg.c
- path: drivers/builtin/src/ecdsa.c
- path: drivers/builtin/src/ecjpake.c
- path: drivers/builtin/src/ecp_curves.c
- path: drivers/builtin/src/ecp_curves_new.c
- path: drivers/builtin/src/ecp.c
- path: drivers/builtin/src/entropy.c
- path: drivers/builtin/src/entropy_poll.c
- path: drivers/builtin/src/gcm.c
- path: drivers/builtin/src/hmac_drbg.c
- path: drivers/builtin/src/md5.c
- path: drivers/builtin/src/poly1305.c
- path: drivers/builtin/src/psa_crypto_aead.c
- path: drivers/builtin/src/psa_crypto_cipher.c
- path: drivers/builtin/src/psa_crypto_ecp.c
- path: drivers/builtin/src/psa_crypto_ffdh.c
- path: drivers/builtin/src/psa_crypto_hash.c
- path: drivers/builtin/src/psa_crypto_mac.c
- path: drivers/builtin/src/psa_crypto_pake.c
- path: drivers/builtin/src/psa_crypto_rsa.c
- path: drivers/builtin/src/psa_crypto_xof.c
- path: drivers/builtin/src/psa_util_internal.c
- path: drivers/builtin/src/rsa.c
- path: drivers/builtin/src/rsa_alt_helpers.c
- path: drivers/builtin/src/sha1.c
- path: drivers/builtin/src/sha256.c
- path: drivers/builtin/src/sha3.c
- path: drivers/builtin/src/sha512.c

include:
- path: dispatch
  file_list:
  - path: psa_crypto_driver_wrappers_no_static.h
- path: drivers/builtin/src
  file_list:
  - path: aesce.h
  - path: aesni.h
  - path: block_cipher_internal.h
  - path: bignum_core.h
  - path: bignum_internal.h
  - path: bignum_mod.h
  - path: bignum_mod_raw.h
  - path: bn_mul.h
  - path: chacha20_neon.h
  - path: cipher_invasive.h
  - path: cipher_wrap.h
  - path: ctr.h
  - path: ecp_invasive.h
  - path: entropy_poll.h
  - path: md_psa.h
  - path: psa_crypto_aead.h
  - path: psa_crypto_cipher.h
  - path: psa_crypto_ecp.h
  - path: psa_crypto_ffdh.h
  - path: psa_crypto_hash.h
  - path: psa_crypto_mac.h
  - path: psa_crypto_pake.h
  - path: psa_crypto_rsa.h
  - path: psa_crypto_xof.h
  - path: psa_util_internal.h
  - path: rsa_alt_helpers.h
  - path: rsa_internal.h
  - path: rsa_invasive.h

metadata:
  sbom:
    reference: tf_psa_crypto_sbom
root_path: mbedtls/tf-psa-crypto
