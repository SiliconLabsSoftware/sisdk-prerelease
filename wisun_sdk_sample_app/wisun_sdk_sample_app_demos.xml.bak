  <demo name="brd2705a.demo.wisun_soc_network_measurement" label="Wi-SUN - SoC Network Measurement">
    <model:description>The Wi-SUN Network Measurement application provides a performance measurement solution based on the ping mechanism.</model:description>
    <property key="demos.blurb" value="Wi-SUN - SoC Network Measurement"/>
    <property key="core.partCompatibility" value=".*"/>
    <property key="core.boardCompatibility" value="brd2705a"/>
    <property key="demos.imageFile" value="studio/demo_files/brd2705a/wisun_soc_network_measurement-brd2705a.s37"/>
    <property key="core.readmeFiles" value="documentation/example/wisun_soc_network_measurement/readme.md"/>
    <property key="filters" value="Device\ Type|SoC Project\ Difficulty|Advanced Wireless\ Technology|Wi-SUN"/>
    <property key="core.quality" value="PRODUCTION"/>
  </demo>
