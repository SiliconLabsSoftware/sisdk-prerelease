id: silabs_lwip_compat
label: "LightWeight IP (LWIP) POSIX / STDC header compatibility"
package: silabs_lwip
description: >
  Optional compatibility headers that expose lwIP's networking and
  standard library APIs under their standard POSIX / C names.
category: Network Stack|LwIP
quality: production
ui_hints:
  visibility: never
provides:
- name: silabs_lwip_compat
requires:
- name: silabs_lwip_api
include:
- path: lwip/src/include/compat/posix
  file_list:
  - path: netdb.h
  - path: sys/socket.h
  - path: arpa/inet.h
  - path: net/if.h
- path: lwip/src/include/compat/stdc
  file_list:
  - path: errno.h
metadata:
  sbom:
    license: BSD-3-Clause
    upstream:
      name: lwip
      version: 2.2.1
      supplier: lwIP Developers
      url: https://savannah.nongnu.org/projects/lwip/
      package_url: https://github.com/lwip-tcpip/lwip/
      comment: lwIP is a small independent implementation of the TCP/IP protocol suite.
root_path: silabs_lwip
