id: bootloader_tz_nonsecure
label: "Bootloader TrustZone Non-Secure"
description: >
  The Bootloader TrustZone Non-Secure component sets up the bootloader configuration to create TrustZone Non-Secure bootloader.
package: bootloader
category: Platform|Bootloader|TrustZone NonSecure
quality: production
define:
- name: BOOTLOADER_NONSECURE
  value: 1
provides:
- name: bootloader_tz_nonsecure
requires:
- name: trustzone_nonsecure
documentation:
  url: https://docs.silabs.com/mcu-bootloader/latest/bootloader-user-guide-gsdk-4/10-gecko-bootloader-and-trustzone
metadata:
  sbom:
    license: MSLA
root_path: bootloader
