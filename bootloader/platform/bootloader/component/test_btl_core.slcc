id: test_btl_core
label: Bootloader (Unit) Test core component
package: bootloader
category: Platform|Bootloader|Test
quality: internal
provides:
  - name: test_btl_core
  - name: toolchain_gcc_lto_disable
recommends:
  - id: bootloader_include_parser
    vendor: silabs
  - id: bootloader_uart_xmodem
    vendor: silabs
  - id: bootloader_xmodem_parser
    vendor: silabs
  - id: bootloader_bgapi_uartdfu
    vendor: silabs
  - id: bootloader_delay_driver
    vendor: silabs
  - id: bootloader_ezsp_spi
    vendor: silabs
  - id: bootloader_debug
    vendor: silabs
  - id: bootloader_image_parser
    vendor: silabs
  - id: bootloader_spi_peripheral_driver
    vendor: silabs
  - id: bootloader_crc
    vendor: silabs
  - id: bootloader_serial_driver
    vendor: silabs
metadata:
    sbom:
        license: MSLA
root_path: bootloader
