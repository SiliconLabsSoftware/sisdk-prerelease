id: interfacetest_btl_interface_tz_fault_handler
label: Bootloader Interface test for TZ fault handler
package: bootloader
category: Platform|Bootloader|Test
quality: internal
source:
  - path: platform/bootloader/test/src/interface/interface_test_tz_fault_handler.c
  - path: platform/bootloader/test/src/common/fault.c
include:
  - path: platform/bootloader/test/src/common
    file_list:
      - path: fault.h
requires:
  - name: unity
  - name: emlib
  - name: bootloader_interface
  - name: nvm3_default
  - name: nvm3_source
  - name: sl_main
  - name: sl_main_custom_main
define:
  - name: BOOTLOADER_TEST_FAULT_HANDLING
    value: 1
provides:
  - name: interfacetest_btl_interface_tz_fault_handler
toolchain_settings:
  - option: optimize
    value: debug
metadata:
    sbom:
        license: MSLA
root_path: bootloader
