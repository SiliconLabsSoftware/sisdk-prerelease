id: interfacetest_helper_btl_interface_with_communication_tz
label: Bootloader Interface test for interface_with_communication_tz
package: bootloader
description: >
    This component is an interface test case for interface_with_communication_tz having bootloader_test_secure_app configuration
category: Platform|Bootloader|Test
quality: internal

provides:
  - name: interfacetest_helper_btl_interface_with_communication_tz

template_contribution:
  - name: memory_flash_start
    priority: -2
    value: 0x6000
    condition:
      - device_sdid_200
metadata:
    sbom:
        license: MSLA
root_path: bootloader
