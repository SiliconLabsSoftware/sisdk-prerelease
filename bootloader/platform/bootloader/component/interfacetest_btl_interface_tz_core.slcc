id: interfacetest_btl_interface_tz_core
label: Bootloader Interface test core for TZ
package: bootloader
category: Platform|Bootloader|Test
quality: internal

provides:
  - name: interfacetest_btl_interface_tz_core

template_contribution:
  - name: memory_flash_start
    value: 0x28000
    condition: [device_sdid_200]
  - name: memory_flash_start
    value: 0x28000
    condition: [device_sdid_205]
  - name: memory_flash_start
    value: 0x8028000
    unless: [device_sdid_200, device_sdid_205]

  - name: memory_flash_size
    value: 0x10000
  - name: memory_ram_start
    value: 0x20002000
  - name: memory_ram_size
    value: 0x4000

library:
  - path: platform/security/sl_component/sl_trustzone/tz_secure_key_library_s_app/skl_secure_lib.o
metadata:
    sbom:
        license: MSLA
root_path: bootloader
