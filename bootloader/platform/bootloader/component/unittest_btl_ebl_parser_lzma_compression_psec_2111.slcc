id: unittest_btl_ebl_parser_lzma_compression_psec_2111
label: Bootloader Unit Test for Bootloader ebl_parser_lzma_compression_psec_2111
package: bootloader
description: >
    This component is a unit test case for bootloader ebl_parser_lzma_compression_psec_2111
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "PARSER_TEST"
    value: 1
  - name: "MAIN_BOOTLOADER_TEST"
    value: 1
  - name: "FLASH_BUFFER_BASE"
    value: 0xcf400
  - name: "PARSER_BUFFER_SIZE"
    value: 0x30c00
  - name: "TEST_COMPRESSION_LZMA_PSEC_2111"
    value: 1
  - name: "SL_DEBUG_PRINT"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_library.h)
source:
  - path: "platform/bootloader/core/btl_parse.c"
  - path: "platform/bootloader/parser/gbl/btl_gbl_parser.c"
  - path: "platform/bootloader/test/src/eblparser/ebl_parser_compression_lzma_test.c"
  - path: "platform/bootloader/parser/gbl/btl_gbl_custom_tags.c"
  - path: "platform/bootloader/core/flash/btl_internal_flash.c"
  - path: "platform/bootloader/core/btl_bootload.c"
include:
  - path: platform/bootloader/parser
    file_list:
      - path: gbl/btl_gbl_parser.h
      - path: gbl/btl_gbl_custom_tags.h
      - path: gbl/btl_gbl_format.h
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_crc
  - name: bootloader_aes_sha_ecdsa
  - name: bootloader_token_management
  - name: bootloader_compression_lzma
  - name: bootloader_debug
  - name: bootloader_image_parser
  - name: memory_manager
provides:
  - name: unittest_btl_ebl_parser_lzma_compression_psec_2111
metadata:
    sbom:
        license: MSLA
root_path: bootloader
