id: unittest_btl_ebl_parser_lzma_compression_long
label: Bootloader Unit Test for Bootloader ebl_parser_lzma_compression_long
package: bootloader
description: >
    This component is a unit test case for bootloader ebl_parser_lzma_compression_long
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "PARSER_TEST"
    value: 1
  - name: "MAIN_BOOTLOADER_TEST"
    value: 1
  - name: "PARSER_BUFFER_SIZE"
    value: 0x8000
  - name: "TEST_COMPRESSION_LZMA_LONG"
    value: 1
  - name: "SL_DEBUG_PRINT"
    value: 1
  - name: "FLASH_BUFFER_BASE"
    value: 0x78000
    condition:
      - brd4182a
