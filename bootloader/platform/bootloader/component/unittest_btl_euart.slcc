id: unittest_btl_euart
label: Bootloader Unit Test for EUART
package: bootloader
description: >
    This component is a unit test case for EUART
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "BTL_DRIVER_EUART_ENABLE"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32mg22_euart.h)
    condition:
      - device_family_efr32mg22
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32fg23_euart.h)
    condition:
      - brd4263a
      - brd4001a
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32fg23_brd4263b_euart.h)
    condition:
      - brd4263b
      - brd4001a
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32fg23_brd4263c_euart.h)
    condition:
      - brd4263c
      - brd4001a
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32mg24_euart.h)
    condition:
      - brd4187a
      - brd4001a
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32mg24_euart.h)
    condition:
      - brd2601a
      - brd4001a
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32fg25_euart.h)
    condition:
      - brd4270a
      - brd4001a
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32mg26_euart.h)
    condition:
      - brd4116a
      - brd4001a
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32mg27_euart.h)
    condition:
      - brd4194a
      - brd4001a
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32fg28_euart.h)
    condition:
      - brd4400a
      - brd4001a
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg29_euart.h)
    condition:
      - device_sdid_240
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32fg2d_euart.h)
    condition:
      - device_sdid_260
source:
  - path: "platform/bootloader/driver/btl_driver_util.c"
  - path: "platform/bootloader/test/src/uartdriver/uart_test.c"
include:
  - path: "platform/emlib/inc"
    file_list:
      - path: "em_eusart.h"
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_debug
  - name: bootloader_euart_driver
  - name: memory_manager
provides:
  - name: unittest_btl_euart
config_file:
  - path: platform/bootloader/config/btl_uart_driver_cfg.h
    file_id: btl_uart_driver_cfg
  - path: "platform/bootloader/config/device_series_2/btl_core_cfg.h"
metadata:
    sbom:
        license: MSLA
root_path: bootloader
