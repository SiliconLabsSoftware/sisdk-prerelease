id: btl_debug
label: Bootloader Debug Extension Component
package: bootloader
description: >
  Extension component providing debug functionality for bootloader.
category: Platform|Bootloader|Utils
quality: production
include:
- path: platform/bootloader
  file_list:
  - path: debug/btl_debug.h
  - path: api/btl_interface.h
- path: platform/bootloader/api
  file_list:
  - path: btl_errorcode.h
  - path: btl_reset_info.h
  - path: application_properties.h
  - path: btl_interface_parser.h
  - path: btl_interface_storage.h
provides:
- name: btl_debug
metadata:
  sbom:
    license: MSLA
ui_hints:
  visibility: never
root_path: bootloader
