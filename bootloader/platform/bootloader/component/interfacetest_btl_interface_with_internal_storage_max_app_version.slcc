id: interfacetest_btl_interface_with_internal_storage_max_app_version
label: Bootloader Interface test for interface_with_internal_storage_max_app_version
package: bootloader
description: >
    This component is an interface test for interface_with_internal_storage_max_app_version
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "CHECK_SECURE_BOOT_FLAG"
    value: 1
  - name: "TEST_MAXIMUM_APP_VERSION"
    value: 1
source:
  - path: "platform/bootloader/test/src/interface/interface_test.c"
requires:
  - name: unity
  - name: emlib
  - name: bootloader_interface
  - name: interfacetest_btl_interface_tz_core
    condition: [trustzone_nonsecure]
provides:
  - name: interfacetest_btl_interface_with_internal_storage_max_app_version
metadata:
    sbom:
        license: MSLA
root_path: bootloader
