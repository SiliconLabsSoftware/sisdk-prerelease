id: unittest_btl_debug
label: Bootloader Unit Test for debug
package: bootloader
description: >
    This component is a unit test case for bootloader debug
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "SL_DEBUG_PRINT"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg1_uart_generic.h)
    condition: toolchain_gcc
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg1_uart_generic.h)
    condition: toolchain_llvm
source:
  - path: "platform/bootloader/test/src/debug/debug_test.c"
include:
  - path: platform/bootloader
    file_list:
      - path: debug/btl_debug.h
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_debug
provides:
  - name: unittest_btl_debug
metadata:
    sbom:
        license: MSLA
root_path: bootloader
