id: unittest_btl_reset_reason
label: Bootloader Unit Test for reset reason
package: bootloader
description: >
    This component is a unit test case for bootloader reset reason
category: Platform|Bootloader|Test
quality: internal
source:
  - path: "platform/bootloader/test/src/reset_reason/reset_reason_test.c"
  - path: "platform/bootloader/core/btl_reset.c"
include:
  - path: "platform/bootloader"
    file_list:
      - path: "core/btl_reset.h"
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
provides:
  - name: unittest_btl_reset_reason
metadata:
    sbom:
        license: MSLA
root_path: bootloader
