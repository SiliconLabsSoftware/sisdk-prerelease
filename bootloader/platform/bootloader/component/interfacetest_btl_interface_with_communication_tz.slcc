id: interfacetest_btl_interface_with_communication_tz
label: Bootloader Interface test for interface_with_communication_tz
package: bootloader
description: >
    This component is an interface test case for interface_with_communication_tz
category: Platform|Bootloader|Test
quality: internal

provides:
  - name: interfacetest_btl_interface_with_communication_tz

requires:
  - name: interfacetest_btl_interface_tz_ns_test_app_core

source:
  - path: "platform/bootloader/test/src/interface/interface_test.c"

template_contribution:
  - name: memory_flash_start
    value: 0x10000
    priority: -999
    condition:
      - device_sdid_200
metadata:
    sbom:
        license: MSLA
root_path: bootloader
