id: unittest_btl_verify_app_part10
label: Bootloader Unit Test for bootloader verify_app
package: bootloader
description: >
    This component is a unit test case for bootloader verify_app
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "BOOTLOADER_SUPPORT_CERTIFICATES"
    value: 1
  - name: "MAIN_BOOTLOADER_TEST"
    value: 1
  - name: "BOOTLOADER_ENFORCE_SECURE_BOOT"
    value: 1
  - name: "PARSER_REQUIRE_CERTIFICATE_AUTHENTICITY"
    value: 0
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_library.h)
source:
  - path: "platform/bootloader/test/src/verify_app/verify_app_test.c"
  - path: "platform/bootloader/core/flash/btl_internal_flash.c"
  - path: "platform/bootloader/core/btl_bootload.c"
  - path: "platform/bootloader/core/btl_bootload.c"
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_crc
  - name: bootloader_aes_sha_ecdsa
  - name: bootloader_token_management
  - name: toolchain_gcc_lto_disable
provides:
  - name: unittest_btl_verify_app_part10
metadata:
    sbom:
        license: MSLA
root_path: bootloader
