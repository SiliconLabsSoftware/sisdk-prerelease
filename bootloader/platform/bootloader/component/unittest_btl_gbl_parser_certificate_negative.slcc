id: unittest_btl_gbl_parser_certificate_negative
label: Bootloader Unit Test for Bootloader gbl_parser_certificate_negative
package: bootloader
description: >
    This component is a unit test case for bootloader gbl_parser_certificate_negative
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "PARSER_TEST"
    value: 1
  - name: "MAIN_BOOTLOADER_TEST"
    value: 1
  - name: "GBL_WITH_LOWER_CERT_VERSION"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg21_storage_internal.h)
    condition:
      - device_sdid_200
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg22_storage_internal.h)
    condition:
      - device_sdid_205
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg23_storage_internal.h)
    condition:
      - device_sdid_210
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg24_storage_internal.h)
    condition:
      - device_sdid_215
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg25_storage_internal.h)
    condition:
      - device_sdid_220
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg26_storage_internal.h)
    condition:
      - device_sdid_225
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg27_storage_internal.h)
    condition:
      - device_sdid_230
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg28_storage_internal.h)
    condition:
      - device_sdid_235
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg29_storage_internal.h)
    condition:
      - device_sdid_240
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32fg2d_storage_internal.h)
    condition:
      - device_sdid_260
source:
  - path: "platform/bootloader/core/btl_parse.c"
  - path: "platform/bootloader/parser/gbl/btl_gbl_parser.c"
  - path: "platform/bootloader/test/src/gbl_parser_tag_se/gbl_parser_tag_certificate_test.c"
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_crc
  - name: bootloader_aes_sha_ecdsa
  - name: bootloader_token_management
  - name: bootloader_image_parser
  - name: memory_manager
  - name: toolchain_gcc_lto_disable
provides:
  - name: unittest_btl_gbl_parser_certificate_negative
metadata:
    sbom:
        license: MSLA
root_path: bootloader
