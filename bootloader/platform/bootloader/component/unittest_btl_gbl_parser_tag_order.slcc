id: unittest_btl_gbl_parser_tag_order
label: Bootloader Unit Test for Bootloader gbl_parser_tag_order
package: bootloader
description: >
    This component is a unit test case for bootloader gbl_parser_tag_order
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "PARSER_TEST"
    value: 1
  - name: "MAIN_BOOTLOADER_TEST"
    value: 1
  - name: "BOOTLOADER_SUPPORT_COMMUNICATION"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_library.h)
source:
  - path: "platform/bootloader/core/btl_parse.c"
  - path: "platform/bootloader/parser/gbl/btl_gbl_parser.c"
  - path: "platform/bootloader/test/src/gbl_parser_tag_order/gbl_parser_tag_order_test.c"
  - path: "platform/bootloader/parser/gbl/btl_gbl_custom_tags.c"
  - path: "platform/bootloader/core/btl_bootload.c"
  - path: "platform/bootloader/core/btl_reset.c"
include:
  - path: platform/bootloader
    file_list:
      - path: parser/gbl/btl_gbl_parser.h
      - path: parser/gbl/btl_gbl_custom_tags.h
      - path: parser/gbl/btl_gbl_format.h
      - path: core/btl_bootload.h
      - path: core/btl_reset.h
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_crc
  - name: bootloader_aes_sha_ecdsa
  - name: bootloader_token_management
  - name: bootloader_image_parser
  - name: bootloader_gbl_version_dependency_tag
  - name: memory_manager
provides:
  - name: unittest_btl_gbl_parser_tag_order
metadata:
    sbom:
        license: MSLA
root_path: bootloader
