id: interfacetest_btl_interface_tz_ram_clean_up
label: Bootloader Interface test for RAM clean up test
package: bootloader
category: Platform|Bootloader|Test
quality: internal
source:
  - path: platform/bootloader/test/src/interface/interface_test_tz_ram_clean_up.c
  - path: platform/bootloader/test/src/common/fault.c
  - path: "platform/bootloader/core/btl_reset.c"
include:
  - path: platform/bootloader/test/src/common
    file_list:
      - path: fault.h
  - path: "platform/bootloader"
    file_list:
      - path: "core/btl_reset.h"
requires:
  - name: unity
  - name: emlib
  - name: bootloader_interface
  - name: sl_main
  - name: sl_main_custom_main
provides:
  - name: interfacetest_btl_interface_tz_ram_clean_up
toolchain_settings:
  - option: optimize
    value: debug
template_contribution:
  - name: memory_ram_start
    value: 0x20004000
    priority: -999
  - name: memory_ram_size
    value: 16384
    priority: -999
metadata:
    sbom:
        license: MSLA
root_path: bootloader
