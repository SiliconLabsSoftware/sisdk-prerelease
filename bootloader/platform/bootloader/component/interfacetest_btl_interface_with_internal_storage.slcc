id: interfacetest_btl_interface_with_internal_storage
label: Bootloader Interface test for interface_with_internal_storage
package: bootloader
description: >
    This component is a unit test case for btl_boot_em4
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "CHECK_SECURE_BOOT_FLAG"
    value: 1
source:
  - path: "platform/bootloader/test/src/interface/interface_test.c"
requires:
  - name: unity
  - name: emlib
  - name: bootloader_interface
  - name: interfacetest_btl_interface_tz_core
    condition: [trustzone_nonsecure]
provides:
  - name: interfacetest_btl_interface_with_internal_storage
metadata:
    sbom:
        license: MSLA
root_path: bootloader
