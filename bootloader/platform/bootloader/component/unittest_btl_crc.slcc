id: unittest_btl_crc
label: Bootloader Unit Test for crc
package: bootloader
description: >
    This component is a unit test case for bootloader crc
category: Platform|Bootloader|Test
quality: internal
source:
  - path: "platform/bootloader/test/src/crc/crc_test.c"
  - path: "platform/bootloader/security/btl_crc32.c"
  - path: "platform/bootloader/security/btl_crc16.c"
include:
  - path: platform/bootloader/api
    file_list:
      - path: application_properties.h
      - path: btl_errorcode.h
      - path: btl_interface.h
      - path: btl_interface_parser.h
      - path: btl_interface_storage.h
      - path: btl_reset_info.h
define:
  - name: "MAIN_BOOTLOADER_TEST"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_library.h)
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_aes_sha_ecdsa
  - name: mbedtls_cipher_ctr
  - name: bootloader_debug
  - name: memory_manager
provides:
  - name: unittest_btl_crc
metadata:
    sbom:
        license: MSLA
root_path: bootloader
