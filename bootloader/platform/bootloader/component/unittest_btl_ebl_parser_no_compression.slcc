id: unittest_btl_ebl_parser_no_compression
label: Bootloader Unit Test for Bootloader ebl_parser_no_compression
package: bootloader
description: >
    This component is a unit test case for bootloader ebl_parser_no_compression
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "NO_COMPRESSION"
    value: 1
  - name: "PARSER_TEST"
    value: 1
  - name: "MAIN_BOOTLOADER_TEST"
    value: 1
  - name: "PARSER_BUFFER_SIZE"
    value: 0x2000
  - name: "BOOTLOADER_USE_SYMMETRIC_KEY_FROM_SE_STORAGE"
    value: 1
  - name: BOOTLOADER_FALLBACK_LEGACY_KEY
    value: 1
    condition:
      - brd4263a
  - name: BOOTLOADER_FALLBACK_LEGACY_KEY
    value: 1
    condition:
      - brd4263c
  - name: "PARSER_HAS_APPLICATION_UPGRADE_VALIDATION_CALLBACK"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_library.h)
source:
  - path: "platform/bootloader/core/btl_parse.c"
  - path: "platform/bootloader/parser/gbl/btl_gbl_parser.c"
  - path: "platform/bootloader/test/src/eblparser/ebl_parser_test.c"
  - path: "platform/bootloader/parser/gbl/btl_gbl_custom_tags.c"
include:
  - path: platform/bootloader/parser
    file_list:
      - path: gbl/btl_gbl_parser.h
      - path: gbl/btl_gbl_custom_tags.h
      - path: gbl/btl_gbl_format.h
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_crc
  - name: bootloader_aes_sha_ecdsa
  - name: bootloader_token_management
  - name: bootloader_image_parser
  - name: memory_manager
provides:
  - name: unittest_btl_ebl_parser_no_compression
metadata:
    sbom:
        license: MSLA
root_path: bootloader
