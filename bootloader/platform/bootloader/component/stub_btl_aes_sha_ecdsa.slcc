    Stubs slcc for AES , SHA and ECDSA
category: Platform|Bootloader|Stubs
quality: internal
source:
  - path: platform/bootloader/test/stubs/security/sha/se_sha.c
  - path: platform/bootloader/test/stubs/security/btl_security_sha256.c
  - path: platform/bootloader/test/stubs/security/btl_security_ecdsa.c
  - path: platform/bootloader/test/stubs/security/btl_security_aes.c
include:
