id: unittest_btl_driver_util
label: Bootloader Unit Test for driver util
package: bootloader
description: >
    This component is a unit test case for bootloader driver util
category: Platform|Bootloader|Test
quality: internal
source:
  - path: "platform/bootloader/test/src/driver_util/driver_util_test.c"
  - path: "platform/bootloader/driver/btl_driver_util.c"
include:
  - path: "platform/bootloader"
    file_list:
      - path: "driver/btl_driver_util.h"
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
provides:
  - name: unittest_btl_driver_util
metadata:
    sbom:
        license: MSLA
root_path: bootloader
