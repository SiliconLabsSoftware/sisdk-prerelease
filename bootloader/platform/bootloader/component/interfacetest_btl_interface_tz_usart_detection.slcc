id: interfacetest_btl_interface_tz_usart_detection
label: Bootloader Interface test for usart auto detection
package: bootloader
category: Platform|Bootloader|Test
quality: internal
source:
  - path: platform/bootloader/test/src/interface/interface_test_tz_usart_detection.c
  - path: platform/bootloader/test/src/common/fault.c
include:
  - path: platform/bootloader/test/src/common
    file_list:
      - path: fault.h
requires:
  - name: unity
  - name: emlib
  - name: bootloader_interface
  - name: sl_main
  - name: sl_main_custom_main
provides:
  - name: interfacetest_btl_interface_tz_usart_detection
toolchain_settings:
  - option: optimize
    value: debug
metadata:
    sbom:
        license: MSLA
root_path: bootloader
