id: unittest_btl_flash
label: Bootloader Unit Test for Flash
package: bootloader
description: >
    This component is a unit test case for bootloader flash
category: Platform|Bootloader|Test
quality: internal
source:
  - path: "platform/bootloader/core/flash/btl_internal_flash.c"
  - path: "platform/bootloader/test/src/flash/flash_test.c"
include:
  - path: "platform/bootloader/config/device_series_2"
    file_list:
      - path: "btl_core_cfg.h"
  - path: platform/bootloader/api
    file_list:
      - path: application_properties.h
      - path: btl_errorcode.h
      - path: btl_interface.h
      - path: btl_interface_parser.h
      - path: btl_interface_storage.h
      - path: btl_reset_info.h
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_internal_storage
  - name: bootloader_storage_slots
  - name: bootloader_debug
provides:
  - name: unittest_btl_flash
metadata:
    sbom:
        license: MSLA
root_path: bootloader
