id: test_btl_trustzone_secure
package: bootloader
quality: internal
category: Platform|Bootloader|Test
requires:
  - name: trustzone_secure
template_contribution:
  - name: memory_flash_start
    value: 0x8006000
    unless: [device_sdid_200, device_sdid_205]
  - name: memory_flash_start
    value: 0x6000
    condition: [device_sdid_200]
  - name: memory_flash_start
    value: 0x6000
    condition: [device_sdid_205]
  - name: memory_flash_size
    value: 65536
  - name: memory_ram_start
    value: 0x20000000
  - name: memory_ram_size
    value: 0x4000
toolchain_settings:
  - option: cmse
    value: enabled
metadata:
    sbom:
        license: MSLA
root_path: bootloader
