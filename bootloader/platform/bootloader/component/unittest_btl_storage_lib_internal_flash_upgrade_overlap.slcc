id: unittest_btl_storage_lib_internal_flash_upgrade_overlap
label: Bootloader Unit Test for bootloader storage_lib_internal_flash_upgrade_overlap
package: bootloader
description: >
    This component is a unit test case for bootloader storage_lib_internal_flash_upgrade_overlap
category: Platform|Bootloader|Test
quality: internal
define:
  - name: BOOTLOADER_INTERNAL_FLASH_UPGRADE_LOCATION_OVERLAP_TEST
    value: 1
  - name: "MAIN_BOOTLOADER_TEST"
    value: 1
  - name: BOOTLOADER_FALLBACK_LEGACY_KEY
    value: 1
    condition:
      - brd4263a
  - name: BOOTLOADER_FALLBACK_LEGACY_KEY
    value: 1
    condition:
      - brd4263c
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg21_storage_internal.h)
    condition:
      - device_sdid_200
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg22_storage_internal.h)
    condition:
      - device_sdid_205
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg23_storage_internal.h)
    condition:
      - device_sdid_210
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg24_storage_internal.h)
    condition:
      - device_sdid_215
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg25_storage_internal.h)
    condition:
      - device_sdid_220
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg26_storage_internal.h)
    condition:
      - device_sdid_225
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg27_storage_internal.h)
    condition:
      - device_sdid_230
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg28_storage_internal.h)
    condition:
      - device_sdid_235
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32xg29_storage_internal.h)
    condition:
      - device_sdid_240
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_efr32fg2d_storage_internal.h)
    condition:
      - device_sdid_260
source:
  - path: "platform/bootloader/core/btl_core.c"
  - path: "platform/bootloader/core/btl_parse.c"
  - path: "platform/bootloader/parser/gbl/btl_gbl_parser.c"
  - path: "platform/bootloader/core/btl_reset.c"
  - path: "platform/bootloader/core/flash/btl_internal_flash.c"
  - path: "platform/bootloader/storage/btl_storage_library.c"
  - path: "platform/bootloader/storage/bootloadinfo/btl_storage_bootloadinfo.c"
  - path: "platform/bootloader/test/src/common/fault.c"
  - path: "platform/bootloader/test/src/storage/storage_lib_test.c"
include:
  - path: platform/bootloader/api
    file_list:
      - path: application_properties.h
      - path: btl_errorcode.h
      - path: btl_interface.h
      - path: btl_interface_parser.h
      - path: btl_interface_storage.h
      - path: btl_reset_info.h
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_aes_sha_ecdsa
  - name: bootloader_token_management
  - name: bootloader_image_parser
  - name: bootloader_internal_storage
  - name: bootloader_common_storage
provides:
  - name: unittest_btl_storage_lib_internal_flash_upgrade_overlap
metadata:
    sbom:
        license: MSLA
root_path: bootloader
