id: unittest_btl_gbl_parser_app_info
label: Bootloader Unit Test for bootloader gbl_parser_app_info
package: bootloader
description: >
    This component is a unit test case for bootloader gbl_parser_app_info
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "PARSER_TEST"
    value: 1
  - name: "MAIN_BOOTLOADER_TEST"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_library.h)
source:
  - path: "platform/bootloader/core/btl_parse.c"
  - path: "platform/bootloader/parser/gbl/btl_gbl_parser.c"
  - path: "platform/bootloader/test/src/gbl_parser_app_info/gbl_parser_app_info_test.c"
requires:
  - name: test_btl_core
  - name: unity
  - name: emlib
  - name: bootloader_crc
  - name: bootloader_aes_sha_ecdsa
  - name: bootloader_token_management
  - name: bootloader_image_parser
provides:
  - name: unittest_btl_gbl_parser_app_info
metadata:
    sbom:
        license: MSLA
root_path: bootloader
