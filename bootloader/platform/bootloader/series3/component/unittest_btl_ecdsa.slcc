id: unit_test_btl_ecdsa
label: Bootloader Unit Test for ECDSA
package: bootloader
description: >
    This component is a unit test case for bootloader ecdsa
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_library.h)
    condition: toolchain_gcc
source:
  - path: "platform/bootloader/series3/test/src/ecdsa/ecdsa_test.c"
include:
  - path: platform/bootloader
  - path: platform/bootloader/api
    file_list:
      - path: btl_errorcode.h
requires:
  - name: peripheral_test_utils
  - name: bootloader_aes_sha_ecdsa
  - name: memory_manager
  - name: sl_main_custom_main
provides:
  - name: unit_test_btl_ecdsa
root_path: bootloader
