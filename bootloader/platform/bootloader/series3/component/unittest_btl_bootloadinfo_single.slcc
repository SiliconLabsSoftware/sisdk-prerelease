id: unit_test_btl_bootloadinfo_single
label: Bootloader Unit Test for BootloadInfo Single
package: bootloader
description: >
    This component is a unit test case for bootloader bootloadinfo single
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "BOOTLOADINFO_TEST_SINGLE"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_sixg301_storage_ext.h)
source:
  - path: "platform/bootloader/series3/storage/btl_storage_library.c"
  - path: "platform/bootloader/series3/storage/bootloadinfo/btl_storage_bootloadinfo_single.c"
  - path: "platform/bootloader/series3/test/src/bootloadinfo/bootloadinfo_test.c"
include:
  - path: platform/bootloader/series3/api
    file_list:
      - path: btl_interface_parser.h
      - path: btl_interface_storage.h
  - path: platform/bootloader/api
    file_list:
      - path: btl_errorcode.h
      - path: btl_reset_info.h
requires:
  - name: test_bootloader_core
  - name: peripheral_test_utils
  - name: btl_common_storage_single
  - name: btl_internal_storage
  - name: memory_manager
  - name: sl_main_custom_main
provides:
  - name: unit_test_btl_bootloadinfo_single
root_path: bootloader
