id: unit_test_btl_debug
label: Bootloader Unit Test for debug
package: bootloader
description: >
    This component is a unit test case for bootloader debug
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "SL_DEBUG_PRINT"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_sixg301_uart_generic.h)
    condition: toolchain_gcc
source:
  - path: "platform/bootloader/series3/test/src/debug/debug_test.c"
include:
  - path: platform/bootloader
    file_list:
      - path: debug/btl_debug.h
requires:
  - name: test_bootloader_core
  - name: peripheral_test_utils
  - name: bootloader_debug
  - name: sl_main_custom_main
provides:
  - name: unit_test_btl_debug
root_path: bootloader
