id: btl_euart_s3_unit_headers
label: Series 3 Bootloader EUART Unit-Test Driver and Headers
package: bootloader
description: >
  Provides the Series 3 bootloader EUART production source, required headers,
  delay NS wrappers, and Series 3 driver dependencies for focused unit tests
  without selecting bootloader_euart_driver or bootloader_delay_driver_nonsecure.
category: Platform|Bootloader|Test
quality: production
ui_hints:
  visibility: never
source:
- path: platform/bootloader/series3/driver/btl_driver_euart.c
- path: platform/bootloader/driver/btl_driver_delay_ns.c
include:
- path: platform/bootloader/series3
  file_list:
  - path: config/btl_config.h
- path: platform/bootloader/series3/api
  file_list:
  - path: btl_interface.h
- path: platform/bootloader/series3/driver
  file_list:
  - path: btl_driver_cmu.h
- path: platform/bootloader/common
  file_list:
  - path: api/btl_errorcode.h
  - path: api/btl_reset_info.h
- path: platform/bootloader/common/api
  file_list:
  - path: btl_errorcode.h
- path: platform/bootloader/driver
  file_list:
  - path: btl_driver_delay.h
  - path: btl_driver_util.h
  - path: btl_serial_driver.h
requires:
- name: hal_common
- name: hal_gpio
- name: hal_ldma
- name: bootloader_interface_s3_bootload_headers
provides:
- name: btl_euart_s3_unit_headers
metadata:
  sbom:
    license: MSLA
root_path: bootloader
