id: btl_interface_s3_api_unit_headers
label: Series 3 Bootloader API Interface Unit-Test Sources
package: bootloader
description: >
  Provides btl_interface.c, btl_interface_storage.c, and their required headers
  for focused Series 3 unit tests without selecting bootloader_interface_s3,
  btl_utils_image_parser, or the Secure Engine manager.
category: Platform|Bootloader|Test
quality: production
ui_hints:
  visibility: never
source:
- path: platform/bootloader/series3/api/btl_interface.c
- path: platform/bootloader/series3/api/btl_interface_storage.c
include:
- path: platform/bootloader/series3
  file_list:
  - path: config/btl_config.h
  - path: core/btl_bootload.h
  - path: core/btl_util.h
  - path: core/btl_parse.h
  - path: parser/gbl/btl_gbl_format.h
  - path: parser/gbl/btl_gbl_parser.h
  - path: security/btl_security_aes.h
  - path: security/btl_security_ecdsa.h
  - path: security/btl_security_sha256.h
  - path: security/btl_security_types.h
- path: platform/bootloader/series3/driver
  file_list:
  - path: btl_driver_cmu.h
- path: platform/bootloader/series3/api
  file_list:
  - path: btl_interface.h
  - path: btl_interface_parser.h
  - path: btl_interface_storage.h
- path: platform/bootloader/series3/storage
  file_list:
  - path: btl_storage.h
- path: platform/bootloader/series3/storage/bootloadinfo
  file_list:
  - path: btl_storage_bootloadinfo.h
- path: platform/bootloader/series3/storage/ext_mem
  file_list:
  - path: btl_storage_ext_mem.h
requires:
- name: bootloader_application_properties_header
- name: btl_include_parser
provides:
- name: btl_interface_s3_api_unit_headers
metadata:
  sbom:
    license: MSLA
root_path: bootloader
