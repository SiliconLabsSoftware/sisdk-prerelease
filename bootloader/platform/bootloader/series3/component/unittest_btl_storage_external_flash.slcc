id: unit_test_btl_storage_external_flash
label: Bootloader Unit Test for bootloader storage_external_flash
package: bootloader
description: >
    This component is a unit test case for bootloader storage_external_flash
category: Platform|Bootloader|Test
quality: internal
define:
  - name: "STORAGE_EXTERNAL_FLASH_TEST"
    value: 1
  - name: "BTL_CONFIG_FILE"
    value: QUOTE(config/test/btl_config_sixg301_storage_ext.h)
  - name: BOOTLOADER_TEST
    value: 1
source:
  - path: "platform/bootloader/series3/core/btl_core.c"
  - path: "platform/bootloader/series3/storage/btl_storage_library.c"
  - path: "platform/bootloader/series3/storage/bootloadinfo/btl_storage_bootloadinfo.c"
  - path: "platform/bootloader/series3/test/src/storage/storage_test.c"
  - path: "platform/bootloader/series3/security/btl_crc32.c"
include:
  - path: platform/bootloader/series3/api
    file_list:
      - path: btl_interface_parser.h
      - path: btl_interface_storage.h
  - path: platform/bootloader/api
    file_list:
      - path: btl_errorcode.h
      - path: btl_reset_info.h
requires:
  - name: test_bootloader_core
  - name: peripheral_test_utils
  - name: btl_internal_storage
  - name: btl_common_storage
  - name: memory_manager
  - name: sl_main_custom_main
provides:
  - name: unit_test_btl_storage_external_flash
root_path: bootloader
