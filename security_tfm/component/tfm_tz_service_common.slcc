id: tfm_tz_service_common
package: security_tfm
description: This component component includes tf-m source common to all secure services.
category: Platform|Security|TrustZone
ui_hints:
  visibility: never
quality: production
provides:
- name: tfm_tz_service_common
include:
- path: interface/include
  file_list:
  - path: psa_config.h
  - path: tfm_api.h
  - path: psa/client.h
  - path: psa/crypto_client_struct.h
  - path: psa/error.h
metadata:
  sbom:
    license: BSD-3-Clause
    upstream:
      name: TrustedFirmware-M (TF-M)
      version: v1.5
      supplier: Trusted Firmware
      url: https://review.trustedfirmware.org/TF-M/trusted-firmware-m.git
      comment: Trusted Firmware for M profile Arm CPUs
root_path: security_tfm
