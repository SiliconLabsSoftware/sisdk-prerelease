id: tfm_tz_ns_interface
package: security_tfm
label: Non-secure interface for TrustZone secure library or other applications.
description: 'This component provides tf-m source for tz_ns_interface '
category: Platform|Security|TrustZone
ui_hints:
  visibility: never
quality: production
provides:
- name: tfm_tz_ns_interface
conflicts:
- name: trustzone_secure
- name: trustzone_unaware
requires:
- name: trustzone_nonsecure
- name: tfm_crypto_defs
- name: tfm_psa_framework_api
- name: tf_psa_crypto_mbedtls
include:
- path: interface/include
  file_list:
  - path: psa/crypto_client_struct.h
  - path: psa/storage_common.h
  - path: tfm_ns_interface.h
metadata:
  sbom:
    reference: tfm_sbom
root_path: security_tfm
