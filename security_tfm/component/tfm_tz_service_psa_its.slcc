id: tfm_tz_service_psa_its
package: security_tfm
label: PSA ITS Service for TrustZone Secure Key Library
description: This component provides the tf-m source for PSA ITS for TrustZone secure library.
category: Platform|Security|TrustZone
quality: production
provides:
- name: tfm_tz_service_psa_its
include:
- path: interface/include
  condition:
  - trustzone_secure
  file_list:
  - path: psa/storage_common.h
  - path: psa/internal_trusted_storage.h
  - path: psa/error.h
- path: secure_fw/partitions/internal_trusted_storage
  condition:
  - trustzone_secure
  file_list:
  - path: tfm_its_req_mngr.h
source:
- path: interface/src/tfm_its_func_api.c
  condition:
  - trustzone_nonsecure
metadata:
  sbom:
    license: MSLA AND BSD-3-Clause
    upstream:
      name: TrustedFirmware-M (TF-M)
      version: v1.5
      supplier: Trusted Firmware
      url: https://review.trustedfirmware.org/TF-M/trusted-firmware-m.git
      comment: Trusted Firmware for M profile Arm CPUs
root_path: security_tfm
