id: tfm_tz_sl_interface
package: security_tfm
label: Interface for TrustZone Secure Key Library
description: This component provides tf-m source for the TrustZone secure library interface files
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tfm_tz_sl_interface
requires:
- name: tfm_crypto_defs
- name: tfm_psa_framework_api
include:
- path: ../
  condition:
  - trustzone_secure
metadata:
  sbom:
    reference: tfm_sbom
root_path: security_tfm
