id: tfm_tz_sl_interface
package: security_tfm
label: Interface for TrustZone Secure Key Library
description: This component provides tf-m source for the TrustZone secure library interface files
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tfm_tz_sl_interface
include:
- path: ../
  condition:
  - trustzone_secure
- path: interface/include
  unless:
  - tz_service_common
  file_list:
  - path: tfm_crypto_defs.h
  - path: tfm_api.h
  - path: psa_config.h
  - path: psa/client.h
  - path: psa/error.h
metadata:
  sbom:
    license: BSD-3-Clause
    upstream:
      name: TrustedFirmware-M (TF-M)
      version: v1.5
      supplier: Trusted Firmware
      url: https://review.trustedfirmware.org/TF-M/trusted-firmware-m.git
      comment: Trusted Firmware for M profile Arm CPUs
root_path: security_tfm
