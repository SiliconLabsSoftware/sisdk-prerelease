id: tfm_psa_its
package: security_tfm
label: PSA Persistent Storage Support (ITS)
description: 'This component provides tf-m source for the persistent storage driver. '
category: Platform|Security|PSA Crypto
quality: production
provides:
- name: tfm_psa_its
include:
- path: interface/include
  condition:
  - trustzone_secure
  unless:
  - tz_service_psa_its
  file_list:
  - path: psa/internal_trusted_storage.h
  - path: psa/error.h
- path: interface/include
  condition:
  - trustzone_secure
  file_list:
  - path: psa/storage_common.h
metadata:
  sbom:
    license: MSLA AND BSD-3-Clause
    upstream:
      name: TrustedFirmware-M (TF-M)
      version: v1.5
      supplier: Trusted Firmware
      url: https://review.trustedfirmware.org/TF-M/trusted-firmware-m.git
      comment: Trusted Firmware for M profile Arm CPUs
root_path: security_tfm
