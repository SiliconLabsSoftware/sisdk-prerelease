id: tz_service_fault_catching
package: security_trustzone
label: Fault catching service for TrustZone Secure Key Library
description: >-
    This component includes files required for fault catching tests.
category: Platform|Security|TrustZone|Test
quality: internal
provides:
  - name: tz_service_fault_catching

source:
  - path: test/fault_catching_test/fault_catching_test_s.c
    unless: [trustzone_nonsecure]

include:
  - path: test/fault_catching_test
    file_list:
      - path: fault_catching_test.h

define:
  - name: SLI_TZ_FAULT_CATCHING_TEST


metadata:
    sbom:
        license: Zlib
root_path: security_trustzone/platform/security/sl_component/sl_trustzone/
