id: bsd_socket
package: network_stack_sdk
description: >
  The BSD Socket provides an BSD-style TCP/IP communications API
label: BSD Socket
category: Service
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: bsd_socket
source:
- path: si91x_socket/sl_si91x_bsd_socket.c
  condition: ["sl_si91x_internal_stack"]
include:
- path: inc
- path: si91x_socket
- path: si91x_socket
  condition: ["sl_si91x_internal_stack"]
- path: si91x_socket
  file_list:
  - path: sl_si91x_socket_support.h

requires:
- name: bsd_socket_api
- name: sl_si91x_socket

root_path: network_stack/network_stack_sdk/./components/service/bsd_socket
