id: paho_mqtt_embedded_dual_stack
package: paho_mqtt_embedded
description: >
  Eclipse Paho MQTT C/C++ client for Embedded platforms with dual stack support
label: paho_mqtt_embedded SDK dual stack
category: Third Party
quality: evaluation
metadata:
  sbom:
    reference: paho_mqtt_embedded_sbom
provides:
- name: paho_mqtt_embedded
source:
- path: MQTTClient-C/src/MQTTClient.c
- path: MQTTPacket/src/MQTTConnectClient.c
- path: MQTTPacket/src/MQTTDeserializePublish.c
- path: MQTTPacket/src/MQTTFormat.c
- path: MQTTPacket/src/MQTTPacket.c
- path: MQTTPacket/src/MQTTSerializePublish.c
- path: MQTTPacket/src/MQTTSubscribeClient.c
- path: MQTTPacket/src/MQTTUnsubscribeClient.c
- path: MQTTClient-C/src/Si91x/MQTTSi91x_dual_stack.c
  condition: ["sl_si91x_network_dual_stack"]


include:
- path: MQTTClient-C/src
- path: MQTTClient-C/src/Si91x
- path: MQTTPacket/src/

- path: MQTTClient-C/src
  file_list:
  - path: MQTTClient.h

- path: MQTTClient-C/src/Si91x
  file_list:
  - path: MQTTSi91x_dual_stack.h
    condition: ["sl_si91x_network_dual_stack"]

- path: MQTTPacket/src/
  file_list:
  - path: MQTTConnect.h
  - path: MQTTFormat.h
  - path: MQTTPacket.h
  - path: MQTTPublish.h
  - path: MQTTSubscribe.h
  - path: MQTTUnsubscribe.h
  - path: StackTrace.h


requires:
- name: log_none
  condition: ["device_si91x"]
- name: sl_si91x_asynchronous_socket
  condition: ["sl_si91x_network_dual_stack"]
root_path: network_stack/paho_mqtt_embedded
