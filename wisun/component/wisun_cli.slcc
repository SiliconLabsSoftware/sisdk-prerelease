id: wisun_cli
label: "Wi-SUN Feature CLI Extensions"
description: >
  Automatically includes Wi-SUN feature-specific CLI command extensions
  (such as Direct Connect server, client, and PMK management commands)
  depending on which stack features and components are installed in the project.
package: "wisun"
category: "Wi-SUN|Application|Wi-SUN CLI"
quality: "production"

provides:
- name: wisun_cli

requires:
- name: wisun_direct_connect_pmk_cli
  condition: [wisun_direct_connect_pmk]
- name: wisun_dc_server_cli
  condition: [wisun_stack_dc_server]
- name: wisun_dc_client_cli
  condition: [wisun_dc_client_plugin]

metadata:
  sbom:
    license: MSLA
root_path: wisun
