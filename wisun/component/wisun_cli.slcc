id: wisun_cli
label: "Wi-SUN CLI dispatcher"
description: >
  Adds feature-specific CLI command components based on
  stack capabilities present in the project.
package: "wisun"
category: "Wi-SUN|Stack"
quality: "production"

ui_hints:
  visibility: never

provides:
- name: wisun_cli

requires:
- name: wisun_direct_connect_pmk_cli
  condition: [wisun_direct_connect_pmk]
- name: wisun_dc_server_cli
  condition: [wisun_stack_dc_server]
- name: wisun_dc_client_cli
  condition: [wisun_dc_client_plugin]

metadata:
  sbom:
    license: MSLA
root_path: wisun
