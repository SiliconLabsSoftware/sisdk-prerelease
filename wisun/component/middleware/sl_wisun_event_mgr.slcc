id: "sl_wisun_event_mgr"
label: "Wi-SUN Event Manager | Legacy"
package: "wisun"
description: >
  Deprecated. Prefer implementing sl_wisun_on_event() as documented in
  sl_wisun_api.h. This component remains available for compatibility with
  previous applications: it manages Wi-SUN events and offers an interface for
  handling them. There are two primary categories: core and socket events.
  Both of these categories support internal and external callbacks that can
  be implemented.
category: "Wi-SUN|Wi-SUN Services"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "wisun/middleware/event_manager"
provides:
- name: sl_wisun_event_mgr

source:
- path: "sl_wisun_event_mgr.c"

include:
- path: "."
  file_list:
  - "path": "sl_wisun_event_mgr.h"

requires:
- name: "sl_wisun_trace_util"
- name: "sl_mempool"

ui_hints:
  visibility: never

#-------------- Template Contribution ----------------
template_contribution:
#---------------- Component Catalog ------------------
- name: "event_handler"
  value:
    event: "internal_app_init"
    include: "sl_wisun_event_mgr.h"
    handler: "app_wisun_event_mgr_init"

- name: component_catalog
  value: wisun_event_mgr
