id: "wisun_stack_dc_client"
label: "Wi-SUN Direct connect Client device type"
description: >
  Wi-SUN Direct Connect client device type. Provides stack device type for
  DC-client-only builds.
package: "wisun"
category: "Wi-SUN|Stack"
quality: "evaluation"
root_path: "wisun/./stack"

ui_hints:
  visibility: never

requires:
- name: "device_supports_wisun"
- name: "wisun_dc_client_library"

conflicts:
- name: "wisun_br_stack"
- name: "wisun_stack_ffn"
- name: "wisun_stack_lfn"

source:
- path: "src/sl_wisun_regdb.c"
  project:
    transfer_ownership: true

define:
- name: "HAVE_DIRECT_CONNECT"
- name: "HAVE_DIRECT_CONNECT_CLIENT"

provides:
- name: "wisun_stack_dc_client"
- name: "wisun_stack_device_type"

metadata:
  sbom:
    license: MSLA
