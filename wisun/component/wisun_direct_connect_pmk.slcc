id: "wisun_direct_connect_pmk"
label: "Wi-SUN Direct Connect PMK"
description: >
  Imports the Direct Connect PMK into a fixed PSA key slot defined by the PMK_KEY_ID. The PMK and PMK_KEY_ID are configured
  in sl_wisun_direct_connect_pmk_config.h.
package: "wisun"
category: "Wi-SUN|Application"
quality: "production"
root_path: "wisun/./plugin"

requires:
- name: "a_wisun_stack"

provides:
- name: "wisun_direct_connect_pmk"

source:
- path: "sl_wisun_direct_connect_pmk.c"
  project:
    transfer_ownership: true

include:
- path: "."
  file_list:
  - path: "sl_wisun_direct_connect_pmk.h"

config_file:
- path: "config/sl_wisun_direct_connect_pmk_config.h"

template_contribution:
- name: event_handler
  value:
    event: internal_app_init
    include: sl_wisun_direct_connect_pmk.h
    handler: sl_wisun_direct_connect_pmk_init
- name: component_catalog
  value: wisun_direct_connect_pmk

metadata:
  sbom:
    license: MSLA
