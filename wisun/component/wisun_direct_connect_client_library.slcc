id: "wisun_direct_connect_client_library"
label: "Wi-SUN Direct Connect Client implemtation "
description: "Enables Wi-SUN Direct Connect Client capability"
package: "wisun"
category: "Wi-SUN"
quality: "evaluation"
root_path: "wisun/./stack"

ui_hints:
  visibility: never

requires:
- name: "wisun_stack_ffn"

conflicts:
- name: "wisun_br_stack"

provides:
- name: "wisun_direct_connect_client"
- name: "wisun_direct_connect_client_library"

define:
- name: "HAVE_DIRECT_CONNECT_CLIENT"
- name: "HAVE_DIRECT_CONNECT"

library:
- path: "libwisun_dc_client_efr32xg2x_gcc_debug.a"
  condition:
  - "toolchain_gcc"
  - "device_series_2"
  - "wisun_stack_debug"
- path: "libwisun_dc_client_efr32xg2x_iar_debug.a"
  condition:
  - "toolchain_iar"
  - "device_series_2"
  - "wisun_stack_debug"
- path: "libwisun_dc_client_efr32xg2x_gcc_release.a"
  condition:
  - "toolchain_gcc"
  - "device_series_2"
  unless:
  - "wisun_stack_debug"
- path: "libwisun_dc_client_efr32xg2x_iar_release.a"
  condition:
  - "toolchain_iar"
  - "device_series_2"
  unless:
  - "wisun_stack_debug"

metadata:
  sbom:
    license: MSLA
