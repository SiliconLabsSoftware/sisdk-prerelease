id: "wisun_crypto"
label: "Wi-SUN Crypto"
description: "This component provides the dependencies for Wi-SUN cryptographic services, such as encryption and hash functions."
package: "wisun"
category: "Wi-SUN"
quality: "production"
root_path: "wisun/./stack"

ui_hints:
  visibility: never

requires:
- name: "psa_crypto_aes"
- name: "psa_crypto_cipher_ecb"
- name: "psa_crypto_ccm"
- name: "psa_crypto_ecc_secp256r1"
- name: "psa_crypto_hmac"
- name: "psa_crypto_sha1"
- name: "psa_crypto_sha256"
- name: "psa_crypto_tls12_prf"
- name: "psa_its"
- name: "se_manager"
- name: "mbedtls_ssl_client"
- name: "mbedtls_ssl_proto_tls12"
- name: "mbedtls_key_exchange_ecdhe_ecdsa"
- name: "mbedtls_ecc_secp256r1"
- name: "mbedtls_ecdh"
- name: "mbedtls_pem_parse"

provides:
- name: "wisun_crypto"

template_contribution:
- name: "psa_key_slots"
  value:
    name: "psa_key_slots_wisun_stack"
    count: "12"
  unless: [wisun_br_stack]
- name: "psa_key_slots"
  value:
    name: "psa_key_slots_wisun_stack"
    count: "31"
  condition: [wisun_br_stack]
- name: "psa_its_files"
  value:
    name: psa_its_files_wisun_stack
    count: "9"

- name: component_catalog
  value: wisun_crypto

metadata:
  sbom:
    license: MSLA
