id: "wisun_stack_dc_server"
label: "Wi-SUN Direct Connect Server Support"
description: >
  Enables Wi-SUN Direct Connect (DC) server on an FFN or Border Router stack.
package: "wisun"
category: "Wi-SUN|Stack Plugin|Direct Connect"
quality: "production"
root_path: "wisun/./stack"

requires:
- name: "wisun_stack_supports_dc_server"
- name: "wisun_dc_server_plugin"

conflicts:
- name: "wisun_dc_client_library"

provides:
- name: "wisun_stack_dc_server"

template_contribution:
- name: component_catalog
  value: wisun_dc_server_support

metadata:
  sbom:
    license: MSLA
