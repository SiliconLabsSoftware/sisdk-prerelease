id: "wisun_stack_dc_server"
label: "Wi-SUN Direct Connect Server Support"
description: >
  Enables Wi-SUN Direct Connect (DC) server on an FFN or
  Border Router stack. Without this component, DC server APIs return
  SL_STATUS_NOT_AVAILABLE.
package: "wisun"
category: "Wi-SUN|Stack"
quality: "production"
root_path: "wisun/./stack"

requires:
- name: "device_supports_wisun"
- name: "wisun_stack_supports_dc_server"

provides:
- name: "wisun_stack_dc_server"
- name: "wisun_dc_server_implementation"

template_contribution:
- name: component_catalog
  value: wisun_dc_server_support

library:
  # FFN DC server plugin
- path: "libwisun_dc_server_ffn_plugin_efr32xg2x_gcc_debug.a"
  condition:
  - "device_series_2"
  - "toolchain_gcc"
  - "wisun_stack_debug"
  - "wisun_stack_ffn"
- path: "libwisun_dc_server_ffn_plugin_efr32xg2x_iar_debug.a"
  condition:
  - "device_series_2"
  - "toolchain_iar"
  - "wisun_stack_debug"
  - "wisun_stack_ffn"
- path: "libwisun_dc_server_ffn_plugin_efr32xg2x_llvm_debug.a"
  condition:
  - "device_series_2"
  - "toolchain_llvm"
  - "wisun_stack_debug"
  - "wisun_stack_ffn"
- path: "libwisun_dc_server_ffn_plugin_efr32xg2x_gcc_release.a"
  condition:
  - "device_series_2"
  - "toolchain_gcc"
  - "wisun_stack_ffn"
  unless:
  - "wisun_stack_debug"
- path: "libwisun_dc_server_ffn_plugin_efr32xg2x_iar_release.a"
  condition:
  - "device_series_2"
  - "toolchain_iar"
  - "wisun_stack_ffn"
  unless:
  - "wisun_stack_debug"
- path: "libwisun_dc_server_ffn_plugin_efr32xg2x_llvm_release.a"
  condition:
  - "device_series_2"
  - "toolchain_llvm"
  - "wisun_stack_ffn"
  unless:
  - "wisun_stack_debug"
  # BR DC server plugin
- path: "libwisun_dc_server_br_plugin_efr32xg2x_gcc_debug.a"
  condition:
  - "device_series_2"
  - "toolchain_gcc"
  - "wisun_stack_debug"
  - "wisun_br_stack"
- path: "libwisun_dc_server_br_plugin_efr32xg2x_iar_debug.a"
  condition:
  - "device_series_2"
  - "toolchain_iar"
  - "wisun_stack_debug"
  - "wisun_br_stack"
- path: "libwisun_dc_server_br_plugin_efr32xg2x_llvm_debug.a"
  condition:
  - "device_series_2"
  - "toolchain_llvm"
  - "wisun_stack_debug"
  - "wisun_br_stack"
- path: "libwisun_dc_server_br_plugin_efr32xg2x_gcc_release.a"
  condition:
  - "device_series_2"
  - "toolchain_gcc"
  - "wisun_br_stack"
  unless:
  - "wisun_stack_debug"
- path: "libwisun_dc_server_br_plugin_efr32xg2x_iar_release.a"
  condition:
  - "device_series_2"
  - "toolchain_iar"
  - "wisun_br_stack"
  unless:
  - "wisun_stack_debug"
- path: "libwisun_dc_server_br_plugin_efr32xg2x_llvm_release.a"
  condition:
  - "device_series_2"
  - "toolchain_llvm"
  - "wisun_br_stack"
  unless:
  - "wisun_stack_debug"

metadata:
  sbom:
    license: MSLA
