id: wisun_rcp
label: Wi-SUN Border Router RCP (proxy package)
description: Provide Wi-SUN Border Router RCP
package: wisun
category: "Wi-SUN|Application|Wi-SUN RCP"
quality: production


ui_hints:
  visibility: never

requires:
- name: device_supports_wisun
- name: iostream
- name: rail_lib
- name: rail_lib_multiprotocol
  condition: [bluetooth_stack]
- name: sl_rail_util_compatible_pa
- name: cmsis_rtos2
- name: nvm3
- name: slist
- name: sl_rail_util_pti
- name: wisun_crypto
- name: sleeptimer
- name: hal_prs
- name: clock_manager_runtime

recommends:
- id: rail_lib_singleprotocol

  vendor: silabs
define:
- name: "HAVE_LFN_PARENT"
- name: "HAVE_ROUTER"
- name: "HAVE_MODE_SWITCH"
- name: "MBED_CONF_NANOSTACK_CONFIGURATION"
  value: "ws_router"
- name: "MBED_TRACE_MAX_LEVEL"
  value: "TRACE_ACTIVE_LEVEL_ALL"
- name: "MBED_CONF_MBED_TRACE_ENABLE"
  value: "1"

provides:
- name: wisun_rcp

include:
- path: app/wisun_rcp
  file_list:
  - path: sl_wsrcp_log.h
  - path: sl_wsrcp_mac.h
  - path: sl_wsrcp_utils.h
  - path: sl_wsrcp_version.h
- path: "stack/inc/"
  file_list:
  - path: "sl_wisun_ip6string.h"
- path: stack/src
  file_list:
  - path: common/bits.h
  - path: common/endian.h
  - path: common/int24.h
  - path: common/iobuf.h
  - path: common/string_extra.h
  - path: common/math_utils.h
  - path: common/ns_list.h
  - path: common/ns_types.h
- path: stack/inc
  file_list:
  - path: sl_wisun_types.h
  - path: sl_wisun_common.h
  - path: sli_wisun_timer_service.h

library:
- path: stack/libwisun_rcp_efr32xg2x_gcc_debug.a
  condition: [device_series_2, toolchain_gcc, wisun_stack_debug]
- path: stack/libwisun_rcp_efr32xg2x_iar_debug.a
  condition: [device_series_2, toolchain_iar, wisun_stack_debug]
- path: stack/libwisun_rcp_efr32xg2x_llvm_debug.a
  condition: [device_series_2, toolchain_llvm, wisun_stack_debug]

- path: stack/libwisun_rcp_efr32xg2x_gcc_release.a
  condition: [device_series_2, toolchain_gcc]
  unless: [wisun_stack_debug]
- path: stack/libwisun_rcp_efr32xg2x_iar_release.a
  condition: [device_series_2, toolchain_iar]
  unless: [wisun_stack_debug]
- path: stack/libwisun_rcp_efr32xg2x_llvm_release.a
  condition: [device_series_2, toolchain_llvm]
  unless: [wisun_stack_debug]

validation_helper:
- path: component/component_validation/rcp_validation.lua

template_contribution:
- name: component_catalog
  value: wisun_rcp

metadata:
  sbom:
    license: MSLA AND Apache-2.0
    upstream:
      name: Nanostack
      version: 14.0.0
      supplier: Pelion and affiliates
      url: https://github.com/ARMmbed/mbed-os/tree/9957e7b4ae4315e6d1d2bc064c469e69fb34ff78/features/nanostack
root_path: wisun
