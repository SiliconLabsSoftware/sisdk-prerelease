id: wisun_rcp_uart
label: Wi-SUN RCP - UART interface
description: >
  Provides Wi-SUN RCP UART interface. It is used by default if CPC
  is not installed. UART and CPC interfaces are mutually exclusive.
package: wisun
category: "Wi-SUN|Application|Wi-SUN RCP"
quality: evaluation
root_path: wisun/./app/wisun_rcp

ui_hints:
  visibility: never

config_file:
- path: config/sl_wsrcp_uart_config.h

provides:
- name: wisun_rcp_uart
- name: wisun_rcp_interface

requires:
- name: dma_manager
- name: emlib_eusart
- name: wisun_rcp

source:
- path: sl_wsrcp_crc.h
- path: sl_wsrcp_crc.c
- path: sl_wsrcp_uart.h
- path: sl_wsrcp_uart.c
- path: sl_wsrcp_eusart.c

include:
- path: .
  file_list:
  - path: sl_wsrcp_crc.h
  - path: sl_wsrcp_uart.h

template_contribution:
- name: component_catalog
  value: wisun_rcp_uart

metadata:
  sbom:
    license: MSLA
