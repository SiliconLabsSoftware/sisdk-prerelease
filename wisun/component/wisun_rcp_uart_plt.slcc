id: wisun_rcp_uart_plt
label: Wi-SUN RCP - UART (platform) interface
description: >
  Provides Wi-SUN RCP UART interface using the platform driver.
  UART and CPC interfaces are mutually exclusive.
package: wisun
category: "Wi-SUN|Application|Wi-SUN RCP"
quality: evaluation
root_path: wisun/./app/wisun_rcp

ui_hints:
  visibility: never

define:
- name: DEBUG_EFM

requires:
- name: wisun_rcp

provides:
- name: wisun_rcp_uart_plt
- name: wisun_rcp_interface

source:
- path: sl_wsrcp_crc.h
- path: sl_wsrcp_crc.c
- path: sl_wsrcp_uart_plt.h
- path: sl_wsrcp_uart_plt.c

include:
- path: .
  file_list:
  - path: sl_wsrcp_crc.h
  - path: sl_wsrcp_uart_plt.h

metadata:
  sbom:
    license: MSLA
