id: "wisun_low_power"
label: "Wi-SUN Low Power"
description: "Add low power capability for Wi-SUN LFN sleep"
package: "wisun"
category: "Wi-SUN|Wi-SUN Plugin"
quality: "production"

provides:
- name: "wisun_low_power"

requires:
- name: "power_manager"
- name: "device_init_dcdc"
  condition: [device_has_dcdc]

conflicts:
- name: "wisun_br_stack"


source:
- path: "plugin/app_custom_cli_tick.c"
  condition: [cli]

validation_helper:
- path: component/scripts/low_power_validation.lua

template_contribution:
- name: component_catalog
  value: wisun_low_power

documentation:
  docset: wisun
  document: wisun-stack-api/sl-wisun-low-power

metadata:
  sbom:
    license: MSLA
root_path: wisun
