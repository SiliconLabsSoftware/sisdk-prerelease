id: "wisun_ffn_power_saving"
label: "Wi-SUN FFN power saving"
description: >
  Adds ffn power saving feature to the Wi-SUN stack.
  For the FFN it adds the local power saving capability plus FFN peer's power saving schedule estimation.
  For LFN/BR it only adds FFN peer's power saving schedule estimation.
package: "wisun"
category: "Wi-SUN"
quality: "production"
root_path: "wisun/./stack"

requires:
- name: "a_wisun_stack"
- name: "wisun_low_power"
  condition:
  - "wisun_stack_ffn"

provides:
- name: "wisun_ffn_power_saving_implementation"
- name: "wisun_ffn_power_saving"

library:
- path: "libwisun_ffn_power_saving_efr32xg2x_gcc_debug.a"
  condition: [device_series_2, toolchain_gcc, wisun_stack_debug, wisun_stack_ffn]
- path: "libwisun_ffn_power_saving_efr32xg2x_iar_debug.a"
  condition: [device_series_2, toolchain_iar, wisun_stack_debug, wisun_stack_ffn]
- path: "libwisun_ffn_power_saving_efr32xg2x_llvm_debug.a"
  condition: [device_series_2, toolchain_llvm, wisun_stack_debug, wisun_stack_ffn]
- path: "libwisun_ffn_power_saving_efr32xg2x_gcc_release.a"
  condition: [device_series_2, toolchain_gcc, wisun_stack_ffn]
  unless: [wisun_stack_debug]
- path: "libwisun_ffn_power_saving_efr32xg2x_iar_release.a"
  condition: [device_series_2, toolchain_iar, wisun_stack_ffn]
  unless: [wisun_stack_debug]
- path: "libwisun_ffn_power_saving_efr32xg2x_llvm_release.a"
  condition: [device_series_2, toolchain_llvm, wisun_stack_ffn]
  unless: [wisun_stack_debug]
- path: "libwisun_ffn_power_saving_peers_schedule_efr32xg2x_gcc_debug.a"
  condition: [device_series_2, toolchain_gcc, wisun_stack_debug]
  unless: [wisun_stack_ffn]
- path: "libwisun_ffn_power_saving_peers_schedule_efr32xg2x_iar_debug.a"
  condition: [device_series_2, toolchain_iar, wisun_stack_debug]
  unless: [wisun_stack_ffn]
- path: "libwisun_ffn_power_saving_peers_schedule_efr32xg2x_llvm_debug.a"
  condition: [device_series_2, toolchain_llvm, wisun_stack_debug]
  unless: [wisun_stack_ffn]
- path: "libwisun_ffn_power_saving_peers_schedule_efr32xg2x_gcc_release.a"
  condition: [device_series_2, toolchain_gcc]
  unless: [wisun_stack_debug, wisun_stack_ffn]
- path: "libwisun_ffn_power_saving_peers_schedule_efr32xg2x_iar_release.a"
  condition: [device_series_2, toolchain_iar]
  unless: [wisun_stack_debug, wisun_stack_ffn]
- path: "libwisun_ffn_power_saving_peers_schedule_efr32xg2x_llvm_release.a"
  condition: [device_series_2, toolchain_llvm]
  unless: [wisun_stack_debug, wisun_stack_ffn]

template_contribution:
- name: component_catalog
  value: wisun_ffn_power_saving_support
  condition:
  - "wisun_stack_ffn"

metadata:
  sbom:
    license: MSLA
