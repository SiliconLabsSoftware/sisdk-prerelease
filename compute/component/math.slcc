  - path: sl_math_matrix_scale.h
  - path: sl_math_matrix_sub.h
  - path: sl_math_matrix_transpose.h
  - path: sl_math_matrix_vector_mult.h
  - path: sl_math_vector_abs.h
  - path: sl_math_vector_add.h
  - path: sl_math_vector_clamp.h
  - path: sl_math_vector_clip.h
  - path: sl_math_vector_copy.h
  - path: sl_math_vector_dot_product.h
  - path: sl_math_vector_fill.h
  - path: sl_math_vector_mult.h
  - path: sl_math_vector_negate.h
