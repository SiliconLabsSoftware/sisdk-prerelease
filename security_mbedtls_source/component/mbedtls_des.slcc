id: mbedtls_des
package: security_mbedtls_source
label: DES
description: This component provides the legacy DES cipher implementation from Mbed TLS.
category: Platform|Security|Mbed TLS|Encryption
quality: production
ui_hints:
  visibility: never
provides:
- name: mbedtls_des
requires:
- name: mbedtls_core
source:
- path: library/des.c
include:
- path: include/mbedtls
  file_list:
  - path: des.h
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_DES_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls_source
