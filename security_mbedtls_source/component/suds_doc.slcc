id: suds_doc
label: SUDS Documentation Component
package: security_mbedtls_source
quality: production
ui_hints:
  visibility: never
category: Platform|Security|SUDS Doc
description: This component provides additional source paths for offical psec api documentation. SUDS doxygen setup will by default parse each component in platform/security, and include referenced header files
include:
- path: doxygen/input
  file_list:
  - path: doc_encdec.h
  - path: doc_rng.h
  - path: doc_hashing.h
  - path: doc_ssltls.h
  - path: doc_tcpip.h
  - path: doc_x509.h
metadata:
  sbom:
    license: Zlib AND Apache-2.0
    upstream:
      name: Mbed TLS
      version: v3.6.2
      supplier: Trusted Firmware
      url: https://github.com/Mbed-TLS/mbedtls.git
      comment: Mbed TLS is a C library implementing the PSA Cryptography API, cryptographic primitives, X.509 certificate manipulation and the SSL/TLS and DTLS protocols
root_path: security_mbedtls_source
