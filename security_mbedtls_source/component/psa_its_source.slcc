id: psa_its_source
package: security_mbedtls_source
label: PSA Persistent Storage Support (ITS) - MbedTLS Sources
description: This component provides the mbedtls library sources for PSA ITS (Internal  Trusted Storage) API support.
category: Platform|Security|PSA Crypto
quality: production
provides:
- name: psa_its_source
include:
- path: library
  unless:
  - trustzone_secure
  file_list:
  - path: psa_crypto_its.h

metadata:
  sbom:
    license: Zlib AND Apache-2.0
    upstream:
      name: Mbed TLS
      version: v3.6.2
      supplier: Trusted Firmware
      url: https://github.com/Mbed-TLS/mbedtls.git
      comment: Mbed TLS is a C library implementing the PSA Cryptography API, cryptographic primitives, X.509 certificate manipulation and the SSL/TLS and DTLS protocols
root_path: security_mbedtls_source
