# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: mp-zb-ot-ble-rcp-uart-brd4407a
label: mp-zb-ot-ble-rcp-uart-brd4407a
description: |
  Demonstrates a Multiprotocol 802.15.4 RCP application running OpenThread, Zigbee (CMP/multi-PAN), and BLE (DMP) over UART using CPC for host communication.
category: OpenThread Examples
filter:
- name: Capability
  value:
  - Multiprotocol
- name: Device Type
  value:
  - RCP
- name: Project Difficulty
  value:
  - Advanced
- name: Wireless Technology
  value:
  - Bluetooth
  - Thread
  - Zigbee
package: multiprotocol_app
quality: production
readme:
- path: readme-mp-zb-ot-ble-rcp-uart.md
source:
- path: app.c
tag:
- prebuilt_demo
- hwfilter:device:device_supports_bluetooth
- hwfilter:board:hardware_board_has_uart
- hwfilter:device:device_supports_thread
- toolchain:llvm
- toolchain:gcc
include:
- path: .
  file_list:
  - path: app.h
