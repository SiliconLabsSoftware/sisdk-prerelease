configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: SL_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
  value: '1'
- name: SL_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
  value: '1'
- condition:
  - iostream_usart
  name: SL_IOSTREAM_USART_VCOM_RX_BUFFER_SIZE
  value: '128'
- condition:
  - iostream_eusart
  name: SL_IOSTREAM_EUSART_VCOM_RX_BUFFER_SIZE
  value: '128'
- name: SL_HEAP_SIZE
  value: '16384'
- condition:
  - toolchain_lto
  unless:
  - freertos
  name: SL_STACK_SIZE
  value: '6144'
- condition:
  - freertos
  unless:
  - toolchain_lto
  name: SL_STACK_SIZE
  value: '4608'
- condition:
  - toolchain_lto
  - freertos
  name: SL_STACK_SIZE
  value: '5120'
- unless:
  - toolchain_lto
  - freertos
  name: SL_STACK_SIZE
  value: '5120'
- condition:
  - sl_main
  - freertos
  name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
  value: '4608'
- condition:
  - sl_main
  unless:
  - freertos
  name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
  value: '5120'
- name: OPENTHREAD_CONFIG_TMF_NETDIAG_CLIENT_ENABLE
  value: '0'
- condition:
  - ot_rtt_log
  name: OPENTHREAD_CONFIG_LOG_OUTPUT
  value: OPENTHREAD_CONFIG_LOG_OUTPUT_PLATFORM_DEFINED
- condition:
  - ot_rtt_log
  name: BUFFER_SIZE_UP
  value: '768'
- condition:
  - ot_rtt_log
  name: BUFFER_SIZE_DOWN
  value: '0'
- name: configTIMER_TASK_PRIORITY
  value: '53'
- name: CIRCULAR_QUEUE_LEN_MAX
  value: '16'
- condition:
  - iostream_usart
  name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
  value: usartHwFlowControlCtsAndRts
- condition:
  - iostream_eusart
  name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
  value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
- condition:
  - toolchain_lto
  name: SL_OPENTHREAD_SERIAL_TASK_MEM_SIZE
  value: '3072'
- condition:
  - toolchain_lto
  name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE
  value: '7168'
- condition:
  - toolchain_lto
  name: configTOTAL_HEAP_SIZE
  value: '16384'
ui_hints:
  highlight:
  - path: config/gatt_configuration.btconf
  - path: ./README.md
    focus: true
