# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: mp-ot-ble-soc-minimal-brd4116a
label: mp-ot-ble-soc-minimal-brd4116a
description: |
  Demonstrates DMP (Dynamic Multiprotocol) with OpenThread and Bluetooth without button UI running on FreeRTOS. For boards without buttons.
category: OpenThread Examples
filter:
- name: Capability
  value:
  - Multiprotocol
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Advanced
- name: Wireless Technology
  value:
  - Bluetooth
  - Thread
package: multiprotocol_app
quality: production
readme:
- path: README.md
source:
- path: app.c
- path: bluetooth_event_callback.c
tag:
- prebuilt_demo
- hwfilter:device:device_supports_bluetooth
- hwfilter:flash:768k
- hwfilter:device:device_supports_thread
- toolchain:llvm
- toolchain:gcc
- hardware:device:flash:768
- hwfilter:!device:device_family_efr32mr21
include:
- path: .
  file_list:
  - path: app.h
