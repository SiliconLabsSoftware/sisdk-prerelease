id: ot_multi_instance_cert_libs
label: OpenThread Multi-Instance Certification Libraries
package: thread
category: OpenThread|Certification
quality: production
description: >
  Includes OpenThread stack libraries that could be used for certification by inheritance. Uses default certification configurations.
  Note: Please refer to the release notes to verify if the SDK has been qualified for certification.
provides:
- name: ot_multi_instance_cert_libs
requires:
- name: ot_cert_libs
- name: ot_multi_instance_cert_config
recommends:
- id: ot_cert_libs
  vendor: silabs
library:
- path: libs/build/gcc/cortex-m33/sl-openthread-cert-library/Release/libsl_ot_stack_ftd_mi_coap.a
  condition:
  - toolchain_gcc
  - cortexm33
  - ot_stack_ftd
- path: libs/build/gcc/cortex-m33/sl-openthread-cert-library/Release/libsl_ot_stack_mtd_mi_coap.a
  condition:
  - toolchain_gcc
  - cortexm33
  - ot_stack_mtd
- path: libs/build/gcc/cortex-m55/sl-openthread-cert-library/Release/libsl_ot_stack_ftd_mi_coap.a
  condition:
  - toolchain_gcc
  - cortexm55
  - ot_stack_ftd
- path: libs/build/gcc/cortex-m55/sl-openthread-cert-library/Release/libsl_ot_stack_mtd_mi_coap.a
  condition:
  - toolchain_gcc
  - cortexm55
  - ot_stack_mtd
- path: libs/build/llvm/cortex-m33/sl-openthread-cert-library/Release/libsl_ot_stack_ftd_mi_coap.a
  condition:
  - toolchain_llvm
  - cortexm33
  - ot_stack_ftd
- path: libs/build/llvm/cortex-m33/sl-openthread-cert-library/Release/libsl_ot_stack_mtd_mi_coap.a
  condition:
  - toolchain_llvm
  - cortexm33
  - ot_stack_mtd
- path: libs/build/llvm/cortex-m55/sl-openthread-cert-library/Release/libsl_ot_stack_ftd_mi_coap.a
  condition:
  - toolchain_llvm
  - cortexm55
  - ot_stack_ftd
- path: libs/build/llvm/cortex-m55/sl-openthread-cert-library/Release/libsl_ot_stack_mtd_mi_coap.a
  condition:
  - toolchain_llvm
  - cortexm55
  - ot_stack_mtd
documentation:
  docset: openthread
  document: thread-fundamentals/14-thread-certification-overview
metadata:
  sbom:
    # BSD-3-Clause covers the files included in the libraries from
    # util/third_party/openthread and platform-abstraction/efr32.
    license: BSD-3-Clause
root_path: thread
