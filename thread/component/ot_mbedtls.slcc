id: ot_mbedtls
label: mbedTLS
package: thread
category: OpenThread|Crypto
quality: production
description: This component references to all the third party support needed by the OpenThread stack
ui_hints:
  visibility: never
provides:
- name: ot_mbedtls
requires:
- name: ot_crypto_ecdsa
- name: mbedtls_ssl_proto_dtls
- name: mbedtls_ssl_client
- name: mbedtls_ssl_server
- name: mbedtls_ssl_dtls_hello_verify
- name: mbedtls_ssl_cookie
- name: mbedtls_ssl_dtls_anti_replay
- name: mbedtls_key_exchange_ecdhe_ecdsa
- name: mbedtls_jpake
  # TLS EC J-PAKE ciphersuite / set_hs_ecjpake_password(_opaque) APIs.
- name: mbedtls_key_exchange_ecjpake
- name: mbedtls_ecc_secp256r1
- name: mbedtls_cmac
recommends:
- id: ot_crypto_ecdsa_deterministic
  vendor: silabs
template_contribution:
- name: mbedtls_ssl_content_len_in_requirement
  value: 900
- name: mbedtls_ssl_content_len_out_requirement
  value: 900
define:
- name: OPENTHREAD_CONFIG_ENABLE_BUILTIN_MBEDTLS
  value: 0
metadata:
  sbom:
    license: Zlib
root_path: thread
