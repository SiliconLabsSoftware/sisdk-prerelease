id: ot_multi_instance_cert_config
label: OpenThread Multi-Instance Certification Config
package: thread
category: OpenThread|Certification
quality: production
description: >
  Compile definitions for producing and linking with OpenThread multi-instance certification libraries.
provides:
- name: ot_multi_instance_cert_config
requires:
- name: ot_coap_cert_config
define:
- name: OPENTHREAD_CONFIG_MULTIPLE_INSTANCE_ENABLE
  value: "1"
- name: OPENTHREAD_CONFIG_MULTIPLE_STATIC_INSTANCE_ENABLE
  value: "1"
- name: OPENTHREAD_CONFIG_MULTIPLE_INSTANCE_NUM
  value: "2"
- name: OPENTHREAD_CONFIG_LOG_INSTANCE_AWARE_API_ENABLE
  value: "1"
ui_hints:
  visibility: never
metadata:
  sbom:
    license: BSD-3-Clause
root_path: thread
