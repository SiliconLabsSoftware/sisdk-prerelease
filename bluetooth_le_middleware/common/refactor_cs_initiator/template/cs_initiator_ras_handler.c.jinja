#include <stdint.h>

{%- set includes = [] -%}
{%- for handler in cs_initiator_on_ras_data %}
{%- if 'include' in handler and handler['include'] not in includes -%}
{%- if includes.append(handler['include']) %}{% endif -%}
{%- endif -%}
{%- endfor -%}
{%- for include in includes %}
#include "{{include}}"
{%- endfor %}

/***************************************************************************//**
 * Dispatch ranging data from the initiator to every component that registered
 * a handler via the 'cs_initiator_on_ras_data' template contribution (
 * cs_algo::cs_algo_process_ras_data).
 *
 * @param[in] conn_handle     Connection handle.
 * @param[in] ranging_counter Procedure ranging counter.
 * @param[in] proc_info        Contains procedure data 
 * @param[in] ranging_data    Pointer to the initiator-owned unified ranging
 *                            data buffer for this procedure.
 ******************************************************************************/
void cs_initiator_dispatch_ras_data(uint8_t conn_handle,
                                    uint16_t ranging_counter,
                                    cs_algo_procedure_info_t proc_info,
                                    unified_ranging_data_t *ranging_data)
{
  (void)conn_handle;
  (void)ranging_counter;
  (void)proc_info;
  (void)ranging_data;
{% for handler in cs_initiator_on_ras_data %}
  {{ handler['handler'] }}(conn_handle, ranging_counter, proc_info, ranging_data);
{% endfor %}
}
