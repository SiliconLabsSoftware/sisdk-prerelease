id: cs_algo
package: bluetooth_le_middleware
label: CS Algo
description: >
  Channel Sounding (CS) Algo manages estimators for connections, gathers parameters
  for estimator creation, and performs the distance estimation using the RTL lib.
category: Bluetooth|Application|Miscellaneous
metadata:
  sbom:
    license: Zlib
quality: production

include:
- path: common/cs_algo/inc
  file_list:
  - path: cs_algo.h
  - path: cs_algo_log.h
source:
- path: common/cs_algo/src/cs_algo.c

config_file:
- path: common/cs_algo/config/cs_algo_config.h

requires:
- name: rtllib
- name: refactor_cs_result
- name: refactor_cs_initiator
- name: app_log
- name: bluetooth_api
- name: bluetooth_feature_cs
- name: sl_common
- name: component_catalog
provides:
- name: cs_algo

template_contribution:
- name: cs_initiator_on_ras_data
  value:
    include: cs_algo.h
    handler: cs_algo_process_ras_data
- name: event_handler
  value:
    event: internal_app_init
    include: cs_algo.h
    handler: cs_algo_init

documentation:
  docset: bluetooth
  document: bluetooth-service-api/cs-algo

validation_helper:
- path: common/cs_algo/config/cs_algo_validation.lua
root_path: bluetooth_le_middleware
