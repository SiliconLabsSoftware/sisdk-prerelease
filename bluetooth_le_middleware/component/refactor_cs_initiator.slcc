id: refactor_cs_initiator
package: bluetooth_le_middleware
label: CS Initiator
description: >
  Channel Sounding (CS) Initiator provides an instantiable initiator (central) logic that produce its own CS results
  and also collects CS results from CS Reflector (peripheral) devices.
  Once all initiator and reflector results collected correctly it is forwarded to the RTL lib that shall
  produce the high-level measurement values e.g. distance, likeliness of the current distance, etc.
category: Bluetooth|Application|Miscellaneous
metadata:
  sbom:
    license: Zlib
quality: production

include:
- path: common/refactor_cs_initiator/inc
  file_list:
  - path: cs_initiator.h
  - path: cs_initiator_common.h
  - path: cs_initiator_log.h
  - path: cs_initiator_error.h
  - path: cs_initiator_state_machine.h

source:
- path: common/refactor_cs_initiator/src/cs_initiator.c
- path: common/refactor_cs_initiator/src/cs_initiator_error.c
- path: common/refactor_cs_initiator/src/cs_initiator_state_machine.c

requires:
- name: refactor_cs_initiator_client
- name: app_assert
- name: app_log
- name: app_timer
- name: bluetooth_api
- name: bluetooth_feature_connection_role_central
- name: bluetooth_feature_cs
- name: bluetooth_feature_extended_scanner
- name: bluetooth_feature_gatt
- name: bluetooth_feature_legacy_scanner
- name: component_catalog
- name: power_manager
- name: cs_algo
- name: printf
- name: sleeptimer
- name: sl_common
- name: cs_rreq

provides:
- name: refactor_cs_initiator

template_contribution:
- name: ncp_local_evt_process
  value:
    include: cs_initiator.h
    handler: cs_initiator_on_event
  priority: 420   # cs_ras_client_on_bt_event must be higher than cs_initiator_on_event
  condition:
  - ncp
- name: bluetooth_on_event
  value:
    include: cs_initiator.h
    function: cs_initiator_on_event
  priority: 420   # cs_ras_client_on_bt_event must be higher than cs_initiator_on_event
  unless:
  - ncp
- name: event_handler
  value:
    event: internal_app_init
    include: cs_initiator.h
    handler: cs_initiator_init
documentation:
  docset: bluetooth
  document: bluetooth-service-api/cs-initiator
validation_helper:
- path: common/refactor_cs_initiator/config/cs_initiator_validation.lua
root_path: bluetooth_le_middleware
