id: cs_manager
package: bluetooth_le_middleware
label: CS Manager
description: >
  CS Manager is a component that manages the CS configurations and procedures.
category: Bluetooth|Application|Miscellaneous
metadata:
  sbom:
    license: Zlib
quality: experimental
include:
- path: common/cs_common
  file_list:
  - path: cs_common.h
- path: common/cs_manager/inc
  file_list:
  - path: cs_manager.h
  - path: cs_manager_internal.h
  - path: cs_manager_config_db_internal.h
  - path: cs_manager_log_internal.h
source:
- path: common/cs_manager/src/cs_manager.c
- path: common/cs_manager/src/cs_manager_config_db.c
config_file:
- path: common/cs_manager/config/cs_manager_config.h
  file_id: cs_manager_config
- path: common/cs_manager/config/cs_manager_cs_config_config.h
  file_id: cs_manager_cs_config_config
  condition: cs_manager_feature_config
- path: common/cs_manager/config/cs_manager_cs_control_config.h
  file_id: cs_manager_cs_control_config
  condition: cs_manager_feature_control
requires:
- name: sl_core
- name: sl_common
- name: component_catalog
- name: bluetooth_api
- name: bluetooth_stack
  condition:
  - device_cortexm
- name: bluetooth_feature_cs
  condition:
  - device_cortexm
- name: bluetooth_feature_connection
  condition:
  - device_cortexm
- name: cs_manager_role
recommends:
- id: cs_manager_feature_reflector
  vendor: silabs
provides:
- name: cs_manager
template_contribution:
- name: event_handler
  value:
    event: internal_app_init
    include: cs_manager_internal.h
    handler: cs_manager_init
- name: bluetooth_on_event
  value:
    include: cs_manager_internal.h
    function: cs_manager_on_bt_event
  priority: 69
documentation:
  docset: bluetooth
  document: bluetooth-service-api/cs-ras-client
root_path: bluetooth_le_middleware
