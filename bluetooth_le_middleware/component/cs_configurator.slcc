id: cs_configurator
package: bluetooth_le_middleware
label: CS Configurator
description: >
  Channel Sounding (CS) Configurator is responsible for creating valid configuration for the CS procedures.
category: Bluetooth|Application|Miscellaneous
metadata:
  sbom:
    license: Zlib
quality: experimental

include:
- path: common/cs_configurator/inc
  file_list:
  - path: cs_configurator.h
  - path: cs_configurator_rtllib.h
  - path: cs_configurator_optimization.h
  - path: cs_configurator_rtllib_parameters.h
  - path: cs_configurator_WIP_helper.h

source:
- path: common/cs_configurator/src/cs_configurator.c
- path: common/cs_configurator/src/cs_configurator_rtllib.c

requires:
- name: bluetooth_api
- name: component_catalog
- name: sl_common
- name: refactor_cs_initiator_client
- name: cs_rreq

provides:
- name: cs_configurator

documentation:
  docset: bluetooth
  document: bluetooth-service-api/cs-configurator
root_path: bluetooth_le_middleware
