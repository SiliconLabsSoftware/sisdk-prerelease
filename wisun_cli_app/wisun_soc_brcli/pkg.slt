# Version defaults to "0" if not defined
version = "0.1"

[dependency]
iar-embedded-workbench = { version = "9.40.1", installer = "conan" }
gcc-arm-none-eabi = { version = "12.2.rel1", installer = "conan" }

radio_config_generator = { type = "tools", version = ">=0.0.0 <0.1.0", prerelease= true, installer = "conan"}
cpc = { version = ">=4.8.0 <4.8.1", prerelease= true, installer = "conan"}

wifi = { version = ">=4.0.0 <4.0.1", prerelease = true, installer = "conan" } # for wisun_soc_brcli_wifi
lwip = { version = ">=1", prerelease = true, installer = "conan" } # for wisun_soc_brcli_wifi
platform_siwx91x = { version = ">=4.0.0 <4.0.1", prerelease = true, installer = "conan" } # for wisun_soc_brcli_wifi

wisun = { version = ">=2.10.0 <2.10.1", prerelease = true, installer = "conan" }
