id: "sl_rail_sdk_light_switch_support"
label: "Light, Switch Support"
package: "rail_sdk"
description: "Support component for Light and Switch sample applications."
category: "RAIL-SDK|Core"
quality: "production"
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
root_path: "rail/component/sl_rail_sdk_light_switch_support"
include:
- path: ""
  file_list:
  - path: "sl_rail_sdk_light_switch_support.h"
source:
- path: "sl_rail_sdk_light_switch_support.c"
provides:
- name: "light_switch_support"

requires:
- name: "device_has_radio"
