id: "sl_rail_sdk_wmbus_packet_assembler"
label: "Wireless M-Bus sensor Packet Assembler (Wireless M-Bus Meter Only)"
package: "rail_sdk"
description: "Packet assembler component for Wireless M-Bus sensors"
category: "RAIL-SDK|Wireless M-Bus"
quality: "production"
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
root_path: "rail/component/sl_rail_sdk_wmbus_packet_assembler"

provides:
- name: sl_rail_sdk_wmbus_packet_assembler

requires:
- name: "sl_rail_sdk_wmbus_support"
- name: "emlib_gpcrc"
- name: "device_has_radio"
- name: "app_assert"

source:
- path: "sl_rail_sdk_wmbus_packet_assembler.c"
include:
- path: "."
  file_list:
  - "path": "sl_rail_sdk_wmbus_packet_assembler.h"

#-------------- Template Contribution ----------------
template_contribution:
#---------------- Component Catalog ------------------
- name: component_catalog
  value: wmbus_packet_assembler
