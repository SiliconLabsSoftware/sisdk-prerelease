id: "sl_rail_sdk_packet_assistant"
label: "Packet Assistant"
package: "rail_sdk"
description: >
  This component is a versatile radio interface layer designed to support both
  proprietary and standards-based wireless protocols. It empowers developers by
  providing an intuitive and easily-customizable radio interface. The component
  offers a consistent radio API. This ensures application portability and
  simplifies complex radio register configurations.
category: "RAIL-SDK|Utility"
quality: "production"
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: basic
documentation:
  docset: rail
  document: rail-sdk-services/rail-sdk-packet-assistant
root_path: "rail/component/sl_rail_sdk_packet_assistant"
provides:
- name: sl_rail_sdk_packet_assistant

requires:
- name: sl_rail_sdk_packet_asm
- name: device_has_radio

# according to standards the packet assembler is chosen.
source:
- path: "sl_rail_sdk_packet_assistant.c"
- path: "sl_rail_sdk_packet_assistant_cli.c"
  condition:
  - "cli"
include:
- path: "."
  file_list:
  - "path": "sl_rail_sdk_packet_assistant.h"

config_file:
- path: config/sl_rail_sdk_packet_assistant_config.h

#-------------- Template Contribution ----------------
template_contribution:
#---------------- Component Catalog ------------------
- name: component_catalog
  value: rail_packet_assistant

- name: "cli_group"
  value:
    name: "packet_assistant"
    help: "Packet assistant commands"
    shortcuts:
    - name: "pa"

- name: cli_command
  value:
    group: "packet_assistant"
    name: get_print_packet_info
    handler: cli_get_print_packet_info
    help: "Get the print setting"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_print_packet_info
    handler: cli_set_print_packet_info
    help: "Set the print setting"
    argument:
    - type: uint8
      help: "ON/OFF"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_sun_fsk_fcs
    handler: cli_get_sun_fsk_fcs
    help: "Get the SUN FSK FCS type (0 = 4-byte, 1 = 2-byte)"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_sun_fsk_fcs
    handler: cli_set_sun_fsk_fcs
    help: "Set the SUN FSK FCS type (0 = 4-byte, 1 = 2-byte)"
    argument:
    - type: uint8
      help: "0 = 4-byte FCS, 1 = 2-byte FCS"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_sun_fsk_whitening
    handler: cli_get_sun_fsk_whitening
    help: "Get the SUN FSK whitening setting"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_sun_fsk_whitening
    handler: cli_set_sun_fsk_whitening
    help: "Set the SUN FSK whitening setting"
    argument:
    - type: uint8
      help: "ON/OFF"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_sun_ofdm_scrambler
    handler: cli_get_sun_ofdm_scrambler
    help: "Get the SUN OFDM scrambler setting"
  condition:
  - "cli"
  - "device_generic_family_efr32xg25"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_sun_ofdm_scrambler
    handler: cli_set_sun_ofdm_scrambler
    help: "Set the SUN OFDM scrambler setting, 2 bits wide (0-3)"
    argument:
    - type: uint8
      help: "scrambler value"
  condition:
  - "cli"
  - "device_generic_family_efr32xg25"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_sun_ofdm_rate
    handler: cli_get_sun_ofdm_rate
    help: "Get the SUN OFDM rate setting"
  condition:
  - "cli"
  - "device_generic_family_efr32xg25"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_sun_ofdm_rate
    handler: cli_set_sun_ofdm_rate
    help: "Set the SUN OFDM rate setting"
    argument:
    - type: uint8
      help: "rate value 0-6"
  condition:
  - "cli"
  - "device_generic_family_efr32xg25"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_sun_oqpsk_spreading_mode
    handler: cli_get_sun_oqpsk_spreading_mode
    help: "Get the SUN OQPSK spreading mode setting"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_sun_oqpsk_spreading_mode
    handler: cli_set_sun_oqpsk_spreading_mode
    help: "Set the SUN OQPSK spreading mode setting"
    argument:
    - type: uint8
      help: "ON/OFF"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_sun_oqpsk_rate_mode
    handler: cli_get_sun_oqpsk_rate_mode
    help: "Get the SUN OQPSK rate mode setting"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_sun_oqpsk_rate_mode
    handler: cli_set_sun_oqpsk_rate_mode
    help: "Set the SUN OQPSK rate mode setting"
    argument:
    - type: uint8
      help: "value to set data rates and robustness levels (2 bit wide: 0-3)"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_sidewalk_fcs_type
    handler: cli_get_sidewalk_fcs_type
    help: "Get the Sidewalk FSK FCS type (0 = 4-byte, 1 = 2-byte)"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_sidewalk_fcs_type
    handler: cli_set_sidewalk_fcs_type
    help: "Set the Sidewalk FSK FCS type (0 = 4-byte, 1 = 2-byte)"
    argument:
    - type: uint8
      help: "0 = 4-byte FCS, 1 = 2-byte FCS"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_sidewalk_whitening
    handler: cli_get_sidewalk_whitening
    help: "Get the Sidewalk FSK whitening setting"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_sidewalk_whitening
    handler: cli_set_sidewalk_whitening
    help: "Set the Sidewalk FSK whitening setting"
    argument:
    - type: uint8
      help: "ON/OFF"
  condition:
  - "cli"
  # Deprecated CLI commands
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_wisun_fsk_fcs
    handler: cli_get_wisun_fsk_fcs
    help: "Deprecated: use get_sun_fsk_fcs"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_wisun_fsk_fcs
    handler: cli_set_wisun_fsk_fcs
    help: "Deprecated: use set_sun_fsk_fcs"
    argument:
    - type: uint8
      help: "0 = 4-byte FCS, 1 = 2-byte FCS"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_wisun_fsk_whitening
    handler: cli_get_wisun_fsk_whitening
    help: "Deprecated: use get_sun_fsk_whitening"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_wisun_fsk_whitening
    handler: cli_set_wisun_fsk_whitening
    help: "Deprecated: use set_sun_fsk_whitening"
    argument:
    - type: uint8
      help: "ON/OFF"
  condition:
  - "cli"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_wisun_ofdm_scrambler
    handler: cli_get_wisun_ofdm_scrambler
    help: "Deprecated: use get_sun_ofdm_scrambler"
  condition:
  - "cli"
  - "device_generic_family_efr32xg25"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_wisun_ofdm_scrambler
    handler: cli_set_wisun_ofdm_scrambler
    help: "Deprecated: use set_sun_ofdm_scrambler"
    argument:
    - type: uint8
      help: "scrambler value"
  condition:
  - "cli"
  - "device_generic_family_efr32xg25"
- name: cli_command
  value:
    group: "packet_assistant"
    name: get_wisun_ofdm_rate
    handler: cli_get_wisun_ofdm_rate
    help: "Deprecated: use get_sun_ofdm_rate"
  condition:
  - "cli"
  - "device_generic_family_efr32xg25"
- name: cli_command
  value:
    group: "packet_assistant"
    name: set_wisun_ofdm_rate
    handler: cli_set_wisun_ofdm_rate
    help: "Deprecated: use set_sun_ofdm_rate"
    argument:
    - type: uint8
      help: "rate value 0-6"
  condition:
  - "cli"
  - "device_generic_family_efr32xg25"
- name: event_handler
  value:
    event: internal_app_init
    include: "sl_rail_sdk_packet_assistant.h"
    handler: "sl_packet_assistant_validation_check"
  priority: 1000
- name: event_handler
  value:
    event: internal_app_init
    include: "sl_rail_sdk_packet_assistant.h"
    handler: "sl_packet_assistant_init"
  priority: 2000
