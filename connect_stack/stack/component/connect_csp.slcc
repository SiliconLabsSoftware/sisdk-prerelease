id: connect_csp
label: Connect Serialization Protocol component
package: "connect_stack"
description: Provides source files for components requiring CSP
category: Connect
quality: production
ui_hints:
  visibility: never
provides:
- name: connect_csp
requires:
- name: connect_stack_common
include:
- path: stack/csp
  file_list:
  - path: csp-command-utils.h
  - path: csp-format.h
  - path: csp-api-enum-gen.h
- path: "stack/ncp"
  file_list:
  - path: "ncp-security.h"
source:
- path: "stack/csp/csp-format.c"
- path: "stack/csp/csp-command-app.c"
  condition:
  - "connect_cmsis_stack_ipc"
- path: "stack/csp/csp-command-vncp.c"
- path: "stack/csp/csp-command-callbacks-app.c"
  unless: [connect_ncp]
- path: "stack/csp/csp-command-callbacks-vncp.c"
- path: "stack/ncp/ncp-stubs.c"
  unless: [connect_ncp]

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
