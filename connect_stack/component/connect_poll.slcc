id: "connect_poll"
label: "Poll"
package: "connect_stack"
description: "Implements polling for end devices."
category: "Connect"
quality: "production"
ui_hints:
  visibility: basic
documentation:
  docset: connect-stack
  document: connect-stack-api/poll
provides:
- name: "connect_poll"
requires:
- name: "connect_stack_common"
include:
- path: "poll"
  file_list:
  - path: "poll.h"
source:
- path: "poll/poll.c"
config_file:
- path: "poll/config/poll-config.h"
template_contribution:
- name: stack_callback
  value:
    callback_type: "stack_status"
    function_name: "emberAfPluginPollStackStatusCallback"
- name: event_system
  value:
    event_control: "emberAfPluginPollEventControl"
    event_handler: "emberAfPluginPollEventHandler"
- name: component_catalog
  value: connect_poll

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
