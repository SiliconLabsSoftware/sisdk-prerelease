id: "connect_stack_counters"
label: "Stack Counters"
package: "connect_stack"
description: "This component provides stack packet counters functionality. If this component is enabled, the stack shall keep track of successful and failed transmissions as well as successful received packets and dropped incoming packets."
category: "Connect"
quality: "production"
ui_hints:
  visibility: basic
documentation:
  docset: connect-stack
  document: customizing-applications-with-connect-v3x/02-components
provides:
- name: "connect_stack_counters"
requires:
- name: "connect_stack_common"
- name: "connect_stack_counters_implementation"
recommends:
- id: "connect_stack_counters_source"
  vendor: silabs
template_contribution:
- name: component_catalog
  value: connect_stack_counters

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
