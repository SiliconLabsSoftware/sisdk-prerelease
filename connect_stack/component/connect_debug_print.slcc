id: "connect_debug_print"
label: "Debug Print"
package: "connect_stack"
description: "Provides APIs for adding serial debugging capability."
category: "Connect"
quality: "production"
ui_hints:
  visibility: basic
documentation:
  docset: connect-stack
  document: customizing-applications-with-connect-v3x/02-components
provides:
- name: "connect_debug_print"
requires:
- name: "printf"
- name: "device_supports_connect"
include:
- path: "debug-print"
  file_list:
  - path: "debug_print.h"
config_file:
- path: "debug-print/config/debug_print_config.h"
template_contribution:
- name: component_catalog
  value: connect_debug_print

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
