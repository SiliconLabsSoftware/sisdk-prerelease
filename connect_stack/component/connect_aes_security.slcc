id: "connect_aes_security"
label: "AES Security"
package: "connect_stack"
description: "Provides encryption and authentication functionality based on the AES encryption algorithm (hardware acceleration)."
category: "Connect"
quality: "production"
ui_hints:
  visibility: basic
documentation:
  docset: connect-stack
  document: customizing-applications-with-connect-v3x/02-components
provides:
- name: "connect_aes_security"
requires:
- name: "connect_stack_common"
- name: "connect_aes_security_implementation"
- name: "mbedtls_ccm"
- name: "psa_crypto"
- name: "ccm_implementation"
recommends:
- id: "connect_psa_security_library"
  vendor: silabs
template_contribution:
- name: component_catalog
  value: connect_aes_security

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
