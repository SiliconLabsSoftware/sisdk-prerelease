id: uart_core
package: platform_core
label: UART Driver
description: >
  Internal UART driver component meant for users that do not wish to have their UART instance
  declared statically. Users may use this component directly without defining a UART driver instance
  in their project, but are responsible for allocating the instance and defining the peripheral  IRQ handlers themselves.
category: Platform|Driver|UART
quality: production
ui_hints:
  visibility: never
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/uart/
include:
- path: inc
  file_list:
  - path: sl_uart.h
  - path: sli_uart.h
source:
- path: src/sl_uart.c
- path: src/sli_uart_async.h
provides:
- name: uart_core
requires:
- name: clock_manager_runtime
- name: device_peripheral
- name: device_uart
- name: hal_gpio
- name: interrupt_manager
- name: status
- name: sl_assert
- name: sl_core
- name: uart_lld
template_contribution:
- name: component_catalog
  value: uart
