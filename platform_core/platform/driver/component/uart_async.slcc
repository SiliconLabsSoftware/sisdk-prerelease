id: uart_async
package: platform_core
label: UART Async Driver
description: >
  Platform UART async driver for USART, EUART, and EUSART peripherals. Declares the
  underlying peripheral signals (TX, RX, CTS, RTS) and configures the DMA channels  for transmission and reception. An instance declared via this component will only
  support the asynchronous transfer APIs. Generated instances are initialized
  by sl_uart_init_instances() (automatically when sl_main is present). Add the  uart_eusart or uart_usart component to support the selected peripheral type.
category: Platform|Driver|UART
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/uart/
instantiable:
  prefix: inst
requires:
- name: uart_async_core
- name: uart_core
config_file:
- path: config/sl_uart_{{instance}}_config.h
  file_id: uart_async_config
template_file:
- path: init/sl_uart_instances.c.jinja
- path: init/sl_uart_instances.h.jinja
template_contribution:
- name: uart_async_instances
  value: '{{instance}}'
- name: event_handler
  value:
    event: driver_init
    include: sl_uart_instances.h
    handler: sl_uart_instances_init
documentation:
  docset: gecko-platform
  document: platform-driver/uartdrv
