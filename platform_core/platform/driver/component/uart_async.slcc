id: uart_async
package: platform_core
label: UART Driver Async Support
description: >
  Compiles in UART driver async (DMA) support. Required for instances that set
  SL_UART_<PERIPH>_<INSTANCE>_ASYNC_ENABLE to 1, and for users that allocate their UART
  instances themselves and pass a non-NULL sl_uart_async_config_t to
  sl_uart_init().
category: Platform|Driver|UART
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/uart/
source:
- path: src/sl_uart_async.c
- path: src/sli_uart_async.h
- path: src/sli_uart_async_types.h
- path: src/sli_uart_transfer_pool.c
- path: src/sli_uart_transfer_pool.h
provides:
- name: uart_async
requires:
- name: dma_channel
- name: dma_manager
- name: memory_manager
- name: sleeptimer
- name: uart_core
template_contribution:
- name: component_catalog
  value: uart_async
documentation:
  docset: gecko-platform
  document: platform-driver/uartdrv
