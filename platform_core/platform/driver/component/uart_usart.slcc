id: uart_usart
package: platform_core
label: UART USART Backend
description: >
  USART low-level backend for the UART driver.
category: Platform|Driver|UART
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/uart/src/
source:
- path: sli_uart_usart.c
- path: sli_uart_usart.h
provides:
- name: uart_usart
- name: uart_lld
  allow_multiple: true
requires:
- name: device_has_usart
- name: hal_usart
template_contribution:
- name: component_catalog
  value: uart_usart
