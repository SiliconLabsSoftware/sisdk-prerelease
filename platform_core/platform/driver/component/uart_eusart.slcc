id: uart_eusart
package: platform_core
label: UART EUSART
description: >
  Platform UART driver instance on an EUART or EUSART peripheral. Declares the
  underlying peripheral signals (TX, RX, CTS, RTS) and interrupt handlers in
  per-instance configuration so users can configure pin routing through the
  pin tool. DMA (async) transfers may be enabled per instance through the
  instance configuration, which requires the uart_async component. Generated
  instances are initialized by sl_uart_instances_init() (automatically when
  sl_main is present).
category: Platform|Driver|UART
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/uart/
instantiable:
  prefix: inst
config_file:
- path: config/sl_uart_eusart_{{instance}}_config.h
  file_id: uart_eusart_config
provides:
- name: uart_eusart
  allow_multiple: true
requires:
- name: uart_eusart_core
template_file:
- path: init/sl_uart_instances.c.jinja
- path: init/sl_uart_instances.h.jinja
template_contribution:
- name: uart_eusart_instances
  value: '{{instance}}'
- name: event_handler
  value:
    event: driver_init
    include: sl_uart_instances.h
    handler: sl_uart_instances_init
documentation:
  docset: gecko-platform
  document: platform-driver/uartdrv
