id: uart_eusart
package: platform_core
label: UART EUSART Backend
description: >
  EUSART low-level backend for the UART driver.
category: Platform|Driver|UART
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/uart/src/
source:
- path: sli_uart_eusart.c
- path: sli_uart_eusart.h
provides:
- name: uart_eusart
- name: uart_lld
  allow_multiple: true
requires:
- name: device_has_euart
- name: hal_eusart
template_contribution:
- name: component_catalog
  value: uart_eusart
