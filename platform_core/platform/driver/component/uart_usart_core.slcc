id: uart_usart_core
package: platform_core
label: UART USART Backend
description: >
  USART low-level backend for the UART driver. Meant for users that do not
  declare UART instances statically but still need USART support.
category: Platform|Driver|UART
quality: production
ui_hints:
  visibility: never
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/uart/
source:
- path: src/sli_uart_usart.c
- path: src/sli_uart_usart.h
provides:
- name: uart_usart_core
requires:
- name: hal_usart
- name: uart_core
template_contribution:
- name: component_catalog
  value: uart_usart
documentation:
  docset: gecko-platform
  document: platform-driver/uartdrv
