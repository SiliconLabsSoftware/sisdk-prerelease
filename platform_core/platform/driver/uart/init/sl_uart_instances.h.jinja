{# Build a single list of complete instance names (peripheral_type + instance). #}
{% set ns = namespace(instances=[]) %}
{% for instance in uart_eusart_instances | default([], true) | list %}
  {% set ns.instances = ns.instances + ['eusart_' ~ instance] %}
{% endfor %}
{% for instance in uart_usart_instances | default([], true) | list %}
  {% set ns.instances = ns.instances + ['usart_' ~ instance] %}
{% endfor %}
{% set uart_instances_it = ns.instances %}
#ifndef SL_UART_INSTANCES_H
#define SL_UART_INSTANCES_H

#ifdef __cplusplus
extern "C" {
#endif

#include "sl_uart.h"
#include "sl_common.h"
{% for instance in uart_instances_it %}
#include "sl_uart_{{ instance }}_config.h"
{% endfor %}

{% for instance in uart_instances_it %}
extern sl_uart_handle_t sl_uart_{{ instance }}_handle;
#if defined(SL_CATALOG_UART_ASYNC_PRESENT) \
  && defined(SL_UART_{{ instance | upper }}_ASYNC_ENABLE) \
  && (SL_UART_{{ instance | upper }}_ASYNC_ENABLE == 1)
extern const sl_uart_async_config_t sl_uart_{{ instance }}_async_config;
#endif
extern const sl_uart_pin_config_t sl_uart_{{ instance }}_pin_config;
extern const sl_uart_config_t sl_uart_{{ instance }}_line_config;
{% endfor %}

/***************************************************************************//**
 * Initializes all UART driver instances declared via SLC.
 *
 * Calls @ref sl_uart_init and @ref sl_uart_configure_line for every statically
 * declared UART instance.
 *
 * @note When sl_main is present, this function is invoked automatically during
 *       driver initialization.
 ******************************************************************************/
void sl_uart_instances_init(void);

#ifdef __cplusplus
}
#endif

#endif // SL_UART_INSTANCES_H
