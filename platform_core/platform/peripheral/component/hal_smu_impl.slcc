# This HAL applies to series 2 and 3 devices.
id: hal_smu_impl
label: SMU_IMPL
package: platform_core
description: >
  Security Management Unit (SMU) Peripheral API implementation
category: Platform|Peripheral|HAL
ui_hints:
  visibility: never
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: hal_smu_impl
  condition: [device_series_2]
- name: hal_smu_impl
  condition: [device_generic_family_sixx301]
- name: hal_smu_impl
  condition: [device_generic_family_sixx302]
requires:
- name: device_has_smu
- name: hal_smu
root_path: platform_core/platform/peripheral
