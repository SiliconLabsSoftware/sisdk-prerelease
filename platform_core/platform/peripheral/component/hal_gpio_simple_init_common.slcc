id: hal_gpio_simple_init_common
label: GPIO Init Core
package: platform_core
description: >
  Provides a simple initialization routine for GPIO.
  This component includes only the core of the GPIO initialization routine.
  To configure an initialization routine for a GPIO, the GPIO Init component should be included in the project.

category: Platform|Peripheral|HAL|Init
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/peripheral/init/gpio_simple
template_file:
- path: sl_hal_gpio_simple_init.c.jinja
include:
- path: ''
  file_list:
  - path: sl_hal_gpio_simple_init.h
provides:
- name: hal_gpio_simple_init_common
requires:
- name: hal_gpio_simple_init
- name: device
- name: hal_gpio
- name: clock_manager_runtime
template_contribution:
- name: event_handler
  value:
    event: driver_init
    include: sl_hal_gpio_simple_init.h
    handler: sl_hal_gpio_simple_init
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/gpio
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/gpio
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/gpio
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/gpio
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/gpio
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/gpio
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/gpio
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/gpio
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/gpio
    condition: [device_sdid_240]
  - page: platform-peripheral-sixg301/gpio
    condition: [device_generic_family_sixx301]
