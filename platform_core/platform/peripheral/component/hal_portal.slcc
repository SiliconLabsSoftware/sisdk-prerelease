id: hal_portal
label: portal
package: platform_core
description: >
  PORTAL peripheral API
category: Platform|Peripheral|HAL
quality: evaluation
metadata:
  sbom:
    license: Zlib
include:
- path: inc
  file_list:
  - path: sli_hal_portal.h
provides:
- name: hal_portal
  condition: [device_has_portal]
requires:
- name: device
- name: device_portal
- name: cmsis_core
- name: hal_common
- name: enum
documentation:
  docset: gecko-platform
  document: platform-common/common
root_path: platform_core/platform/peripheral
