id: power_manager_state_retention
label: 'Power Manager: State Retention'
package: platform_core
description: >
  Shared state retention framework for retention-capable power manager
  implementations. Owns the peripheral state save/restore machinery,
  while the device-specific retention tables and save/restore routines
  remain in the periph retention components.
category: Services|Power Manager
quality: evaluation
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
root_path: platform_core/platform/service/power_manager/src/retention
include:
- path: .
  file_list:
  - path: sli_power_manager_periph_state.h
source:
- path: sli_power_manager_periph_state.c
provides:
- name: power_manager_state_retention
requires:
- name: power_manager_core_retention
- name: power_manager_periph_retention
