id: log_backend_iostream_formatted
label: Log Backend I/O Stream – Formatted Output
package: platform_core
description: >
  Human-readable text output for the I/O Stream log backend. Each log line is
  formatted as [LEVEL|TYPE|TIMESTAMP] followed by the payload and terminated
  with CRLF. String logs expand printf-style specifiers (%d, %x, %s, %p);
  event logs emit hex-encoded event_id, arguments, core_id, and version.
  Requires the log_backend_iostream component for transport.
category: Services|Log
quality: evaluation
metadata:
  sbom:
    license: Zlib
provides:
- name: log_backend
- name: log_backend_iostream_impl
requires:
- name: iostream_recommended_console
- name: log
- name: log_platform_core
- name: log_backend_iostream
root_path: platform_core/platform/service/sl_log
config_file:
- path: config/sl_log_proprietary_config.h
  unless: [iostream_rtt]
- path: config/sl_log_common_config.h
- path: config/sl_log_platform_core_config.h
  condition: [device_has_timer]
source:
- path: backend/iostream/src/sl_log_backend_iostream_formatted.c
template_contribution:
- name: log_section_enable
  value: 1
- name: component_catalog
  value: log_default_ring_buffer
- name: component_catalog
  value: log_formatted_output
