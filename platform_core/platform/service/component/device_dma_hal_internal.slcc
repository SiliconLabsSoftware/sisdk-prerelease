id: device_dma_hal_internal
label: Device Manager DMA HAL
package: platform_core
description: >
    This component represent the DMA HAL layer of the Device Manager.
category: Services|Device Manager
quality: production
metadata:
    sbom:
        license: Zlib
ui_hints:
    visibility: never
provides:
  - name: device_dma_hal_internal
requires:
  - name: device_clock
root_path: platform_core/platform/service/device_manager
source:
  - path: dma/sl_device_dma_s3_internal.c
    condition: [device_series_3]
