id: log_backend_iostream
label: logger module backend iostream
package: platform_core
description: >
  This component provides the backend iostream interface for Series 2
  and Series 3 devices
category: Services|Log
quality: evaluation
metadata:
  sbom:
    license: Zlib
provides:
- name: log_backend
- name: log_backend_iostream
requires:
- name: iostream
- name: log
- name: log_platform_core
root_path: platform_core/platform/service/sl_log
config_file:
- path: config/sl_log_proprietary_config.h
- path: config/sl_log_common_config.h
- path: config/sl_log_platform_core_config.h
  condition: [device_has_timer]
source:
- path: backend/iostream/src/sl_log_backend_iostream.c
template_contribution:
- name: component_catalog
  value: log_backend_proprietary
