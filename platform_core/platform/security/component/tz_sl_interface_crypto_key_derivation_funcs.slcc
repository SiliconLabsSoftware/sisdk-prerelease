id: tz_sl_interface_crypto_key_derivation_funcs
package: platform_core
description: >-
  This component provides a TrustZone secure library interface crypto key derivation functions
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tz_sl_interface_crypto_key_derivation_funcs
requires:
- name: trustzone_nonsecure
template_contribution:
- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_setup
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_get_capacity
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_set_capacity
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_input_bytes
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_input_integer
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_input_key
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_key_agreement
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_output_bytes
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_output_key
    key_checks:
    - source: key_attributes
      invec: 1

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_output_key_custom
    key_checks:
    - source: key_attributes
      invec: 1

- name: tfm_interface_func
  value:
    function: tfm_crypto_key_derivation_abort
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_sl_psa_key_derivation_single_shot
    key_checks:
    - source: packed_key_id
    - source: key_attributes
      invec: 4

- name: tfm_interface_func
  value:
    function: tfm_crypto_raw_key_agreement
    key_checks:
    - source: packed_key_id


documentation:
  url: https://www.silabs.com/documents/public/application-notes/an1374-trustzone.pdf
metadata:
  sbom:
    license: Zlib
root_path: platform_core
