id: mbedtls_x509
package: platform_core
label: X.509
description: >-
  This component provides full support for handling X.509 standard-
  based certificates in Mbed TLS.
  This component is DEPRECATED and is replaced by new set of components
  including mbedtls_x509_use, mbedtls_x509_create, mbedtls_x509_crl_parse, mbedtls_x509_crt_parse,
  mbedtls_x509_crt_write, mbedtls_x509_csr_parse, mbedtls_x509_csr_write, mbedtls_pem_write and mbedtls_pem_parse.
category: Platform|Security|Mbed TLS|Upper Layer
quality: deprecated
provides:
- name: mbedtls_x509
requires:
- name: mbedtls_pem_write
- name: mbedtls_pem_parse
- name: mbedtls_x509_use
- name: mbedtls_x509_create
- name: mbedtls_x509_crl_parse
- name: mbedtls_x509_crt_parse
- name: mbedtls_x509_crt_write
- name: mbedtls_x509_csr_parse
- name: mbedtls_x509_csr_write
documentation:
  # X.509 module — reading, writing and verification of certificates
  url: https://docs.silabs.com/gecko-platform/4.4.7/platform-security/x509-module
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
