id: psa_driver_common
package: platform_core
label: PSA Driver Common Source Code
description: >-
  This component includes the Silicon Labs PSA common drivers source code files.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never
conflicts:
- name: trustzone_nonsecure

provides:
- name: psa_driver_common

requires:
- name: psa_crypto_common
  # sli_psa_zeroize() is now a thin wrapper around sli_psec_zeroize() from
  # sli_psec_common.h. Pull the canonical helper into our include path.
- name: sli_psec_common

source:
  # Common drivers
- path: sl_psa_driver/src/sli_psa_driver_init.c
- path: sl_psa_driver/src/sli_psa_driver_common.c
- path: sl_psa_driver/src/sli_se_version_dependencies.c

include:
- path: sl_psa_driver/inc
  file_list:
  - path: sli_psa_driver_common.h
  - path: sli_se_version_dependencies.h

documentation:
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-psa-crypto/psa-crypto-plugins
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/security/sl_component
