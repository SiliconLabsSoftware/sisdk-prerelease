id: tz_sl_interface_crypto_aead_funcs
package: platform_core
description: >-
  This component provides a TrustZone secure library interface crypto aead functions
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tz_sl_interface_crypto_aead_funcs
requires:
- name: trustzone_nonsecure
template_contribution:
- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_encrypt
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_decrypt
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_encrypt_setup
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_decrypt_setup
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_generate_nonce
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_set_nonce
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_set_lengths
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_update_ad
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_update
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_finish
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_verify
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_aead_abort
    key_checks: []

documentation:
  url: https://www.silabs.com/documents/public/application-notes/an1374-trustzone.pdf
metadata:
  sbom:
    license: Zlib
root_path: platform_core
