id: psa_driver_dispatch
package: platform_core
label: PSA Driver dispatch layer for Silicon Labs PSA drivers
description: >-
  This component is the Silicon Labs implementation of the TF-PSA-Crypto
  dispatch files (wrappers and crypto_driver_contexts_*.h). It is not
  included on TrustZone Non-Secure, so those headers stay off the
  Non-Secure include path. After upstream TF-PSA-Crypto#809, do not add
  tf-psa-crypto/dispatch on Non-Secure either.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never
provides:
- name: psa_driver_dispatch

include:
- path: include
  unless: [trustzone_nonsecure]
  file_list:
  - path: psa/crypto_driver_contexts_composites.h
    unless: [trustzone_nonsecure]
  - path: psa/crypto_driver_contexts_key_derivation.h
    unless: [trustzone_nonsecure]
  - path: psa/crypto_driver_contexts_primitives.h
    unless: [trustzone_nonsecure]
  # Dispatch root so TF-M Secure `#include <include/psa/...>` redirects resolve.
- path: .
  unless: [trustzone_nonsecure]
  file_list:
  - path: psa_crypto_driver_wrappers.h
    unless: [trustzone_nonsecure]

source:
  # PSA driver dispatch wrappers
- path: psa_crypto_driver_wrappers_no_static.c
  unless: [trustzone_nonsecure]

requires:
- name: psa_driver

metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/security/sl_component/sl_psa_driver/dispatch
