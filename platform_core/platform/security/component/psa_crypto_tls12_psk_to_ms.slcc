id: psa_crypto_tls12_psk_to_ms
package: platform_core
label: TLS 1.2 PSK to Master Secret
description: >-
  This component provides support for the functions specified in TLS 1.2
  for derivation of master secrets from pre-shared keys (PSKs) in PSA Crypto.
  This PSA Crypto functionality uses a Mbed TLS backend.
category: Platform|Security|PSA Crypto|Key Derivation
quality: production
provides:
- name: psa_crypto_tls12_psk_to_ms
requires:
- name: psa_crypto
- name: psa_crypto_hmac
template_contribution:
- name: psa_crypto_config
  value: PSA_WANT_ALG_TLS12_PSK_TO_MS 1
documentation:
  # No dedicated TLS 1.2 PSK to MS page; PSA Crypto hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-psa-crypto/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
