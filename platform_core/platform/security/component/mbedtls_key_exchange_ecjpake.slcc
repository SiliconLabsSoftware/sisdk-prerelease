id: mbedtls_key_exchange_ecjpake
package: platform_core
label: EC J-PAKE Key Exchange
description: >-
  This component enables the EC J-PAKE based ciphersuite modes in SSL / TLS.
  Pair with psa_crypto_jpake for the PSA PAKE implementation (SE driver on HSE,
  or builtin via mbedtls_jpake elsewhere).
category: Platform|Security|Mbed TLS|Upper Layer
quality: production

provides:
- name: mbedtls_key_exchange_ecjpake
- name: mbedtls_key_exchange
  allow_multiple: true

requires:
- name: mbedtls_ssl_tls
- name: psa_crypto_jpake

template_contribution:
- name: mbedtls_config
  value: MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED
documentation:
  # No dedicated EC J-PAKE TLS page; PSA Crypto hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-psa-crypto/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
