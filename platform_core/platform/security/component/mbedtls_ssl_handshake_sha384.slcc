id: mbedtls_ssl_handshake_sha384
package: platform_core
label: TLS Handshake SHA-384
description: >-
  This component selects PSA SHA-384 for the TLS handshake hash.
  MBEDTLS_SSL_TLS_C and MBEDTLS_SSL_PROTO_TLS1_2 require
  PSA_WANT_ALG_SHA_256 or PSA_WANT_ALG_SHA_384.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production

# This component is part of the Mbed TLS upper layers (SSL, X509, etc).
# In the TZ Secure Key Library use case, the Mbed TLS upper layers lives
# in the TZ NonSecure application, and is not not allowed to be included
# in the secure library.
conflicts:
- name: tz_secure_key_library_s

provides:
- name: mbedtls_ssl_handshake_sha384
- name: mbedtls_ssl_handshake_hash
  allow_multiple: true

requires:
- name: psa_crypto_sha384

documentation:
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
