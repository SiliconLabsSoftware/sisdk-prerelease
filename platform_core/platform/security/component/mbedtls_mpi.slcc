id: mbedtls_mpi
package: platform_core
label: Multi-Precision Integers
description: >-
  This component enables the Mbed TLS multi-precision integer (MPI) library.
category: Platform|Security|Mbed TLS|Utilities
quality: production
provides:
- name: mbedtls_mpi
requires:
- name: mbedtls_core
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_BIGNUM_C
  # Default to support 256 bit MPI numbers. This can be increased by
  # other components when needed.
- name: mbedtls_mpi_max
  value: 32
documentation:
  # No dedicated Multi-Precision Integers page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
