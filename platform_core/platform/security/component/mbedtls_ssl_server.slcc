id: mbedtls_ssl_server
package: platform_core
label: SSL Server
description: >-
  This component enables the SSL/TLS server support in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_ssl_server
requires:
- name: mbedtls_ssl_tls
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SSL_SRV_C
documentation:
  # No dedicated SSL Server page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
