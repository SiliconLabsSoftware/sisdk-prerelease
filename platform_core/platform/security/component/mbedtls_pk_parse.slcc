id: mbedtls_pk_parse
package: platform_core
label: Public-Key Parse API
description: >-
  This component provides support for the Public Key (PK) Parse API in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_pk_parse
requires:
- name: mbedtls_asn1_parse
- name: mbedtls_pk
- name: mbedtls_oid
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_PK_PARSE_C
documentation:
  # No dedicated Public-Key Parse API page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
