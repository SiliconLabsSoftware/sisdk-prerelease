id: psa_crypto_common
package: platform_core
label: PSA Crypto Common
description: >-
  This component provides the PSA Crypto common functionality including
  configuration and source implementation.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never

provides:
- name: psa_crypto_common

requires:
- name: psa_crypto_config
- name: psa_crypto_common_source
  condition: [trustzone_unaware]
- name: psa_crypto_common_source
  condition: [trustzone_secure]
- name: mbedtls_iar_workarounds
  condition: [toolchain_iar]
- name: tf_psa_crypto_mbedtls_source
- name: tf_psa_crypto_api

- name: sli_psa_driver_contexts
  condition: [device_series_2]
- name: sli_psa_driver_contexts
  condition: [device_series_3]
- name: sli_psa_driver_contexts
  condition: [device_si91x]
- name: sli_psa_driver_contexts
  condition: [device_host]

include:
- path: sl_mbedtls_support/inc
  file_list:
  - path: sl_psa_values.h
  - path: sli_psa_crypto.h
- path: sl_psa_driver/inc
  file_list:
  - path: sli_psa_driver_features.h

template_contribution:
- name: psa_crypto_config
  value: MBEDTLS_PSA_CRYPTO_CLIENT

documentation:
  url: https://mbed-tls.readthedocs.io/projects/api/en/development/api/file/crypto__config_8h/#c.MBEDTLS_PSA_CRYPTO_CLIENT
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/security/sl_component
