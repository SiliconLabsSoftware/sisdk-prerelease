id: mbedtls_pk
package: platform_core
label: Public-Key Core Abstraction Layer
description: >-
  This component provides support for the Public Key (PK) abstraction layer in
  Mbed TLS. This layer provides indirect support for public-key
  encryption/decryption as well signature generation/verification.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_pk
requires:
  # MBEDTLS_PK_C requires MBEDTLS_PSA_CRYPTO_CLIENT.
- name: psa_crypto_common
  # MBEDTLS_PK_C requires PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY or
  # PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY.
- name: psa_public_key

- name: mbedtls_mpi
  condition: [psa_crypto_ecdsa]
- name: mbedtls_asn1_parse
  condition: [psa_crypto_ecdsa]
- name: mbedtls_asn1_write
  condition: [psa_crypto_ecdsa]

  # Always needed once an ECDSA backend is selected.
- name: psa_crypto_hash
  condition: [psa_crypto_ecdsa]

  # We need either RSA or ECDSA to be enabled.
- name: mbedtls_pk_backend

# ECDSA is the most likely backend for PK signatures. ECC supplies the
# PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY prerequisite of MBEDTLS_PK_C.
recommends:
- id: psa_crypto_ecdsa
  vendor: silabs
- id: psa_crypto_ecc
  vendor: silabs
template_contribution:
- name: psa_crypto_config
  value: MBEDTLS_PK_C
documentation:
  # No dedicated Public-Key Core Abstraction Layer page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
