id: mbedtls_jpake
package: platform_core
label: J-PAKE over Elliptic Curves
description: >-
  This component provides support for Elliptic Curve (EC) J-PAKE using Mbed TLS.
  This component is DEPRECATED and will be removed in a future version of this product.
  This component will be replaced by psa_crypto_jpake.
category: Platform|Security|Mbed TLS|Key Exchange
quality: production
ui_hints:
  visibility: never
provides:
- name: mbedtls_jpake
requires:
- name: mbedtls_ecc_secp256r1
- name: mbedtls_sha256
- name: psa_crypto_jpake
  condition: [psa_crypto]
  # TLS EC J-PAKE ciphersuites live in mbedtls_key_exchange_ecjpake.
template_contribution:
- name: psa_crypto_builtin_config
  value: MBEDTLS_ECJPAKE_C
documentation:
  url: https://docs.silabs.com/gecko-platform/4.4.7/platform-security/sl-crypto-jpake
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
