id: tz_secure_config
package: platform_core
description: >-
  This component includes the TZ secure configuration file.
category: Platform|Security|TrustZone
ui_hints:
  visibility: never
quality: production
provides:
- name: tz_secure_config

requires:
- name: trustzone_secure

include:
- path: config/secure
  file_list:
  - path: sl_trustzone_secure_config.h

template_contribution:
- name: component_catalog
  value: trustzone_secure_config

documentation:
  url: https://www.silabs.com/documents/public/application-notes/an1374-trustzone.pdf
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/security/sl_component/sl_trustzone
