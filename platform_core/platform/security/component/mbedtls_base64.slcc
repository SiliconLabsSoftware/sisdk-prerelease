id: mbedtls_base64
package: platform_core
label: Base64 Encoding and Decoding
description: >-
  This component provides support for Base64 encoding and decoding using Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_base64
requires:
- name: mbedtls_core
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_BASE64_C
documentation:
  # No dedicated Base64 page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
