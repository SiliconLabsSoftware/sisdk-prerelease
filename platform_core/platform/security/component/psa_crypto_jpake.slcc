id: psa_crypto_jpake
package: platform_core
label: J-PAKE over Elliptic Curves
description: >-
  This component provides support for Elliptic Curve (EC) J-PAKE in PSA Crypto.
  On devices with an SE mailbox, the transparent SE PSA driver is used.
  Elsewhere, the built-in Mbed TLS PAKE (via mbedtls_jpake) is used as a
  fallback.
category: Platform|Security|PSA Crypto|Key Exchange
quality: production

provides:
- name: psa_crypto_jpake

requires:
- name: psa_crypto
- name: psa_crypto_ecc_secp256r1
- name: psa_crypto_sha256

  # Builtin / classic mbedtls_jpake is only needed where there is no SE PSA
  # PAKE driver. On HSE (device_has_semailbox) the transparent SE driver
  # provides EC J-PAKE; MBEDTLS_ECJPAKE_ALT / se_jpake.c are being removed.
- name: mbedtls_jpake
  unless: [device_has_semailbox]

template_contribution:
- name: psa_crypto_config
  value: PSA_WANT_ALG_JPAKE 1
- name: psa_crypto_builtin_config
  value: "MBEDTLS_PSA_BUILTIN_PAKE 1"
  condition: [mbedtls_jpake]
- name: psa_crypto_builtin_config
  value: "MBEDTLS_PSA_BUILTIN_ALG_JPAKE 1"
  condition: [mbedtls_jpake]

  # Assume that if EC J-PAKE and (D)TLS are included together, EC J-PAKE is used
  # in (D)TLS (driver or builtin). On HSE, TLS PMS comes from the transparent
  # key-derivation driver under PSA_ALG_TLS12_ECJPAKE_TO_PMS.
  # psa_pake_derive_secret() remains for TF-M / direct callers when HSE PAKE is
  # built (declared in sl_psa_crypto.h, implemented in sl_psa_crypto.c).
- name: psa_crypto_builtin_config
  value: "PSA_WANT_ALG_TLS12_ECJPAKE_TO_PMS 1"
  condition: [mbedtls_ssl_proto_dtls]
- name: psa_crypto_builtin_config
  value: "PSA_WANT_ALG_TLS12_ECJPAKE_TO_PMS 1"
  condition: [mbedtls_ssl_tls]
- name: psa_crypto_builtin_config
  value: "PSA_WANT_ALG_TLS12_ECJPAKE_TO_PMS 1"
  condition: [mbedtls_key_exchange_ecjpake]

documentation:
  # No dedicated EC J-PAKE PSA page; PSA Crypto hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-psa-crypto/

metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
