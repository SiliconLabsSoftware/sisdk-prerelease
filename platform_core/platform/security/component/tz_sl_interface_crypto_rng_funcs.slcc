id: tz_sl_interface_crypto_rng_funcs
package: platform_core
description: >-
  This component provides a TrustZone secure library interface crypto rng functions
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tz_sl_interface_crypto_rng_funcs
requires:
- name: trustzone_nonsecure
template_contribution:
- name: tfm_interface_func
  value:
    function: tfm_crypto_generate_random
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_generate_key
    key_checks:
    - source: key_attributes
      invec: 1

- name: tfm_interface_func
  value:
    function: tfm_crypto_generate_key_custom
    key_checks:
    - source: key_attributes
      invec: 1

documentation:
  url: https://www.silabs.com/documents/public/application-notes/an1374-trustzone.pdf
metadata:
  sbom:
    license: Zlib
root_path: platform_core
