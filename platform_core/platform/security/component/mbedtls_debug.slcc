id: mbedtls_debug
package: platform_core
label: Debug Helpers
description: >
  This component provides support for the debug APIs in Mbed TLS, provided
  by the debug.h file.
category: Platform|Security|Mbed TLS|Utilities
quality: production
provides:
- name: mbedtls_debug
requires:
- name: mbedtls_source
- name: mbedtls_hmac
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_DEBUG_C
documentation:
  # No dedicated Debug Helpers page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
