id: mbedtls_hash
package: platform_core
label: Hashing and HMACs
description: >-
  This component provides support for the generic hashing APIs in Mbed TLS. This
  component also enables usage of hash-based message authentication codes (HMACs).
category: Platform|Security|Mbed TLS|Hashing
quality: production
# Does not need to be shown in UI, needs child-components (hash funcs) to work.
ui_hints:
  visibility: never
provides:
- name: mbedtls_hash
requires:
- name: psa_hash_function
recommends:
- id: psa_crypto_sha256
  vendor: silabs
template_contribution:
- name: psa_crypto_config
  value: MBEDTLS_MD_C
documentation:
  url: https://mbed-tls.readthedocs.io/projects/api/en/development/api/file/crypto__config_8h/#c.MBEDTLS_MD_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
