id: se_manager_ext
label: SE Manager Ext
package: platform_core
description: >-
  Extended SE Manager component. This component provides additional features
  not available in the production quality component.
category: Platform|Security|SE Manager
quality: evaluation
ui_hints:
  visibility: never
source:
- path: src/sl_se_manager_util_internal.c
- path: src/sl_se_manager_extmem_internal.c
  condition: [device_series_3]
- path: src/sli_se_manager_supplicant.c
  condition: [device_series_3, device_has_wificmu]

include:
- path: inc
  file_list:
  - path: sl_se_manager_util_internal.h
  - path: sli_se_manager_mailbox_internal.h
  - path: sl_se_manager_extmem_internal.h
    condition: [device_series_3]
  - path: sli_se_manager_supplicant.h
    condition: [device_series_3, device_has_wificmu]

requires:
- name: se_manager

provides:
- name: se_manager_ext
- name: se_manager_itcm_configuration
  condition: [device_has_itcm]
- name: se_manager_supplicant
  condition: [device_series_3, device_has_wificmu]
- name: se_manager_dpd_configuration
  condition: [device_series_3]
- name: se_manager_psram_configuration
  condition: [device_series_3, device_has_qspi1]

metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/security/sl_component/se_manager
