id: mbedtls_random
package: platform_core
label: CTR-DRBG
description: >-
  This component provides support for pseudo-random number generation
  using the CTR-DRBG construction in Mbed TLS.
category: Platform|Security|Mbed TLS|Randomness
quality: production
provides:
- name: mbedtls_random
requires:
- name: mbedtls_aes
- name: mbedtls_sha256
- name: mbedtls_entropy_default
  condition: [device_cortexm]

template_contribution:
- name: psa_crypto_builtin_config
  value: MBEDTLS_ENTROPY_C
- name: psa_crypto_builtin_config
  value: MBEDTLS_ENTROPY_FORCE_SHA256
#  MBEDTLS_ENTROPY_MAX_SOURCES gets redefined in drivers/builtin/include/mbedtls/private/entropy.h
#  and currently we cannot change directly from here.
#  - name: psa_crypto_builtin_config
#    value: "MBEDTLS_ENTROPY_MAX_SOURCES  2"
- name: psa_crypto_builtin_config
  value: MBEDTLS_NO_PLATFORM_ENTROPY
  condition:
  - device_cortexm
- name: psa_crypto_builtin_config
  value: MBEDTLS_CTR_DRBG_C
documentation:
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
