id: tz_sl_interface_crypto_mac_funcs
package: platform_core
description: >-
  This component provides a TrustZone secure library interface crypto mac functions
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tz_sl_interface_crypto_mac_funcs
requires:
- name: trustzone_nonsecure
template_contribution:
- name: tfm_interface_func
  value:
    function: tfm_crypto_mac_compute
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_mac_verify
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_mac_sign_setup
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_mac_verify_setup
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_mac_update
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_mac_sign_finish
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_mac_verify_finish
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_mac_abort
    key_checks: []

documentation:
  url: https://www.silabs.com/documents/public/application-notes/an1374-trustzone.pdf
metadata:
  sbom:
    license: Zlib
root_path: platform_core
