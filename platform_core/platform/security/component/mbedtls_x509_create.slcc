id: mbedtls_x509_create
package: platform_core
label: X.509 Create Certificates Core
description: >-
  This component provides X.509 core for creating certificates.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_x509_create

# This component is part of the Mbed TLS upper layers (SSL, X509, etc).
# In the TZ Secure Key Library use case, the Mbed TLS upper layers lives
# in the TZ NonSecure application, and is not not allowed to be included
# in the secure library.
conflicts:
- name: tz_secure_key_library_s

requires:
- name: mbedtls_core
- name: mbedtls_asn1_write
- name: mbedtls_oid
- name: mbedtls_pk_parse
- name: psa_crypto_hash

template_contribution:
- name: mbedtls_config
  value: MBEDTLS_X509_CREATE_C

documentation:
  # X.509 module — certificate writing core (create certificates)
  url: https://docs.silabs.com/gecko-platform/4.4.7/platform-security/x509-module

metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
