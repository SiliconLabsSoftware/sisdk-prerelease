id: sli_mbedtls_ecc_secp224r1
package: platform_core
label: secp224r1
description: >-
  Internal compatibility component that provides sli_mbedtls_ecp_secp224r1_group_load
  and sli_mbedtls_ecp_secp224r1_group_copy for the private software secp224r1
  curve. It does not enable secp224r1 through mbedtls_ecp_group_load, the PSA
  Crypto API, or hardware drivers. Requires another short-Weierstrass curve
  (secp256r1) so Mbed TLS compiles SW ECP arithmetic.
category: Platform|Security|Mbed TLS|Elliptic Curves
quality: production
ui_hints:
  visibility: never
provides:
- name: sli_mbedtls_ecc_secp224r1
- name: mbedtls_ecc_curve
  allow_multiple: true
requires:
- name: mbedtls_ecc
- name: mbedtls_declare_private_identifiers
- name: mbedtls_ecc_secp256r1
source:
- path: sl_mbedtls_support/src/sli_mbedtls_ecp_curves.c
include:
- path: sl_mbedtls_support/inc
  file_list:
  - path: sli_mbedtls_ecp.h
template_contribution:
- name: mbedtls_mpi_max
  value: 28
documentation:
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-psa-crypto/psa-crypto-plugins
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core/platform/security/sl_component
