id: mbedtls_gcm
package: platform_core
label: GCM
description: >-
  This component provides support for authenticated encryption and decryption
  in GCM mode for block ciphers using Mbed TLS.
category: Platform|Security|Mbed TLS|Authenticated Encryption
quality: production
provides:
- name: mbedtls_gcm
requires:
- name: mbedtls_cipher
- name: mbedtls_core
- name: psa_crypto_gcm
  condition: [psa_crypto]
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_GCM_C
documentation:
  url: https://docs.silabs.com/gecko-platform/4.4.7/platform-security/sl-crypto-gcm
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
