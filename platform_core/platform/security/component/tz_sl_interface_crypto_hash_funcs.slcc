- name: tfm_interface_func
  value:
    function: tfm_crypto_hash_update
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_hash_finish
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_hash_compute
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_hash_verify
    key_checks: []

- name: tfm_interface_func
  value:
