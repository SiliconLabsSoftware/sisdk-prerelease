id: psa_crypto_cmac
package: platform_core
label: CMAC
description: >-
  This component provides support for the CMAC, Cipher based Message
  Authentication Code algorithm in PSA Crypto.
category: Platform|Security|PSA Crypto|Message Authentication Codes
quality: production
provides:
- name: psa_crypto_cmac
requires:
- name: psa_crypto_aes
- name: sl_si91x_psa_mac
  condition: [device_si91x]
template_contribution:
- name: psa_crypto_config
  value: PSA_WANT_ALG_CMAC 1
- name: psa_crypto_builtin_config
  value: "MBEDTLS_PSA_BUILTIN_ALG_CMAC 1"
  condition: [mbedtls_cmac]
documentation:
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-psa-crypto/psa-crypto-plugins
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
