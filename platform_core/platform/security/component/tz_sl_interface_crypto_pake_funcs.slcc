    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_pake_input
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_pake_get_shared_key
    key_checks: []

- name: tfm_interface_func
