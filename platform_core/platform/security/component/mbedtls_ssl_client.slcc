id: mbedtls_ssl_client
package: platform_core
label: SSL Client
description: >-
  This component provides SSL client support in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_ssl_client
requires:
- name: mbedtls_ssl_tls
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SSL_CLI_C
documentation:
  # No dedicated SSL Client page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
