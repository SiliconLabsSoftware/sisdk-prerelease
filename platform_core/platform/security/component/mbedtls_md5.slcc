id: mbedtls_md5
package: platform_core
label: MD5
description: >-
  This component provides support for the MD5 hash function using Mbed TLS.
category: Platform|Security|Mbed TLS|Hashing
quality: production
provides:
- name: mbedtls_md5
- name: mbedtls_hash_function
  allow_multiple: true
requires:
- name: mbedtls_hash
- name: psa_crypto_md5
  condition: [psa_crypto]
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_MD5_C
documentation:
  url: https://docs.silabs.com/gecko-platform/4.4.7/platform-security/hashing-module
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
