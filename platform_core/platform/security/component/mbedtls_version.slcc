id: mbedtls_version
package: platform_core
label: Version Helpers
description: >-
  This component enables the Mbed TLS run-time version information API functions.
category: Platform|Security|Mbed TLS|Utilities
quality: production

# This component is part of the Mbed TLS upper layers (SSL, X509, etc).
# In the TZ Secure Key Library use case, the Mbed TLS upper layers lives
# in the TZ NonSecure application, and is not not allowed to be included
# in the secure library.
conflicts:
- name: tz_secure_key_library_s

provides:
- name: mbedtls_version

requires:
- name: mbedtls_core

source:
- path: platform/security/sl_component/sl_mbedtls_support/src/version_features.c

template_contribution:
- name: mbedtls_config
  value: MBEDTLS_VERSION_C
- name: mbedtls_config
  value: MBEDTLS_VERSION_FEATURES

documentation:
  # No dedicated Version Helpers page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
