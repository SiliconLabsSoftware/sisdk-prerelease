id: mbedtls_pem
package: platform_core
label: PEM Parsing and Writing
description: >-
  This component provides support for reading and writing standard PEM formatted
  keys and certificates in Mbed TLS. Password-encrypted PEM is not included,
  add mbedtls_pem_rfc1421 for that.
  This component is DEPRECATED and is replaced by new set of components
  including mbedtls_pem_parse, mbedtls_pem_write.
category: Platform|Security|Mbed TLS|Upper Layer
quality: deprecated
provides:
- name: mbedtls_pem
requires:
- name: mbedtls_pem_parse
- name: mbedtls_pem_write
documentation:
  # No dedicated PEM page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
