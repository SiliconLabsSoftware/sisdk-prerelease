id: tz_sl_interface_crypto_cipher_funcs
package: platform_core
description: >-
  This component provides a TrustZone secure library interface crypto cipher functions
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tz_sl_interface_crypto_cipher_funcs
requires:
- name: trustzone_nonsecure
template_contribution:
- name: tfm_interface_func
  value:
    function: tfm_crypto_cipher_encrypt
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_cipher_decrypt
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_cipher_encrypt_setup
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_cipher_decrypt_setup
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_cipher_generate_iv
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_cipher_set_iv
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_cipher_update
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_cipher_finish
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_cipher_abort
    key_checks: []

documentation:
  url: https://www.silabs.com/documents/public/application-notes/an1374-trustzone.pdf
metadata:
  sbom:
    license: Zlib
root_path: platform_core
