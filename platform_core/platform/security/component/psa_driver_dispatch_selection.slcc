id: psa_driver_dispatch_selection
package: platform_core
label: PSA Driver dispatch selection
description: >-
  This component selects the applicable psa_driver_dispatch implementation
  given the configuration.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never

provides:
- name: psa_driver_dispatch_selection

requires:
- name: sli_psa_driver_dispatch
  condition: [device_series_2, trustzone_unaware]
- name: sli_psa_driver_dispatch
  condition: [device_series_2, trustzone_secure]
- name: sli_psa_driver_dispatch
  condition: [device_series_3, trustzone_unaware]
- name: sli_psa_driver_dispatch
  condition: [device_series_3, trustzone_secure]
- name: sli_psa_driver_dispatch
  condition: [device_si91x]
- name: sli_psa_driver_dispatch
  condition: [device_host]

metadata:
  sbom:
    license: Zlib
root_path: platform_core
