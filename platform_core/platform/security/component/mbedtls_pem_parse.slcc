id: mbedtls_pem_parse
package: platform_core
label: PEM Parsing
description: >-
  This component provides support for reading standard base64-wrapped PEM
  formatted keys and certificates in Mbed TLS. Password-encrypted PEM is not
  included; add mbedtls_pem_rfc1421 for that.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_pem_parse
requires:
- name: mbedtls_base64
template_contribution:
- name: psa_crypto_config
  value: MBEDTLS_PEM_PARSE_C
documentation:
  # No dedicated PEM Parsing page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
