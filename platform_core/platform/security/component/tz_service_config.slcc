id: tz_service_config
package: platform_core
description: >-
  This component provides TZ service config
category: Platform|Security|TrustZone
ui_hints:
  visibility: never
quality: production
provides:
- name: tz_service_config

conflicts:
- name: trustzone_unaware

template_file:
- path: config/template/tz_service_config_autogen.h.jinja
  export: true
  condition: [trustzone_nonsecure]

define:
- name: TZ_SERVICE_CONFIG_PRESENT
documentation:
  url: https://www.silabs.com/documents/public/application-notes/an1374-trustzone.pdf
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/security/sl_component/sl_trustzone
