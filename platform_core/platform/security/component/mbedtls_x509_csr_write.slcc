id: mbedtls_x509_csr_write
package: platform_core
label: X.509 CSR Creating
description: >-
  This component provides full support for creating X.509 Certificate Signing
  Requests (CSR) in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_x509_csr_write
requires:
- name: mbedtls_x509_create
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_X509_CSR_WRITE_C
documentation:
  # X.509 module — Certificate Signing Request writing (mbedtls_x509write_csr_*)
  url: https://docs.silabs.com/gecko-platform/4.4.7/platform-security/x509-module
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
