id: mbedtls_ssl_proto_tls12
package: platform_core
label: TLS Client
description: >-
  This component enable support for the TLS 1.2 protocol in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production

# This component is part of the Mbed TLS upper layers (SSL, X509, etc).
# In the TZ Secure Key Library use case, the Mbed TLS upper layers lives
# in the TZ NonSecure application, and is not not allowed to be included
# in the secure library.
conflicts:
- name: tz_secure_key_library_s

provides:
- name: mbedtls_ssl_proto_tls12
- name: mbedtls_ssl_proto
  allow_multiple: true
requires:
- name: mbedtls_core
  # TLS 1.2 requires SHA-256 or SHA-384 (running handshake hash) 
- name: psa_crypto_hash
  # TLS 1.2 requires a MBEDTLS_KEY_EXCHANGE_xxxx
- name: mbedtls_key_exchange
recommends:
- id: psa_crypto_sha256
  vendor: silabs
- id: mbedtls_key_exchange_ecdhe_psk

  vendor: silabs
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SSL_PROTO_TLS1_2
documentation:
  # No dedicated TLS 1.2 / TLS Client page; Mbed TLS hub for related docs
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-mbedtls/
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
