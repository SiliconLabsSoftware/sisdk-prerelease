id: mbedtls_x509_csr_parse
package: platform_core
label: X.509 CSR Parsing
description: >-
  This component provides full support for Certificate Signing Request (CSR)
  parsing in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_x509_csr_parse
requires:
- name: mbedtls_x509_use
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_X509_CSR_PARSE_C
documentation:
  # X.509 module — Structures and functions for X.509 Certificate Signing Requests (CSR)
  url: https://docs.silabs.com/gecko-platform/4.4.7/platform-security/x509-module
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
