id: mbedtls_cipher_cbc
package: platform_core
label: CBC Mode
description: >-
  This component provides support for CBC cipher modes in mbed TLS.
category: Platform|Security|Mbed TLS|Encryption
quality: production
ui_hints:
  visibility: never
provides:
- name: mbedtls_cipher_cbc
requires:
- name: mbedtls_block_cipher
- name: psa_crypto_cipher_cbc
  condition: [psa_crypto]
recommends:
- id: mbedtls_aes
  vendor: silabs
template_contribution:
- name: psa_crypto_builtin_config
  value: MBEDTLS_CIPHER_MODE_CBC
- name: psa_crypto_builtin_config
  value: MBEDTLS_CIPHER_MODE_WITH_PADDING
documentation:
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-psa-crypto/psa-crypto-plugins
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
