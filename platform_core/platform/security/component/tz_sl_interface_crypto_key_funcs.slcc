id: tz_sl_interface_crypto_key_funcs
package: platform_core
description: >-
  This component provides a TrustZone secure library interface crypto key functions
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tz_sl_interface_crypto_key_funcs
requires:
- name: trustzone_nonsecure
template_contribution:
- name: tfm_interface_func
  value:
    function: tfm_crypto_get_key_attributes
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_reset_key_attributes
    key_checks: []

- name: tfm_interface_func
  value:
    function: tfm_crypto_import_key
    key_checks:
    - source: key_attributes
      invec: 1

- name: tfm_interface_func
  value:
    function: tfm_crypto_destroy_key
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_export_key
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_export_public_key
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_purge_key
    key_checks:
    - source: packed_key_id

- name: tfm_interface_func
  value:
    function: tfm_crypto_copy_key
    key_checks:
    - source: packed_key_id
    - source: key_attributes
      invec: 1


documentation:
  url: https://www.silabs.com/documents/public/application-notes/an1374-trustzone.pdf
metadata:
  sbom:
    license: Zlib
root_path: platform_core
