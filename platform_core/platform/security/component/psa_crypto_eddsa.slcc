id: psa_crypto_eddsa
package: platform_core
label: EdDSA
description: >-
  This component provides support for signature generation and verification
  with EdDSA in PSA Crypto.
category: Platform|Security|PSA Crypto|Signatures
quality: production
provides:
- name: psa_crypto_eddsa
requires:
- name: psa_crypto
- name: device_has_semailbox
- name: psa_crypto_ecc_edwards_curve
template_contribution:
- name: psa_crypto_config
  value: PSA_WANT_ALG_EDDSA 1
documentation:
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-psa-crypto/psa-crypto-plugins
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
