id: psa_crypto
label: PSA Crypto
package: platform_core
quality: production

category: Platform|Security|PSA Crypto

description: "This component provides the PSA Crypto API, a high-level interface to various cryptographic functions.\n\nSilicon Labs aims to provide hardware acceleration drivers for all operations/algorithms that are supported by hardware accelerators. The set of accelerated functions differs between devices, please refer to the individual device's reference manuals for more information. If hardware acceleration is not available, the software implementations in the Mbed TLS library are used as 'fallback' implementations.\n\nAlgorithms need to be enabled in order to be supported. This is done by including the components corresponding to the wanted primitives, key types, functionality, etc. that live in the different 'Platform|Security|PSA Crypto' subcategories.\n\nIf a device does not support hardware acceleration of a requested function, the corresponding Mbed TLS component under 'Platform|Security|Mbed TLS' will be included. If hardware acceleration is enabled, but the option to fallback to a software implementation
  is still required, it is possible to manually enable the Mbed TLS components. Do note that doing this will result in a potentially significant code size increase.\n\nBased on the selected sub-components, the PSA Crypto configuration file will be auto-generated and included where necessary."

provides:
  # 'psa_crypto' should not be required directly by user applications.
  # Instead the user should require the 'psa_crypto_xxx' components that provides
  # specific PSA Crypto function configurations (contributes PSA_WANT_xxx).
- name: psa_crypto

include:
- path: sl_mbedtls_support/inc
  file_list:
  - path: sl_psa_crypto.h

source:
- path: sl_mbedtls_support/src/sl_psa_crypto.c
- path: sl_mbedtls_support/src/sli_psa_crypto.c

requires:
- name: device
  condition: [device_efx]
- name: psa_crypto_config
- name: psa_crypto_common
- name: psa_crypto_source
  condition: [trustzone_unaware]
- name: psa_crypto_source
  condition: [trustzone_secure]
- name: psa_driver_dispatch
  condition: [device_series_2]
- name: psa_driver_dispatch
  condition: [device_series_3]
- name: psa_driver_dispatch
  condition: [device_si91x]
- name: sl_si91x_psa_crypto
  condition: [device_si91x]
- name: mbedtls_iar_workarounds
  condition: [toolchain_iar]

  # Inclusion of source and config components depends on which TZ state we are
  # targeting. For apps that do not make active use of TZ, a dummy state
  # (trustzone_unaware) should be used.
- name: trustzone_security_state

  # For devices with non-errata TRNG, specifically include the PSA
  # TRNG provider, which will act as the authoritative entropy source
- name: psa_crypto_trng
  condition: [device_series_2]
- name: psa_crypto_trng
  condition: [device_si91x]
- name: psa_crypto_trng
  condition: [device_series_3]

- name: mbedtls_threading_alt
  condition: [freertos]
- name: mbedtls_threading_alt
  condition: [micriumos]

recommends:
  # The require + recommend approach is used for allowing alternative user defined
  # threading configuration.
- id: mbedtls_threading_alt_cmsis_rtos2

  # Assume that projects are TZ unaware unless a state is explicitly included.
  vendor: silabs
- id: trustzone_unaware

  vendor: silabs

template_contribution:

  # Initialization steps:
  # 0. sl_se_init - if se_manager.slcc in included.
  # 1. sl_psa_crypto_init - the SiLabs specific initialization.
  # 2. psa_crypto_init - the standard PSA Crypto library initialization.
  # For TrustZone , initialization of PSA Crypto is handled inside of the SKL secure main.
  # For native and si91x builds , initialization of PSA Crypto is handled outside the
  # psa_crypto.slcc component.
- name: event_handler
  value:
    event: service_init
    include: sl_psa_crypto.h
    handler: sl_psa_crypto_init
  priority: 1
  condition: [trustzone_unaware]
  unless: [native, device_si91x]

- name: event_handler
  value:
    event: service_init
    include: sl_psa_crypto.h
    handler: sl_psa_crypto_init
  priority: 1
  condition: [trustzone_nonsecure]

- name: event_handler
  value:
    event: service_init
    include: psa/crypto.h
    handler: psa_crypto_init
  priority: 2
  condition: [trustzone_unaware]
  unless: [native, device_si91x]

- name: psa_crypto_config
  value: MBEDTLS_PSA_CRYPTO_C
  condition: [trustzone_unaware]

- name: psa_crypto_config_trustzone_secure
  value: MBEDTLS_PSA_CRYPTO_C

- name: psa_key_slots
  value:
    name: psa_key_slots_minimum
    count: 1

  # Add a component catalog entry to allow build-time detection of PSA core presence
- name: component_catalog
  value: psa_crypto

documentation:
  url: https://docs.silabs.com/gecko-platform/latest/platform-security-psa-crypto/

metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/security/sl_component
