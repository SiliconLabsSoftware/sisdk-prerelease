id: emlib_gpio_simple_init
label: GPIO Init
package: platform_core
description: >
  Provides a simple initialization routine for GPIO.

  This component is instantiable, meaning that several named instances can be created. For each instance a configuration is generated along with an initialization routine according to this configuration. The initialization
  routine is available in a generated header file, sl_emlib_gpio_simple_init.h.

  If the Services->Runtime->System Setup->sl_main component is included in the project, the configured GPIO's will be initialized automatically during the sli_main_init() call in main.c or in the start task when using ann RTOS.

  (DEPRECATED) If the Services->Runtime->System Setup->System Init component is included in the project, the configured GPIO's will be initialized automatically during the sl_system_init() call in main.c.

  Selecting this component will also include the GPIO Init Core component, which is the implementation of the GPIO init routine.

category: Platform|Peripheral|EMLIB|Init
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/emlib/init/gpio_simple
instantiable:
  prefix: pin
config_file:
- path: config/sl_emlib_gpio_init_{{instance}}_config.h
  file_id: emlib_gpio_simple_init_config_file_id
provides:
- name: emlib_gpio_simple_init
  allow_multiple: true
requires:
- name: emlib_gpio_simple_init_common
template_contribution:
- name: emlib_gpio_simple_init
  value: '{{instance}}'
tag:
- pin_tool:peripheral:gpio
documentation:
  docset: gecko-platform
  document:
  - page: platform-emlib-efr32xg21/gpio
    condition: [device_sdid_200]
  - page: platform-emlib-efr32xg22/gpio
    condition: [device_sdid_205]
  - page: platform-emlib-efr32xg23/gpio
    condition: [device_sdid_210]
  - page: platform-emlib-efr32xg24/gpio
    condition: [device_sdid_215]
  - page: platform-emlib-efr32xg25/gpio
    condition: [device_sdid_220]
  - page: platform-emlib-efr32xg26/gpio
    condition: [device_sdid_225]
  - page: platform-emlib-efr32xg27/gpio
    condition: [device_sdid_230]
  - page: platform-emlib-efr32xg28/gpio
    condition: [device_sdid_235]
  - page: platform-emlib-efr32xg29/gpio
    condition: [device_sdid_240]
