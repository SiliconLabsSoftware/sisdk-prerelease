config_file:
- path: platform/Device/config/205/device.yaml
  directory: rail
  condition:
  - custom_radio_config
metadata:
  sbom:
    license: Zlib
  device:
    opn: mgm220pc22hna
    memory:
    - name: Main Flash
      start: 0
      size: 524288
      page_size: 8192
      type: non-volatile
    - name: RAM
      start: 536870912
      size: 32768
      type: volatile
