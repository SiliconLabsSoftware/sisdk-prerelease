id: cpc_gpio_expander_cli_cmd
label: CPC GPIO Expander CLI
package: cpc_gpio
description: >
  Co-Processor Communication (CPC) GPIO Expander Command Line Interface (CLI).  This component allows the user to interact with the secondary device via the CLI.
category: Services|Co-Processor Communication|Secondary Device
quality: internal
metadata:
  sbom:
    license: Zlib
source:
- path: src/sli_cpc_gpio_expander_cli.c
provides:
- name: cpc_gpio_expander_cli_cmd
requires:
- name: status
- name: status_string
- name: sl_assert
- name: cpc_secondary
- name: cpc_gpio_expander
- name: cli_core
- name: cli_recommended_instance
- name: iostream_cpc
template_contribution:
- name: component_catalog
  value: cli_cpc_gpio_expander
- name: cli_group
  value:
    name: gpio
    help: CPC GPIO Expander CLI commands
- name: cli_command
  value:
    name: get_value
    handler: sli_cpc_gpio_expander_get_value
    help: Gets the value of a GPIO
    shortcuts:
    - name: get
    group: gpio
    argument:
    - type: uint32
      help: Host pin number
- name: cli_command
  value:
    name: set_value
    handler: sli_cpc_gpio_expander_set_value
    help: Sets the value of a GPIO
    shortcuts:
    - name: set
    group: gpio
    argument:
    - type: uint32
      help: Host pin number
    - type: uint32
      help: Value (0 = Low, 1 = High)
- name: cli_command
  value:
    name: get_direction
    handler: sli_cpc_gpio_expander_get_direction
    help: Gets the direction of a GPIO
    shortcuts:
    - name: gdir
    group: gpio
    argument:
    - type: uint32
      help: Host pin number
- name: cli_command
  value:
    name: set_direction
    handler: sli_cpc_gpio_expander_set_direction
    help: Sets the direction of a GPIO
    shortcuts:
    - name: sdir
    group: gpio
    argument:
    - type: uint32
      help: Host pin number
    - type: uint32
      help: Direction (0 = Disabled, 1 = Input, 2 = InputPullUp, 3 = InputPullDown, 4 = OpenDrain, 5 = OpenDrainPullUp, 6 = OpenSource, 7 = OpenSourcePullDown, 8 = PushPull)
- name: cli_command
  value:
    name: get_name
    handler: sli_cpc_gpio_expander_get_name
    help: Gets the name of a GPIO
    shortcuts:
    - name: gname
    group: gpio
    argument:
    - type: uint32
      help: Host pin number
- name: cli_command
  value:
    name: set_seq_offset
    handler: sli_cpc_gpio_expander_set_seq_offset
    help: Set sequence number offset [SLI_CPC_GPIO_EXPANDER_UNDER_TEST]
    group: gpio
    argument:
    - type: uint8
      help: Sequence number offset
- name: cli_command
  value:
    name: get_chip_label
    handler: sli_cpc_gpio_expander_get_chip_label
    help: Get GPIO Expander Chip Label string
    group: gpio
root_path: cpc_gpio
