package: zigbee
description: A component implementing CLI for Green Power v1.1.3 (OOB key and install-code pre-configuration).
label: Green Power v1.1.3 CLI
quality: production
id: zigbee_green_power_v113_cli
category: Zigbee|Green Power
provides:
- name: zigbee_green_power_v113_cli
requires:
- name: zigbee_green_power_v113
source:
- path: app/framework/plugin/green-power-v113/green-power-v113-cli.c
  condition:
  - cli
  - zigbee_green_power_v113
include:
- path: app/framework/plugin/green-power-v113
  file_list:
  - path: green-power-v113.h
    condition:
    - zigbee_green_power_v113
- path: stack/include
  file_list:
  - path: gp-install-code.h
template_contribution:
- name: component_catalog
  value: zigbee_green_power_v113_cli
  # Reuse green-power-server CLI group so existing plugin green-power-server
  # set-oob-key / clear-oob-key commands keep working for sim/BSH.
- name: cli_group
  value:
    group: plugin
    name: green-power-server
    help: green-power-server related commands.
- name: cli_command
  value:
    group: green-power-server
    name: set-oob-key
    handler: sl_zigbee_af_green_power_server_cli_set_oob_key
    help: Pre-configure an OOB key for a SrcID GPD (GP v1.1.3).
    argument:
    - type: uint32
      help: GPD SrcID
    - type: hex
      help: 16-byte OOB key
- name: cli_command
  value:
    group: green-power-server
    name: clear-oob-key
    handler: sl_zigbee_af_green_power_server_cli_clear_oob_key
    help: Clear a pre-configured OOB key for a SrcID GPD (GP v1.1.3).
    argument:
    - type: uint32
      help: GPD SrcID
- name: cli_command
  value:
    group: green-power-server
    name: register-install-code
    handler: sl_zigbee_af_green_power_server_cli_register_install_code
    help: Register an 18-byte GPD install code (16 + CRC) for TC-mediated commissioning.
    argument:
    - type: uint32
      help: GPD SrcID
    - type: hex
      help: 18-byte install code (16 data + 2 CRC LE)
- name: cli_command
  value:
    group: green-power-server
    name: remove-install-code
    handler: sl_zigbee_af_green_power_server_cli_remove_install_code
    help: Remove a registered GPD install code.
    argument:
    - type: uint32
      help: GPD SrcID
- name: cli_command
  value:
    group: green-power-server
    name: set-tc-ic-mode
    handler: sl_zigbee_af_green_power_server_cli_set_tc_ic_mode
    help: Set gpTC_Policy_ICMode (1 = install code mandatory, Figure 122).
    argument:
    - type: uint8
      help: 0 or 1

documentation:
  docset: zigbee
  document: zigbee-af-api/green-power-v113
metadata:
  sbom:
    license: MSLA
root_path: zigbee
