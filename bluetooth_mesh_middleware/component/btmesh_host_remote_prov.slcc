id: btmesh_host_remote_prov
label: BT Mesh Remote Provisioner Component
package: bluetooth_mesh_middleware
description: >
  BT Mesh Remote Provisioner component provides functionality for remote
  provisioning of devices into a Bluetooth Mesh network.
category: Bluetooth Mesh|Host
quality: production
root_path: bluetooth_mesh_middleware/common/btmesh_host_remote_prov
include:
- path: .
  file_list:
  - path: btmesh_remote_prov.h
source:
- path: btmesh_remote_prov.c
provides:
- name: btmesh_host_remote_prov
requires:
- name: btmesh_stack_api_ncp_host
- name: app_timer
- name: btmesh_host_prov
- name: component_catalog
template_contribution:
- name: component_catalog
  value: btmesh_host_remote_prov
