id: sl_rail_util_scheduler
label: RAIL Utility, Scheduler
description: Drain hardware-scheduler deferred work from the SDK process_action path (baremetal) or a wakeable RTOS worker, with power-manager pending-work hooks.
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: sl_rail_util_scheduler
    name: RAIL Utility, Scheduler
    license: Zlib
provides:
- name: sl_rail_util_scheduler
requires:
- name: rail_lib
- name: component_catalog
include:
- path: plugin/sl_rail_util_scheduler
  file_list:
  - path: sl_rail_util_scheduler.h
    condition:
    - device_has_hwsched
source:
- path: plugin/sl_rail_util_scheduler/sl_rail_util_scheduler.c
  condition:
  - device_has_hwsched
config_file:
- path: plugin/sl_rail_util_scheduler/config/sl_rail_util_scheduler_config.h
  condition:
  - device_has_hwsched
template_contribution:
- name: component_catalog
  value: sl_rail_util_scheduler
  condition:
  - device_has_hwsched

  # Baremetal: drain from sl_main_process_action / service_process_action.
- name: event_handler
  value:
    event: service_process_action
    include: sl_rail_util_scheduler.h
    handler: sl_rail_util_scheduler_process_action
  condition:
  - device_has_hwsched
  unless:
  - kernel

  # RTOS: start a wakeable worker (main/start task exits after init).
- name: event_handler
  value:
    event: service_init
    include: sl_rail_util_scheduler.h
    handler: sl_rail_util_scheduler_init
  condition:
  - device_has_hwsched
  - kernel

  # Baremetal + power manager: do not sleep with queued HWSCHED work.
- name: power_manager_handler
  value:
    event: is_ok_to_sleep
    include: sl_rail_util_scheduler.h
    handler: sl_rail_util_scheduler_is_ok_to_sleep
  condition:
  - device_has_hwsched
  unless:
  - kernel

- name: power_manager_handler
  value:
    event: sleep_on_isr_exit
    include: sl_rail_util_scheduler.h
    handler: sl_rail_util_scheduler_sleep_on_isr_exit
  condition:
  - device_has_hwsched
  unless:
  - kernel
root_path: rail_library
