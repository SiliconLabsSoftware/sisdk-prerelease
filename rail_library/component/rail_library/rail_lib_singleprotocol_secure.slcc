  - toolchain_llvm
  - device_sdid_200
  unless:
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg21_iar_secure.a
  condition:
  - toolchain_iar
  - device_sdid_200
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg21_gcc_secure.a
  condition:
  - toolchain_gcc
  - device_sdid_200
  - device_is_module
