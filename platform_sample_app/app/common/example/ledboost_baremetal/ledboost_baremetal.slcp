project_name: ledboost_baremetal
package: platform
quality: evaluation
label: Platform - LED Boost DCDC Bare-metal
description: >
  This example project demonstrates the DCDC boost LEDVDD ramp sequence.
  The boost output is brought up at 1.8V, then ramped to 3.8V. 
  The DCDC interrupt signals ramp completion.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: app.c
  - path: ledboost.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: ledboost.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: hal_emu
define:
  - name: DEBUG_EFM
readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
