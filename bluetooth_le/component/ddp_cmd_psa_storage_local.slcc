id: ddp_cmd_psa_storage_local
label: DDP commands for PSA Crypto local storage
description: >
  Initializes PSA components in order to store persistent keys in the local
  storage area of the device. This can be accessed from the TrustZone secure
  application of the target firmware.
package: bluetooth_le
category: Bluetooth|Application|Miscellaneous
quality: production
metadata:
  sbom:
    license: Zlib
root_path: bluetooth_le/common/ddp
provides:
- name: ddp_cmd_psa_storage
- name: ddp_cmd_psa_storage_local
requires:
- name: psa_builtin_key_support_cryptoacc
  condition: [device_has_cryptoacc, device_has_sepuf]
- name: psa_builtin_key_support_se
  condition: [device_has_semailbox]
define:
- name: DDP_PSA_KEY_LOCATION
  value: "PSA_KEY_LOCATION_LOCAL_STORAGE"
  # ITS should be encrypted
- name: SLI_PSA_ITS_ENCRYPTED
