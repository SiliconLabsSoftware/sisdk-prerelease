id: cs_configurator
package: bluetooth_le
label: CS Configurator
description: >
  Channel Sounding (CS) Configurator is responsible for creating valid configuration for the CS procedures.
category: Bluetooth|Application|Miscellaneous
metadata:
  sbom:
    license: Zlib
quality: experimental

include:
- path: common/cs_common
  file_list:
  - path: cs_common.h
- path: common/cs_configurator/inc
  file_list:
  - path: cs_configurator.h
  - path: cs_configurator_rtllib_internal.h
  - path: cs_configurator_optimization_internal.h
  - path: cs_configurator_rtllib_parameters_internal.h

source:
- path: common/cs_configurator/src/cs_configurator.c
- path: common/cs_configurator/src/cs_configurator_rtllib.c

config_file:
- path: common/cs_configurator/config/cs_configurator_config.h

requires:
- name: bluetooth_api
- name: component_catalog
- name: sl_common
- name: cs_rreq
- name: cs_manager

provides:
- name: cs_configurator
root_path: bluetooth_le
