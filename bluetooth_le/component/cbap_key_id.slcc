id: cbap_key_id
label: Certificate Based Authentication and Pairing - Key IDs
package: bluetooth_le
description: >
  PSA key IDs for Certificate Based Authentication and Pairing
category: Bluetooth|Application|Miscellaneous
metadata:
  sbom:
    license: Zlib
quality: experimental
root_path: bluetooth_le/common/cbap_key_id
provides:
- name: cbap_key_id

template_file:
- path: template/cbap_key_id.h.jinja
- path: template/cbap_key_id.py.jinja

template_contribution:
- name: cbap_psa_keys
  value:
    key_name: CBAP_PSA_BASE
    key_id: "0x00004700"
- name: cbap_psa_keys
  value:
    key_name: CBAP_PSA_DEVICE_KEY
    key_id: "CBAP_PSA_BASE + 0"
- name: cbap_psa_keys
  value:
    key_name: CBAP_PSA_AUTH_DATA
    key_id: "CBAP_PSA_BASE + 1"
- name: cbap_psa_keys
  value:
    key_name: CBAP_PSA_ROOT_CERT
    key_id: "CBAP_PSA_BASE + 2"
- name: cbap_psa_keys
  value:
    key_name: CBAP_PSA_FACTORY_CERT
    key_id: "CBAP_PSA_BASE + 3"
- name: cbap_psa_keys
  value:
    key_name: CBAP_PSA_BATCH_CERT
    key_id: "CBAP_PSA_BASE + 4"
- name: cbap_psa_keys
  value:
    key_name: CBAP_PSA_DEVICE_CERT
    key_id: "CBAP_PSA_BASE + 5"


  # Needed for the DDP (trustzone_unaware) and the secure app. However,
  # it imports the configuration from the nonsecure app (trustzone_nonsecure).
- name: psa_its_files
  value:
    name: psa_its_files_cbap
    count: 6
  condition: [psa_its]
  unless: [trustzone_secure]
