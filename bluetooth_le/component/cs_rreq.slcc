id: cs_rreq
package: bluetooth_le
label: CS Ranging Requester (RREQ)
description: >
  Channel Sounding (CS) Ranging Profile (RAP) Ranging Requester (RREQ) role.
  Supports Application Co-Processor (ACP) mode.
category: Bluetooth|Application|GATT Profiles
metadata:
  sbom:
    license: Zlib
quality: experimental
root_path: bluetooth_le/common
include:
- path: cs_rreq/inc
  file_list:
  - path: cs_rreq_api.h
  - path: cs_rreq.h
    unless: [cs_acp_host]
  - path: cs_rreq_log.h
    unless: [cs_acp_host]
  - path: cs_rreq_internal.h
    unless: [cs_acp_host]
  - path: cs_rreq_state.h
    unless: [cs_acp_host]
  - path: cs_rreq_types.h
    unless: [cs_acp_host]
  - path: cs_rreq_acp_types.h
    unless: [cs_acp_none]
  - path: cs_rreq_acp_host.h
    condition: [cs_acp_host]
  - path: cs_rreq_acp_target.h
    condition: [cs_acp_target]
config_file:
- path: cs_rreq/config/cs_rreq_config.h
  unless: [cs_acp_host]
source:
- path: cs_rreq/src/cs_rreq.c
  unless: [cs_acp_host]
- path: cs_rreq/src/cs_rreq_extract.c
  unless: [cs_acp_host]
- path: cs_rreq/src/cs_rreq_state.c
  unless: [cs_acp_host]
- path: cs_rreq/src/cs_rreq_ras.c
  unless: [cs_acp_host]
- path: cs_rreq/src/cs_rreq_acp_host.c
  condition: [cs_acp_host]
- path: cs_rreq/src/cs_rreq_acp_target.c
  condition: [cs_acp_target]

requires:
- name: component_catalog
- name: cs_acp_state
- name: sl_common
- name: app_rta
- name: status

- name: bluetooth_api
  condition: [cs_acp_with_impl]
- name: bluetooth_feature_cs
  condition: [cs_acp_with_impl]
- name: cs_ras_client
  condition: [cs_acp_with_impl]
- name: cs_ras_common
  condition: [cs_acp_host]
- name: cs_result
  condition: [cs_acp_with_impl]

recommends:
- id: cs_acp_none

  vendor: silabs
provides:
- name: cs_rreq

template_file:
- path: cs_rreq/template/cs_rreq_data_handler.c.jinja
  unless: [cs_acp_host]

template_contribution:
- name: ncp_local_evt_process
  value:
    include: cs_rreq_internal.h
    handler: cs_rreq_on_bt_event
  priority: 420   # cs_ras_client_on_bt_event must be higher than cs_rreq_on_bt_event
  condition: [cs_acp_target]
- name: bluetooth_on_event
  value:
    include: cs_rreq_internal.h
    function: cs_rreq_on_bt_event
  priority: 420   # cs_ras_client_on_bt_event must be higher than cs_rreq_on_bt_event
  condition: [cs_acp_none]
- name: event_handler
  value:
    event: internal_app_init
    include: cs_rreq_internal.h
    handler: cs_rreq_init
  unless: [cs_acp_host]
- name: app_rta_init
  value:
    include: cs_rreq_internal.h
    handler: cs_rreq_rta_init
  unless: [cs_acp_host]
- name: app_rta_ready
  value:
    include: cs_rreq_internal.h
    handler: cs_rreq_rta_ready
  unless: [cs_acp_host]

  # ACP-related
- name: bluetooth_on_event
  value:
    include: cs_rreq_acp_host.h
    function: cs_rreq_acp_host_event
  priority: 0
  condition: [cs_acp_host]
- name: event_handler
  value:
    event: internal_app_init
    include: cs_rreq_acp_target.h
    handler: cs_rreq_acp_target_init
  condition: [cs_acp_target]
- name: cs_acp_target_on_command
  value:
    include: cs_rreq_acp_target.h
    handler: cs_rreq_acp_target_on_command
  condition: [cs_acp_target]
