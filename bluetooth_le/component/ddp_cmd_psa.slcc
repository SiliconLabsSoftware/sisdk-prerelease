id: ddp_cmd_psa
label: DDP commands for PSA Crypto
description: >
  This component provides a Dynamic Data Provisioning (DDP) command set
  for saving data in secure storage using PSA Crypto.
package: bluetooth_le
category: Bluetooth|Application|Miscellaneous
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
root_path: bluetooth_le/common/ddp
provides:
- name: ddp_cmd_psa
requires:
- name: ddp
- name: ddp_cmd_psa_init
- name: ddp_cmd_psa_storage
- name: psa_its
- name: psa_crypto
- name: psa_crypto_cmac
- name: psa_crypto_gcm
- name: mbedtls_core
- name: trustzone_unaware
- name: nvm3_default
- name: sl_common
source:
- path: src/sl_ddp_cmd_psa.c
other_file:
- path: script/ddp_cmd_psa.py
  project:
    transfer_ownership: true
    directory: script
define:
- name: SL_DDP_CMD_PSA_ITS_SET
  value: 2
- name: SL_DDP_CMD_PSA_ITS_GET
  value: 3
- name: SL_DDP_CMD_PSA_KEY_GEN
  value: 4
- name: SL_DDP_CMD_PSA_KEY_INJ
  value: 5
- name: SL_DDP_CMD_PSA_KEY_GET_ATT
  value: 6
template_contribution:
- name: ddp_command
  value:
    id: SL_DDP_CMD_PSA_ITS_SET
    handler: sl_ddp_cmd_psa_its_set
- name: ddp_command
  value:
    id: SL_DDP_CMD_PSA_ITS_GET
    handler: sl_ddp_cmd_psa_its_get
- name: ddp_command
  value:
    id: SL_DDP_CMD_PSA_KEY_GEN
    handler: sl_ddp_cmd_psa_key_gen
- name: ddp_command
  value:
    id: SL_DDP_CMD_PSA_KEY_INJ
    handler: sl_ddp_cmd_psa_key_inj
- name: ddp_command
  value:
    id: SL_DDP_CMD_PSA_KEY_GET_ATT
    handler: sl_ddp_cmd_psa_key_get_att
