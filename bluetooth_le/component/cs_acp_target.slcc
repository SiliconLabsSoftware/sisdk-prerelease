id: cs_acp_target
package: bluetooth_le
label: CS ACP Target
description: >
  Channel Sounding (CS) Application Co-Processor (ACP) provides the ACP commands and events to the CS device roles.
  NCP target side.
category: Bluetooth|Application|Miscellaneous
metadata:
  sbom:
    license: Zlib
quality: experimental
root_path: bluetooth_le/common/cs_acp
include:
- path: ./
  file_list:
  - path: cs_acp_common.h
  - path: cs_acp_target.h
template_file:
- path: cs_acp_target.c.jinja
requires:
- name: sl_common
- name: status
- name: enum
- name: component_catalog
- name: ncp
- name: cs_result
provides:
- name: cs_acp_state
- name: cs_acp_target
- name: cs_acp_with_impl
template_contribution:
- name: component_catalog
  value: cs_acp_target
