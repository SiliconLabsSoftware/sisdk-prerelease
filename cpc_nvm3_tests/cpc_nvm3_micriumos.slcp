project_name: cpc_nvm3_micriumos
package: cpc_nvm3_tests
description: Test CPC NVM3
category: Test|Framework
quality: internal
component:
  - id: sl_main
  - id: device_init
  - id: device_init_clocks
  - id: cpc_secondary
  - id: cpc_nvm3
  - id: cpc_nvm3_test
  - id: micriumos_kernel
  - id: cli
    instance: [test]
  - id: toolchain_gcc_warnings_undef
define:
  - name: HEAP_SIZE
    value: 2 * FLASH_PAGE_SIZE
  - name: SL_SUPPRESS_DEPRECATION_WARNINGS_SDK_2025_6
configuration:
  - name: SL_CPC_NVM3_TX_PAYLOAD_MAX_LENGTH
    value: 64
  - name: NVM3_DEFAULT_MAX_OBJECT_SIZE
    value: 512
  - name: SL_CLI_TEST_TASK_PRIORITY
    value: osPriorityNormal5
  - name: SL_HEAP_SIZE
    value: HEAP_SIZE
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
    condition: [cpc_config_vcom]
