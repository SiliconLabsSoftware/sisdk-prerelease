parameters:
  - name: build_dir
steps:
  # Export application binary
  - task: copy
    input: "{{build_dir}}/{{project_name}}.s37"
    output: "artifact/{{project_name}}.s37"
    export: "btmesh_application_binary"
  # Create upgrade image
  - task: create_gbl
    app: "{{build_dir}}/{{project_name}}.out"
    output: "{{build_dir}}/{{project_name}}.gbl"
