project_name: bt_ncp_cpc
package: bluetooth_le_app
label: Bluetooth - NCP over cpc-ng
description: >-
  Runs a Bluetooth NCP as a CPC Secondary node on an EFR32 using FreeRTOS. It
  communicates over cpc-ng on the EXP UART with a second EFR32 running the
  bt_ncp_host_cpc CPC Primary example.
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["NCP"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: freertos
  - id: bluetooth_stack
  - id: bluetooth_on_demand_start
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_extended_advertiser
  - id: bluetooth_feature_periodic_advertiser
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gap
  - id: bluetooth_feature_gatt
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_nvm
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_extended_scanner
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_sync
  - id: bluetooth_feature_system
  - id: bluetooth_feature_dynamic_gattdb
  - id: bluetooth_feature_test
  - id: ncp
  - id: ncp_user_cmd
  - id: bluetooth_bgapi_link
  - id: cpc_ng_secondary
  - id: cpc_ng_drv_uart_secondary
    instance:
      - exp
  - id: iostream_eusart
    instance:
      - exp
    condition:
      - device_has_euart
  - id: mpu
  - id: app_assert
  - id: sl_main
  - id: app_os_helper
  - id: clock_manager
  - id: device_init

source:
  - path: app.c

include:
  - path: .
    file_list:
      - path: app.h

readme:
  - path: readme.md

configuration:
  - name: SL_STACK_SIZE
    value: "2400"
  - name: configTOTAL_HEAP_SIZE
    value: "12000"
  - name: configTIMER_TASK_STACK_DEPTH
    value: "240"
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: 4
  - name: SL_BOARD_ENABLE_VCOM
    value: 0
  - name: SL_IOSTREAM_EUSART_EXP_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_NONE
    condition:
      - device_has_euart
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto

tag:
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_has_euart
  - hwfilter:board:hardware:has:exp_header:uart

ui_hints:
  highlight:
    - path: readme.md
      focus: true
