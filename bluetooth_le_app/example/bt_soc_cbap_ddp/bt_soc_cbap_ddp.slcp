---
project_name: bt_soc_cbap_ddp
package: bluetooth_le_app
label: Bluetooth - SoC CBAP Dynamic Data Provisioning
description: >
  This application enables provisioning the device with data, required by
  Certificate Based Authentication and Pairing (CBAP). This is a RAM
  application, therefore it leaves the original firmware untouched. Please
  refer to the readme document for the usage.
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: sl_main
  - id: device_init
  - id: cbap_key_id
  - id: ddp
  - id: ddp_flash_execution
    condition:
      - device_generic_family_efr32xg22
  - id: ddp_cmd_cert
  - id: ddp_cmd_psa
  - id: ddp_cmd_psa_storage_local
    condition:
      - device_security_base
  - id: ddp_cmd_psa_storage_local
    condition:
      - device_security_rot
  - id: ddp_cmd_psa_storage_local
    condition:
      - device_security_se
  - id: ddp_cmd_psa_storage_vault
    condition:
      - device_security_vault

  - id: psa_crypto_ecdsa
  - id: psa_crypto_ecc_secp256r1
  - id: psa_crypto_sha256

provides:
  - name: tz_secure_execution
  - name: tz_execution

other_file:
  - path: provision.py
    project:
      transfer_ownership: true
  - path: certificate_manager.py
    project:
      transfer_ownership: true
  - path: image/readme_img0.png

  # Certificate Authority files for demonstration purposes
  # Root CA
  - path: ca_demo/ca0_root/362235998618210098128576986892169139681887934853.crt
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca0_root
  - path: ca_demo/ca0_root/691047099550201640568062641724369177531491670792.crt
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca0_root
  - path: ca_demo/ca0_root/certificate.pem
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca0_root
  - path: ca_demo/ca0_root/issued_certificates.yaml
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca0_root
  - path: ca_demo/ca0_root/private_key.pem
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca0_root

  # Factory CA
  - path: ca_demo/ca1_factory/386655857600811948380181401082165729182138098553.crt
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca1_factory
  - path: ca_demo/ca1_factory/certificate.pem
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca1_factory
  - path: ca_demo/ca1_factory/issued_certificates.yaml
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca1_factory
  - path: ca_demo/ca1_factory/private_key.pem
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca1_factory

  # Batch CA
  - path: ca_demo/ca2_batch/certificate.pem
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca2_batch
  - path: ca_demo/ca2_batch/issued_certificates.yaml
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca2_batch
  - path: ca_demo/ca2_batch/private_key.pem
    project:
      transfer_ownership: true
      directory: script/ca_demo/ca2_batch

configuration:
  - name: SL_STACK_SIZE
    value: "4096"
  - name: NVM3_DEFAULT_MAX_OBJECT_SIZE
    value: "1200"
    condition:
      - nvm3

  # RTT
  - name: BUFFER_SIZE_UP
    value: "1200"
  - name: BUFFER_SIZE_DOWN
    value: "1200"

  # USART
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: "usartHwFlowControlNone"
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "1"
  - name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "0"
  - name: SL_IOSTREAM_USART_VCOM_RX_BUFFER_SIZE
    value: "1200"

  # EUSART
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_NONE"
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "1"
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "0"
  - name: SL_IOSTREAM_EUSART_VCOM_RX_BUFFER_SIZE
    value: "1200"

tag:
  - toolchain:gcc
  # Filter same hardware as for CBAP
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_series_2
  - hwfilter:device:armv8m.main
  - hwfilter:board:simple_led:led0
  - hwfilter:flash:512k
  - hwfilter:ram:32k

readme:
  - path: readme.md

ui_hints:
  highlight:
    - path: readme.md
      focus: true
