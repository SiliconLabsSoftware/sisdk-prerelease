project_name: bt_ncp_host_cpc
package: bluetooth_le_app
label: Bluetooth - Embedded NCP Host over cpc-ng
description: >-
  Runs a Bluetooth NCP host as a CPC Primary node on an EFR32 using FreeRTOS.
  It communicates over cpc-ng on the EXP UART with a second EFR32 running the
  bt_ncp_cpc CPC Secondary example.
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["Host"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: freertos
  - id: bluetooth_api_ncp_host
  - id: bluetooth_bgapi_link
  - id: cpc_ng_primary
  - id: cpc_ng_drv_uart_primary
    instance:
      - exp
  - id: iostream_eusart
    instance:
      - exp
    condition:
      - device_has_euart
  - id: iostream_retarget_stdio
  - id: iostream_stdlib_config
  - id: iostream_swo
  - id: mpu
  - id: app_assert
  - id: app_log
  - id: app_timer
  - id: sl_main
  - id: app_os_helper
  - id: clock_manager
  - id: device_init

source:
  - path: app.c

include:
  - path: .
    file_list:
      - path: app.h

readme:
  - path: readme.md

configuration:
  - name: SL_STACK_SIZE
    value: "2752"
  - name: configTOTAL_HEAP_SIZE
    value: "12000"
  - name: configTIMER_TASK_STACK_DEPTH
    value: "240"
  - name: SL_BOARD_ENABLE_VCOM
    value: 0
  - name: SL_IOSTREAM_EUSART_EXP_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_NONE
    condition:
      - device_has_euart
  - name: APP_LOG_OVERRIDE_DEFAULT_STREAM
    value: 1
  - name: APP_LOG_STREAM_TYPE
    value: SL_IOSTREAM_TYPE_SWO
  - name: APP_LOG_STREAM_INSTANCE
    value: '"swo"'
  - name: APP_LOG_TIME_ENABLE
    value: 1
  - name: APP_LOG_PREFIX_ENABLE
    value: 1
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto

tag:
  - hwfilter:device:device_has_euart
  - hwfilter:board:hardware:has:exp_header:uart

ui_hints:
  highlight:
    - path: readme.md
      focus: true
