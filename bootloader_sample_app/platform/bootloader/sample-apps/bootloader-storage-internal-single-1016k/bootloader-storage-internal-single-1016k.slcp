project_name: bootloader-storage-internal-single-1016k
package: bootloader
quality: production
label: Bootloader - SoC Internal Storage (single image on 1016kB device)
description: >
  This sample configuration of the Gecko bootloader configures the bootloader to use the internal main flash to store firmware update images. The storage configuration is set up to store a single firmware update image at a time, in a single storage slot. The storage slot follows the 1016 kB flash layout: Slot0 starts at address 0x78000 (or 0x8078000 for device with 0x8000000 flash base), i.e. 0x08078000 through 0x080F1FFF, with a size of 488 kB (499712 bytes, 0x7A000). Those start and size values match BTL_STORAGE_BASE_ADDRESS, SLOT0_START, and SLOT0_SIZE in the configuration section below. This can be configured on the "Storage" tab.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]


component:
  - id: bootloader_core
  - id: bootloader_crc
  - id: bootloader_aes_sha_ecdsa
  - id: bootloader_internal_storage
  - id: bootloader_storage_slots
  - id: bootloader_image_parser
  - id: bootloader_common_storage_single
  - id: bootloader_token_management
  - id: bootloader_debug

configuration:
  - name: SLOT0_ENABLE
    value: 1
  - name: SLOT0_SIZE
    value: 499712
  ## device_sdid_250 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 134709248
    condition: [device_sdid_250]
  - name: SLOT0_START
    value: 134709248
    condition: [device_sdid_250]

tag:
  - hardware:device:flash:1016

readme:
  - path: readme.md
ui_hints:
  highlight: readme.md

post_build:
  profile: bootloader_series_2
