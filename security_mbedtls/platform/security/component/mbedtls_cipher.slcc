id: mbedtls_cipher
package: security_mbedtls
label: Ciphers
description: >-
  This component provides support for the generic APIs for encryption and decryption
  using symmetric ciphers in Mbed TLS.
category: Platform|Security|Mbed TLS|Encryption
ui_hints:
  visibility: never # Does not need to be shown in UI, needs child-components (block cipher) to work.
quality: production
provides:
- name: mbedtls_cipher
requires:
- name: mbedtls_block_cipher
- name: mbedtls_core
recommends:
- id: mbedtls_aes
  vendor: silabs
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_CIPHER_C
metadata:
  sbom:
    license: Apache-2.0
    upstream:
      name: Mbed TLS
      version: v3.6.2
      supplier: Trusted Firmware
      url: https://github.com/Mbed-TLS/mbedtls.git
      comment: Mbed TLS is a C library implementing the PSA Cryptography API, cryptographic primitives, X.509 certificate manipulation and the SSL/TLS and DTLS protocols
root_path: security_mbedtls
