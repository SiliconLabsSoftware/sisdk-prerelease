id: test_suite_psa_crypto-SLI_EXCLUDE_PSA_SE_SYMCRYPTO_DRIVERS
package: security_mbedtls
label: PSA Crypto Test Suite for SLI_EXCLUDE_PSA_SE_SYMCRYPTO_DRIVERS
description: |-
    The purpose of test_suite_psa_crypto-SLI_EXCLUDE_PSA_SE_SYMCRYPTO_DRIVERS
    is to test the exclusion of the PSA SE symmetric crypto and hash drivers
    ( used to reduce code size on Series-3 ) 
category: unittest|mbedtls
quality: internal

provides:
  - name: test_suite_psa_crypto-SLI_EXCLUDE_PSA_SE_SYMCRYPTO_DRIVERS

requires:
  - name: test_config_all
    condition: [trustzone_nonsecure]
  - name: test_config_all
    condition: [trustzone_unaware]
  - name: trustzone_security_state


recommends:
  # Assume that projects are TZ unaware unless a state is explicitly included.
  - id: trustzone_unaware

    vendor: silabs
define:
  # Exclude PSA SE symmetric crypto and hash drivers ( used to reduce code size on Series-3 ) 
  - name: SLI_EXCLUDE_PSA_SE_SYMCRYPTO_DRIVERS

  # Override max default value of 254 for NVM objects in order to support
  # storage of RSA keys in ITS.
  - name: NVM3_DEFAULT_MAX_OBJECT_SIZE
    value: 1024

metadata:
    sbom:
        license: Zlib AND Apache-2.0
        upstream:
            name: Mbed TLS
            version: v3.6.2
            supplier: Trusted Firmware
            url: https://github.com/Mbed-TLS/mbedtls.git
            comment: Mbed TLS is a C library implementing the PSA Cryptography API, cryptographic primitives, X.509 certificate manipulation and the SSL/TLS and DTLS protocols.
root_path: security_mbedtls
